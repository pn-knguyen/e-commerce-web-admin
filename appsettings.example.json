    "OrderDetailPath": "/v2/shipping-order/detail",
    "CancelOrderPath": "/v2/switch-status/cancel",
    "ProvincePath": "/master-data/province",
    "DistrictPath": "/master-data/district",
    "WardPath": "/master-data/ward",
    "Token": "",
