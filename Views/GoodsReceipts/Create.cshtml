@model e_commerce_web_admin.ViewModels.Inventory.GoodsReceiptFormViewModel
@{
    ViewData["Title"] = "Tạo phiếu nhập";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/inventory.css" asp-append-version="true" />
}

<main class="inv-page">
    <section class="inv-hero inv-anim" style="animation-delay:0.04s">
        <nav class="inv-breadcrumb" aria-label="Điều hướng">
            <a asp-action="Index">Quản lý phiếu nhập</a>
            <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
            <span>Tạo phiếu nhập</span>
        </nav>

        <div class="inv-title-row">
            <div>
                <h1>Tạo phiếu nhập</h1>
                <p>Ghi nhận hàng nhập từ nhà cung cấp trước khi duyệt cộng tồn kho.</p>
            </div>
        </div>
    </section>

    <form asp-action="Create" method="post" class="inv-anim" style="animation-delay:0.1s" data-inv-form novalidate>
        @Html.AntiForgeryToken()
        <partial name="_Form" model="Model" />
    </form>
</main>

@section Scripts {
    <script src="~/js/inventory.js" asp-append-version="true"></script>
}
