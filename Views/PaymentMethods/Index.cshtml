@model e_commerce_web_admin.ViewModels.PaymentMethods.PaymentMethodIndexViewModel
@{
    ViewData["Title"] = "Phương thức thanh toán";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/payment-methods.css" asp-append-version="true" />
}

<main class="surface-page payment-page">
<div class="surface-hero payment-anim surface-anim"
     style="animation-delay:0.04s">
    <div>
        <div class="flex items-center gap-2 mb-1">
            <h1 class="text-2xl font-bold text-slate-800">Phương thức thanh toán</h1>
        </div>
        <p class="text-slate-500 text-sm">Quản lý các hình thức thanh toán được dùng khi tạo đơn hàng</p>
    </div>
    <a asp-action="Create"
       class="inline-flex items-center gap-2 bg-gradient-to-r from-teal-500 to-teal-600 hover:from-teal-600 hover:to-teal-700
        text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-all shadow-sm hover:shadow-md hover:-translate-y-0.5">
        <i data-lucide="plus" class="w-4 h-4"></i>
        Thêm phương thức
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div id="toastSuccess"
         class="mb-4 flex items-center gap-3 bg-emerald-50 border border-emerald-200 text-emerald-700 rounded-xl px-4 py-3 text-sm shadow-sm payment-anim"
         style="animation-delay:0.04s">
        <div class="w-7 h-7 rounded-full bg-emerald-100 flex items-center justify-center flex-shrink-0">
            <i data-lucide="check" class="w-4 h-4 text-emerald-600"></i>
        </div>
        <span class="flex-1">@TempData["Success"]</span>
        <button type="button" data-dismiss-target="toastSuccess"
                class="text-emerald-400 hover:text-emerald-600 transition-colors">
            <i data-lucide="x" class="w-4 h-4"></i>
        </button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div id="toastError"
         class="mb-4 flex items-center gap-3 bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3 text-sm shadow-sm payment-anim"
         style="animation-delay:0.04s">
        <div class="w-7 h-7 rounded-full bg-red-100 flex items-center justify-center flex-shrink-0">
            <i data-lucide="alert-circle" class="w-4 h-4 text-red-500"></i>
        </div>
        <span class="flex-1">@TempData["Error"]</span>
        <button type="button" data-dismiss-target="toastError" class="text-red-400 hover:text-red-600 transition-colors">
            <i data-lucide="x" class="w-4 h-4"></i>
        </button>
    </div>
}

<div class="surface-metrics payment-anim surface-anim" style="animation-delay:0.08s">
    <div class="bg-white rounded-2xl border border-slate-100 p-4 flex items-center gap-3 shadow-sm">
        <div class="w-10 h-10 rounded-xl bg-teal-50 flex items-center justify-center flex-shrink-0">
            <i data-lucide="credit-card" class="w-5 h-5 text-teal-500"></i>
        </div>
        <div>
            <p class="text-xl font-bold text-slate-800">@Model.TotalCount</p>
            <p class="text-xs text-slate-400">Tổng phương thức</p>
        </div>
    </div>
    <div class="bg-white rounded-2xl border border-slate-100 p-4 flex items-center gap-3 shadow-sm">
        <div class="w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center flex-shrink-0">
            <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-500"></i>
        </div>
        <div>
            <p class="text-xl font-bold text-emerald-600">@Model.ActiveCount</p>
            <p class="text-xs text-slate-400">Đang bật</p>
        </div>
    </div>
    <div class="bg-white rounded-2xl border border-slate-100 p-4 flex items-center gap-3 shadow-sm">
        <div class="w-10 h-10 rounded-xl bg-slate-100 flex items-center justify-center flex-shrink-0">
            <i data-lucide="pause-circle" class="w-5 h-5 text-slate-500"></i>
        </div>
        <div>
            <p class="text-xl font-bold text-slate-600">@Model.InactiveCount</p>
            <p class="text-xs text-slate-400">Đang tắt</p>
        </div>
    </div>
    <div class="bg-white rounded-2xl border border-slate-100 p-4 flex items-center gap-3 shadow-sm">
        <div class="w-10 h-10 rounded-xl bg-teal-50 flex items-center justify-center flex-shrink-0">
            <i data-lucide="shopping-bag" class="w-5 h-5 text-teal-500"></i>
        </div>
        <div>
            <p class="text-xl font-bold text-teal-600">@Model.TotalOrderUsageCount</p>
            <p class="text-xs text-slate-400">Đơn hàng dùng</p>
        </div>
    </div>
</div>

<div class="surface-console surface-table-card payment-index-card payment-anim surface-anim" style="animation-delay:0.12s">
    <div class="payment-toolbar">
        <form method="get" asp-action="Index" class="payment-filter-grid">
        <div class="relative payment-filter-search">
            <i data-lucide="search"
               class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 pointer-events-none"></i>
            <input type="text" name="search" value="@Model.Search" placeholder="Tìm theo tên hoặc mô tả..." class="w-full pl-9 pr-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-700
            focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition" />
        </div>

        <select name="status" class="border border-slate-200 rounded-xl px-3 py-2.5 text-sm text-slate-700 bg-white
            focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition">
            <option value="" selected="@(string.IsNullOrEmpty(Model.Status))">Tất cả trạng thái</option>
            <option value="active" selected="@(Model.Status == "active")">Đang bật</option>
            <option value="inactive" selected="@(Model.Status == "inactive")">Đang tắt</option>
        </select>

        <button type="submit" class="payment-filter-submit">
            <i data-lucide="sliders-horizontal" class="w-4 h-4"></i>
            Tìm
        </button>

        @if (!string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.Status))
        {
            <a asp-action="Index" class="payment-filter-clear">
                <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
                Xóa lọc
            </a>
        }
        </form>
    </div>
    @if (!Model.PaymentMethods.Any())
    {
        <div class="admin-empty">
            <span class="admin-empty-icon">
                <i data-lucide="credit-card" class="w-9 h-9"></i>
            </span>
            <h2>Không tìm thấy phương thức thanh toán</h2>
            @if (!string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.Status))
            {
                <p>Điều chỉnh từ khóa hoặc xóa bộ lọc để xem lại toàn bộ phương thức thanh toán.</p>
                <a asp-action="Index" class="admin-empty-action">Xóa bộ lọc</a>
            }
            else
            {
                <p>Tạo phương thức thanh toán đầu tiên để đơn hàng có thể ghi nhận kênh thanh toán phù hợp.</p>
                <a asp-action="Create" class="admin-empty-action">Thêm phương thức</a>
            }
        </div>
    }
    else
    {
        <div class="payment-table-scroll">
            <div
                class="surface-table-head payment-index-grid px-6 py-3.5">
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Phương thức</span>
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider text-center">Đơn hàng</span>
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider text-center">Trạng thái</span>
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider text-right">Thao tác</span>
            </div>

            <div class="divide-y divide-slate-50">
                @{
                    var animIndex = 0;
                }
                @foreach (var method in Model.PaymentMethods)
                {
                    <div class="surface-row payment-row payment-index-grid px-6 py-3.5 payment-anim"
                         style="animation-delay:@(0.16 + animIndex++ * 0.025)s" data-id="@method.Id">
                        <div class="flex items-center gap-3 min-w-0">
                            <div class="payment-icon w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0">
                                <i data-lucide="credit-card" class="w-4 h-4 text-teal-600"></i>
                            </div>
                            <div class="min-w-0">
                                <p class="font-semibold text-slate-800 text-sm truncate">@method.Name</p>
                                <p class="text-[11px] text-slate-400 truncate">
                                    @(string.IsNullOrWhiteSpace(method.Description) ? "Chưa có mô tả" : method.Description)
                                </p>
                            </div>
                        </div>

                        <div class="text-center">
                            <span
                                class="inline-flex items-center justify-center gap-1 text-xs font-semibold rounded-full px-2.5 py-1
                                @(method.OrderCount > 0 ? "bg-teal-100 text-teal-700" : "bg-slate-100 text-slate-400")">
                                <i data-lucide="shopping-bag" class="w-3 h-3"></i>
                                @method.OrderCount
                            </span>
                        </div>

                        <div class="flex items-center justify-center">
                            <button type="button" data-payment-toggle data-payment-id="@method.Id"
                                    class="payment-status-btn @(method.IsActive ? "is-active" : "is-inactive")"
                                    data-active="@method.IsActive.ToString().ToLower()">
                                <span class="dot"></span>
                                <span class="status-label">@(method.IsActive ? "Bật" : "Tắt")</span>
                            </button>
                        </div>

                        <div class="w-36 index-actions">
                            <a asp-action="Edit" asp-route-id="@method.Id" title="Chỉnh sửa"
                               class="payment-action-btn payment-action-edit index-action-btn index-action-edit">
                                <i data-lucide="pencil" class="w-4 h-4 shrink-0"></i>
                                Sửa
                            </a>
                            <form asp-action="Delete" asp-route-id="@method.Id" method="post" data-payment-delete
                                  data-payment-id="@method.Id" data-payment-name="@method.Name">
                                @Html.AntiForgeryToken()
                                <button type="submit" title="Xóa" class="payment-action-btn payment-action-delete index-action-btn index-action-delete">
                                    <i data-lucide="trash-2" class="w-4 h-4 shrink-0"></i>
                                    Xóa
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="surface-pagination px-6 py-4 flex items-center justify-between">
                <p class="text-xs text-slate-400">
                    Trang <span class="font-semibold text-slate-600">@Model.Page</span> / @Model.TotalPages
                    &nbsp;·&nbsp;
                    <span class="font-semibold text-slate-600">@Model.TotalCount</span> phương thức
                </p>
                <div class="flex items-center gap-1">
                    @if (Model.HasPrev)
                    {
                        <a asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search"
                           asp-route-status="@Model.Status" class="w-8 h-8 rounded-lg border border-slate-200 bg-white hover:bg-slate-50
                            flex items-center justify-center text-slate-600 transition-colors shadow-sm">
                            <i data-lucide="chevron-left" class="w-4 h-4"></i>
                        </a>
                    }
                    @for (int p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.TotalPages, Model.Page + 2); p++)
                    {
                        <a asp-action="Index" asp-route-page="@p" asp-route-search="@Model.Search" asp-route-status="@Model.Status"
                           class="w-8 h-8 rounded-lg text-xs font-semibold flex items-center justify-center transition-all
                            @(p == Model.Page
                                ? "bg-gradient-to-b from-teal-500 to-teal-600 text-white shadow-sm"
                               : "border border-slate-200 bg-white text-slate-600 hover:bg-slate-50")">
                            @p
                        </a>
                    }
                    @if (Model.HasNext)
                    {
                        <a asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search"
                           asp-route-status="@Model.Status" class="w-8 h-8 rounded-lg border border-slate-200 bg-white hover:bg-slate-50
                            flex items-center justify-center text-slate-600 transition-colors shadow-sm">
                            <i data-lucide="chevron-right" class="w-4 h-4"></i>
                        </a>
                    }
                </div>
            </div>
        }
    }
</div>
</main>

@section Scripts {
    <script src="~/js/payment-methods.js" asp-append-version="true"></script>
}
