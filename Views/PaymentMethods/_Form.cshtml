@model e_commerce_web_admin.ViewModels.PaymentMethods.PaymentMethodFormViewModel
@{
    var isEdit = Model.Id > 0;
}

<div class="surface-form-grid surface-form-card payment-editor-shell">
    <header class="payment-editor-header">
        <div class="payment-editor-heading">
            <span class="payment-editor-heading-icon" aria-hidden="true">
                <i data-lucide="credit-card" class="w-5 h-5"></i>
            </span>
            <div>
                <h2>Thông tin phương thức thanh toán</h2>
                <p>Thiết lập tên, hướng dẫn và trạng thái sử dụng trong cùng một biểu mẫu.</p>
            </div>
        </div>

        <div data-surface-form-alert
             class="surface-form-alert @(ViewData.ModelState.IsValid ? "hidden" : "")">
            <i data-lucide="alert-triangle" class="w-4 h-4"></i>
            <div>
                <p>Vui lòng kiểm tra lại thông tin.</p>
                <div asp-validation-summary="ModelOnly"></div>
            </div>
        </div>
    </header>

    <div class="payment-editor-body">
        <section class="payment-editor-section payment-editor-fields" aria-labelledby="paymentBasicInfoTitle">
            <div class="payment-editor-section-title">
                <span class="payment-editor-step">01</span>
                <div>
                    <h3 id="paymentBasicInfoTitle">Thông tin phương thức</h3>
                    <p>Nội dung này giúp nhân viên và khách hàng nhận biết hình thức thanh toán.</p>
                </div>
            </div>

            <div class="payment-editor-field-list">
                <div class="payment-editor-field">
                    <label asp-for="Name">
                        Tên phương thức <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="Name"
                           placeholder="Ví dụ: Thanh toán khi nhận hàng" />
                    <span asp-validation-for="Name" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                <div class="payment-editor-field">
                    <label asp-for="Description">
                        Mô tả
                        <span class="payment-field-hint">Tối đa 500 ký tự</span>
                    </label>
                    <textarea asp-for="Description" rows="7"
                              placeholder="Ghi chú cách dùng, điều kiện hoặc hướng dẫn thanh toán..."></textarea>
                    <span asp-validation-for="Description" class="text-xs text-red-500 mt-1 block"></span>
                </div>
            </div>
        </section>

        <aside class="payment-editor-side" aria-labelledby="paymentStatusTitle">
            <section class="payment-editor-section payment-editor-status">
                <div class="payment-editor-section-title">
                    <span class="payment-editor-step">02</span>
                    <div>
                        <h3 id="paymentStatusTitle">Trạng thái sử dụng</h3>
                        <p>Kiểm soát việc phương thức này có xuất hiện trong quy trình đặt hàng hay không.</p>
                    </div>
                </div>

                <div class="payment-status-control">
                    <div class="payment-status-copy">
                        <span class="payment-status-icon" aria-hidden="true">
                            <i data-lucide="shopping-bag" class="w-4 h-4"></i>
                        </span>
                        <div>
                            <strong>Cho phép thanh toán</strong>
                            <p>Khách hàng có thể chọn phương thức này khi hoàn tất đơn hàng.</p>
                        </div>
                    </div>

                    <label class="payment-status-switch" for="paymentIsActive">
                        <input asp-for="IsActive" type="checkbox" id="paymentIsActive" />
                        <span class="payment-status-track" aria-hidden="true"></span>
                        <span class="sr-only">Thay đổi trạng thái sử dụng phương thức thanh toán</span>
                    </label>
                </div>

                <div class="payment-status-note">
                    <i data-lucide="info" class="w-4 h-4" aria-hidden="true"></i>
                    <p>Tắt phương thức không làm thay đổi dữ liệu của các đơn hàng đã sử dụng trước đó.</p>
                </div>
            </section>
        </aside>
    </div>

    <footer class="payment-editor-actions">
        <a asp-action="Index" class="surface-cancel-link">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
            Quay lại
        </a>
        <button type="submit" class="payment-submit-button">
            <i data-lucide="save" class="w-4 h-4"></i>
            @(isEdit ? "Lưu thay đổi" : "Tạo phương thức")
        </button>
    </footer>
</div>
