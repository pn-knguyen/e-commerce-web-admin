@model e_commerce_web_admin.ViewModels.Specifications.SpecificationFormViewModel
@{
    ViewData["Title"] = $"Sửa thông số — {Model.Name}";
    Layout = "_Layout";
}
@section Styles {
    <link rel="stylesheet" href="~/css/specifications.css" asp-append-version="true" />
}

<main class="surface-page specification-form-page">
<div class="surface-form-hero spec-form-hero spec-anim surface-anim" style="animation-delay:0.04s">
    <nav class="flex items-center gap-2 text-xs text-slate-400 mb-2">
        <a asp-action="Index" class="hover:text-teal-600 transition-colors">Thông số kỹ thuật</a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <span class="text-slate-600 font-medium">@Model.Name</span>
    </nav>
    <h1 class="text-2xl font-bold text-slate-800">Chỉnh sửa thông số</h1>
    <p class="text-slate-500 text-sm mt-0.5">Cập nhật thông tin thông số <strong class="text-slate-700">@Model.Name</strong></p>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="spec-anim surface-anim" style="animation-delay:0.1s">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <partial name="_Form" model="Model" />
</form>
</main>

@section Scripts {
    <script src="~/js/specifications.js" asp-append-version="true"></script>
}
