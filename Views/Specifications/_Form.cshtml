@model e_commerce_web_admin.ViewModels.Specifications.SpecificationFormViewModel
@* Shared partial for Create & Edit — no <form> wrapper *@

<div class="surface-form-grid grid grid-cols-1 lg:grid-cols-3 gap-6">

    @* ── Left: main fields ── *@
    <div class="surface-form-main lg:col-span-2 space-y-5">
        <div class="surface-form-card bg-white rounded-2xl border border-slate-200 p-5">
            <h3 class="text-sm font-semibold text-slate-700 mb-4">Thông tin thông số</h3>

            <div data-surface-form-alert
                 class="surface-form-alert @(ViewData.ModelState.IsValid ? "hidden" : "")">
                <i data-lucide="alert-triangle" class="w-4 h-4"></i>
                <div>
                    <p>Vui lòng kiểm tra lại thông tin.</p>
                    <div asp-validation-summary="ModelOnly"></div>
                </div>
            </div>

            <div class="space-y-4">

                @* Key *@
                <div>
                    <label asp-for="Key" class="block text-xs font-semibold text-slate-600 mb-1.5">
                        Key (mã định danh) <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="Key" id="specKey"
                           class="w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-800 font-mono
                                  focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition"
                           placeholder="vi_du: ram_gb, cpu_speed, screen_size" />
                    <span asp-validation-for="Key" class="text-xs text-red-500 mt-1 block"></span>
                    <p class="text-xs text-slate-400 mt-1">Chỉ gồm chữ thường, số và dấu <code class="bg-slate-100 px-1 rounded">_</code>. Không thể thay đổi sau khi tạo sản phẩm dùng.</p>
                </div>

                @* Name *@
                <div>
                    <label asp-for="Name" class="block text-xs font-semibold text-slate-600 mb-1.5">
                        Tên hiển thị <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="Name"
                           class="w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-800
                                  focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition"
                           placeholder="Ví dụ: Dung lượng RAM, Tốc độ CPU" />
                    <span asp-validation-for="Name" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                @* Unit + Icon *@
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label asp-for="Unit" class="block text-xs font-semibold text-slate-600 mb-1.5">
                            Đơn vị
                            <span class="font-normal text-slate-400 ml-1">(tuỳ chọn)</span>
                        </label>
                        <input asp-for="Unit"
                               class="w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-800
                                      focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition"
                               placeholder="GB, GHz, inch, kg..." />
                        <span asp-validation-for="Unit" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="Icon" class="block text-xs font-semibold text-slate-600 mb-1.5">
                            Icon Lucide
                            <span class="font-normal text-slate-400 ml-1">(tuỳ chọn)</span>
                        </label>
                        <input asp-for="Icon"
                               class="w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-800 font-mono
                                      focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition"
                               placeholder="cpu, hard-drive, wifi..." />
                        <span asp-validation-for="Icon" class="text-xs text-red-500 mt-1 block"></span>
                        <p class="text-xs text-slate-400 mt-1">
                            Tên icon từ <a href="https://lucide.dev/icons" target="_blank" class="text-teal-600 hover:underline">lucide.dev</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ── Right: actions ── *@
    <div class="space-y-5">
        <div class="surface-form-card surface-submit-card bg-white rounded-2xl border border-slate-200 p-5 space-y-3">
            <button type="submit"
                    class="w-full flex items-center justify-center gap-2
                           bg-gradient-to-r from-teal-500 to-teal-600 hover:from-teal-600 hover:to-teal-700
                           text-white text-sm font-semibold px-4 py-2.5 rounded-xl transition-all shadow-sm hover:shadow-md">
                <i data-lucide="save" class="w-4 h-4"></i>
                Lưu thông số
            </button>
            <a asp-action="Index"
               class="surface-cancel-link w-full flex items-center justify-center gap-2 border border-slate-200 hover:bg-slate-50
                      text-slate-700 text-sm font-medium px-4 py-2.5 rounded-xl transition-colors">
                Huỷ bỏ
            </a>
        </div>

        @* Preview *@
        <div class="surface-form-card bg-white rounded-2xl border border-slate-200 p-5">
            <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3">Xem trước</h3>
            <div class="flex items-center gap-3">
                <span class="spec-key-badge">@(string.IsNullOrEmpty(Model.Key) ? "key" : Model.Key)</span>
                <span class="text-sm text-slate-600">@(string.IsNullOrEmpty(Model.Name) ? "Tên thông số" : Model.Name)</span>
                @if (!string.IsNullOrEmpty(Model.Unit))
                {
                    <span class="spec-unit-badge">@Model.Unit</span>
                }
            </div>
        </div>
    </div>
</div>
