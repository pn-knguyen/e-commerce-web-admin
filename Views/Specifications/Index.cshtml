@model e_commerce_web_admin.ViewModels.Specifications.SpecificationIndexViewModel
@{
    ViewData["Title"] = "Thông số kỹ thuật";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/specifications.css" asp-append-version="true" />
}

@* ── Header ── *@
<div class="mb-6 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 spec-anim" style="animation-delay:0.04s">
    <div>
        <div class="flex items-center gap-2 mb-1">
            <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-teal-400 to-teal-600 flex items-center justify-center shadow-sm">
                <i data-lucide="sliders-horizontal" class="w-4 h-4 text-white"></i>
            </div>
            <h1 class="text-2xl font-bold text-slate-800">Thông số kỹ thuật</h1>
        </div>
        <p class="text-slate-500 text-sm">Quản lý danh sách thông số toàn cục của hệ thống</p>
    </div>
    <a asp-action="Create"
       class="inline-flex items-center gap-2 bg-gradient-to-r from-teal-500 to-teal-600 hover:from-teal-600 hover:to-teal-700
              text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-all shadow-sm hover:shadow-md hover:-translate-y-0.5">
        <i data-lucide="plus" class="w-4 h-4"></i>
        Thêm thông số
    </a>
</div>

@* ── Toasts ── *@
@if (TempData["Success"] != null)
{
    <div id="toastSuccess"
         class="mb-4 flex items-center gap-3 bg-emerald-50 border border-emerald-200 text-emerald-700 rounded-xl px-4 py-3 text-sm shadow-sm spec-anim"
         style="animation-delay:0.04s">
        <div class="w-7 h-7 rounded-full bg-emerald-100 flex items-center justify-center flex-shrink-0">
            <i data-lucide="check" class="w-4 h-4 text-emerald-600"></i>
        </div>
        <span class="flex-1">@TempData["Success"]</span>
        <button type="button" data-dismiss-target="toastSuccess" class="text-emerald-400 hover:text-emerald-600 transition-colors">
            <i data-lucide="x" class="w-4 h-4"></i>
        </button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div id="toastError"
         class="mb-4 flex items-center gap-3 bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3 text-sm shadow-sm spec-anim"
         style="animation-delay:0.04s">
        <div class="w-7 h-7 rounded-full bg-red-100 flex items-center justify-center flex-shrink-0">
            <i data-lucide="alert-circle" class="w-4 h-4 text-red-500"></i>
        </div>
        <span class="flex-1">@TempData["Error"]</span>
        <button type="button" data-dismiss-target="toastError" class="text-red-400 hover:text-red-600 transition-colors">
            <i data-lucide="x" class="w-4 h-4"></i>
        </button>
    </div>
}

@* ── Stats cards ── *@
<div class="grid grid-cols-3 gap-3 mb-5 spec-anim" style="animation-delay:0.08s">
    <div class="bg-white rounded-2xl border border-slate-100 p-4 flex items-center gap-3 shadow-sm">
        <div class="w-10 h-10 rounded-xl bg-teal-50 flex items-center justify-center flex-shrink-0">
            <i data-lucide="sliders-horizontal" class="w-5 h-5 text-teal-500"></i>
        </div>
        <div>
            <p class="text-xl font-bold text-slate-800">@Model.TotalCount</p>
            <p class="text-xs text-slate-400">Tổng thông số</p>
        </div>
    </div>
    <div class="bg-white rounded-2xl border border-slate-100 p-4 flex items-center gap-3 shadow-sm">
        <div class="w-10 h-10 rounded-xl bg-amber-50 flex items-center justify-center flex-shrink-0">
            <i data-lucide="folder-tree" class="w-5 h-5 text-amber-500"></i>
        </div>
        <div>
            <p class="text-xl font-bold text-amber-600">@Model.TotalCategoryUsageCount</p>
            <p class="text-xs text-slate-400">Lần gán vào danh mục</p>
        </div>
    </div>
    <div class="bg-white rounded-2xl border border-slate-100 p-4 flex items-center gap-3 shadow-sm">
        <div class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center flex-shrink-0">
            <i data-lucide="package" class="w-5 h-5 text-blue-500"></i>
        </div>
        <div>
            <p class="text-xl font-bold text-blue-600">@Model.TotalProductUsageCount</p>
            <p class="text-xs text-slate-400">Lần dùng ở sản phẩm</p>
        </div>
    </div>
</div>

@* ── Filter ── *@
<div class="bg-white rounded-2xl border border-slate-100 p-4 mb-4 shadow-sm spec-anim" style="animation-delay:0.12s">
    <form method="get" asp-action="Index" class="flex flex-col sm:flex-row gap-3">
        <div class="relative flex-1">
            <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 pointer-events-none"></i>
            <input type="text" name="search" value="@Model.Search"
                   placeholder="Tìm theo key hoặc tên..."
                   class="w-full pl-9 pr-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-700
                          focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition" />
        </div>
        <button type="submit"
                class="inline-flex items-center justify-center gap-2 bg-teal-600 hover:bg-teal-700
                       text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors">
            <i data-lucide="search" class="w-4 h-4"></i>
            Tìm kiếm
        </button>
        @if (!string.IsNullOrEmpty(Model.Search))
        {
            <a asp-action="Index"
               class="inline-flex items-center gap-1.5 text-slate-500 hover:text-slate-700 text-sm px-2 transition-colors">
                <i data-lucide="x-circle" class="w-4 h-4"></i>
                Xoá lọc
            </a>
        }
    </form>
</div>

@* ── Table ── *@
<div class="bg-white rounded-2xl border border-slate-100 overflow-hidden shadow-sm spec-anim" style="animation-delay:0.16s">

    @if (!Model.Specifications.Any())
    {
        <div class="py-24 text-center">
            <div class="w-20 h-20 rounded-3xl bg-gradient-to-br from-teal-100 to-teal-50
                        flex items-center justify-center mx-auto mb-5 shadow-sm">
                <i data-lucide="sliders-horizontal" class="w-10 h-10 text-teal-300"></i>
            </div>
            <p class="text-slate-600 font-semibold text-lg">Không tìm thấy thông số</p>
            <p class="text-slate-400 text-sm mt-2">
                @if (!string.IsNullOrEmpty(Model.Search))
                {<span>Thử từ khoá khác hoặc <a asp-action="Index" class="text-teal-600 hover:underline">xoá bộ lọc</a></span>}
                else
                {<span>Nhấn <strong class="text-slate-600">Thêm thông số</strong> để bắt đầu</span>}
            </p>
        </div>
    }
    else
    {
        @* Table header *@
        <div class="px-6 py-3.5 bg-gradient-to-r from-slate-50 to-slate-50/50 border-b border-slate-100
                    grid grid-cols-[auto_1fr_auto_auto_auto_auto] gap-4 items-center">
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider w-32">Key</span>
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Tên thông số</span>
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider text-center w-20">Đơn vị</span>
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider text-center w-24">Danh mục</span>
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider text-center w-24">Sản phẩm</span>
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider text-right w-32">Thao tác</span>
        </div>

        <div class="divide-y divide-slate-50">
            @{int animIdx = 0;}
            @foreach (var spec in Model.Specifications)
            {
                <div class="spec-row grid grid-cols-[auto_1fr_auto_auto_auto_auto] gap-4 items-center px-6 py-3.5 spec-anim"
                     style="animation-delay:@(0.16 + animIdx++ * 0.025)s">

                    @* Key *@
                    <div class="w-32">
                        <span class="spec-key-badge">@spec.Key</span>
                    </div>

                    @* Name + Icon *@
                    <div class="min-w-0 flex items-center gap-2">
                        @if (!string.IsNullOrEmpty(spec.Icon))
                        {
                            <i data-lucide="@spec.Icon" class="w-4 h-4 text-teal-400 flex-shrink-0"></i>
                        }
                        <span class="font-medium text-slate-700 text-sm truncate">@spec.Name</span>
                    </div>

                    @* Unit *@
                    <div class="w-20 text-center">
                        @if (!string.IsNullOrEmpty(spec.Unit))
                        {
                            <span class="spec-unit-badge">@spec.Unit</span>
                        }
                        else
                        {
                            <span class="text-slate-300 text-xs">—</span>
                        }
                    </div>

                    @* Category count *@
                    <div class="w-24 text-center">
                        <span class="inline-flex items-center justify-center gap-1 text-xs font-semibold rounded-full px-2.5 py-1
                                     @(spec.CategoryCount > 0 ? "bg-amber-100 text-amber-700" : "bg-slate-100 text-slate-400")">
                            <i data-lucide="folder" class="w-3 h-3"></i>
                            @spec.CategoryCount
                        </span>
                    </div>

                    @* Product count *@
                    <div class="w-24 text-center">
                        <span class="inline-flex items-center justify-center gap-1 text-xs font-semibold rounded-full px-2.5 py-1
                                     @(spec.ProductCount > 0 ? "bg-blue-100 text-blue-700" : "bg-slate-100 text-slate-400")">
                            <i data-lucide="package" class="w-3 h-3"></i>
                            @spec.ProductCount
                        </span>
                    </div>

                    @* Actions *@
                    <div class="w-32 flex items-center justify-end gap-1.5">
                        <a asp-action="Edit" asp-route-id="@spec.Id"
                           title="Chỉnh sửa"
                           class="inline-flex items-center gap-1.5 text-xs font-medium
                                  bg-teal-50 hover:bg-teal-100 text-teal-600
                                  px-2.5 py-1.5 rounded-lg transition-colors">
                            <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
                            Sửa
                        </a>
                        <form asp-action="Delete" asp-route-id="@spec.Id" method="post"
                              data-spec-delete
                              data-spec-name="@spec.Name"
                              data-category-count="@spec.CategoryCount"
                              data-product-count="@spec.ProductCount">
                            @Html.AntiForgeryToken()
                            <button type="submit" title="Xoá"
                                    class="inline-flex items-center gap-1.5 text-xs font-medium
                                           bg-red-50 hover:bg-red-100 text-red-500
                                           px-2.5 py-1.5 rounded-lg transition-colors">
                                <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                                Xoá
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>

        @* Pagination *@
        @if (Model.TotalPages > 1)
        {
            <div class="px-6 py-4 border-t border-slate-100 flex items-center justify-between bg-slate-50/50">
                <p class="text-xs text-slate-400">
                    Trang <span class="font-semibold text-slate-600">@Model.Page</span> / @Model.TotalPages
                    &nbsp;·&nbsp;
                    <span class="font-semibold text-slate-600">@Model.TotalCount</span> thông số
                </p>
                <div class="flex items-center gap-1">
                    @if (Model.HasPrev)
                    {
                        <a asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search"
                           class="w-8 h-8 rounded-lg border border-slate-200 bg-white hover:bg-slate-50
                                  flex items-center justify-center text-slate-600 transition-colors shadow-sm">
                            <i data-lucide="chevron-left" class="w-4 h-4"></i>
                        </a>
                    }
                    @for (int p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.TotalPages, Model.Page + 2); p++)
                    {
                        <a asp-action="Index" asp-route-page="@p" asp-route-search="@Model.Search"
                           class="w-8 h-8 rounded-lg text-xs font-semibold flex items-center justify-center transition-all
                                  @(p == Model.Page
                                      ? "bg-gradient-to-b from-teal-500 to-teal-600 text-white shadow-sm"
                                      : "border border-slate-200 bg-white text-slate-600 hover:bg-slate-50")">
                            @p
                        </a>
                    }
                    @if (Model.HasNext)
                    {
                        <a asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search"
                           class="w-8 h-8 rounded-lg border border-slate-200 bg-white hover:bg-slate-50
                                  flex items-center justify-center text-slate-600 transition-colors shadow-sm">
                            <i data-lucide="chevron-right" class="w-4 h-4"></i>
                        </a>
                    }
                </div>
            </div>
        }
    }
</div>

@section Scripts {
    <script src="~/js/specifications.js" asp-append-version="true"></script>
}
