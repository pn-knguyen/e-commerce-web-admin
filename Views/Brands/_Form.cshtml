@model e_commerce_web_admin.ViewModels.Brands.BrandFormViewModel
@* Partial dùng chung cho Create & Edit — không chứa thẻ <form> *@

<div class="surface-form-grid grid grid-cols-1 lg:grid-cols-3 gap-6">

    @* ── Left: main fields ── *@
    <div class="surface-form-main lg:col-span-2 space-y-5">

        @* Basic info *@
        <div class="surface-form-card bg-white rounded-2xl border border-slate-200 p-5">
            <h3 class="text-sm font-semibold text-slate-700 mb-4">Thông tin cơ bản</h3>

            <div data-surface-form-alert
                 class="surface-form-alert @(ViewData.ModelState.IsValid ? "hidden" : "")">
                <i data-lucide="alert-triangle" class="w-4 h-4"></i>
                <div>
                    <p>Vui lòng kiểm tra lại thông tin.</p>
                    <div asp-validation-summary="ModelOnly"></div>
                </div>
            </div>

            <div class="space-y-4">
                @* Name *@
                <div>
                    <label asp-for="Name" class="block text-xs font-semibold text-slate-600 mb-1.5">
                        Tên thương hiệu <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="Name" id="brandName"
                           class="w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-800
                                  focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition"
                           placeholder="Ví dụ: Samsung, Apple, Sony" />
                    <span asp-validation-for="Name" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                @* Slug *@
                <div>
                    <label asp-for="Slug" class="block text-xs font-semibold text-slate-600 mb-1.5">
                        Slug
                        <span class="font-normal text-slate-400 ml-1">(tự động tạo từ tên nếu để trống)</span>
                    </label>
                    <div class="relative">
                        <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs select-none">/brands/</span>
                        <input asp-for="Slug" id="brandSlug"
                               class="w-full border border-slate-200 rounded-xl pl-[5.5rem] pr-3.5 py-2.5 text-sm text-slate-800 font-mono
                                      focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition"
                               placeholder="samsung" />
                    </div>
                    <span asp-validation-for="Slug" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                @* Description *@
                <div>
                    <label asp-for="Description" class="block text-xs font-semibold text-slate-600 mb-1.5">Mô tả</label>
                    <textarea asp-for="Description" rows="3"
                              class="w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-800
                                     focus:outline-none focus:ring-2 focus:ring-sky-400 focus:border-transparent transition resize-none"
                              placeholder="Mô tả ngắn về thương hiệu..."></textarea>
                    <span asp-validation-for="Description" class="text-xs text-red-500 mt-1 block"></span>
                </div>
            </div>
        </div>

        @* Image upload *@
        <div class="surface-form-card bg-white rounded-2xl border border-slate-200 p-5">
            <h3 class="text-sm font-semibold text-slate-700 mb-4">Logo thương hiệu</h3>
            <input type="hidden" asp-for="ImagePath" id="imagePathInput" />

            <div>
                <label asp-for="ImageFile" class="block text-xs font-semibold text-slate-600 mb-1.5">
                    Tải ảnh lên Cloudinary
                </label>
                <input asp-for="ImageFile" id="imageFileInput" type="file"
                       accept="image/jpeg,image/png,image/webp,image/gif"
                       class="w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-800
                              file:mr-3 file:rounded-lg file:border-0 file:bg-teal-50 file:px-3 file:py-1.5
                              file:text-xs file:font-semibold file:text-teal-700 hover:file:bg-teal-100
                              focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition" />
                <span asp-validation-for="ImageFile" class="text-xs text-red-500 mt-1 block"></span>
                <p class="text-xs text-slate-400 mt-1">Hệ thống sẽ upload lên Cloudinary và lưu URL vào database.</p>
            </div>

            <div id="imagePreview" class="mt-4 @(string.IsNullOrEmpty(Model.ImagePath) ? "hidden" : "")">
                <p class="text-xs text-slate-500 mb-2 font-medium">Ảnh hiện tại</p>
                <img id="previewImg" src="@Model.ImagePath" alt="Logo"
                     class="brand-preview-img"
                     onerror="this.parentElement.classList.add('hidden')" />
            </div>
        </div>
    </div>

    @* ── Right: status + actions ── *@
    <div class="space-y-5">

        @* Status toggle *@
        <div class="surface-form-card bg-white rounded-2xl border border-slate-200 p-5">
            <h3 class="text-sm font-semibold text-slate-700 mb-4">Trạng thái</h3>

            <label class="flex items-center gap-3 cursor-pointer group">
                <div class="relative">
                    <input asp-for="IsActive" type="checkbox" id="isActiveToggle" class="sr-only peer" />
                    <div class="w-10 h-6 bg-slate-200 rounded-full peer-checked:bg-teal-500 transition-colors"></div>
                    <div class="absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow transition-transform peer-checked:translate-x-4"></div>
                </div>
                <span class="text-sm text-slate-700 group-hover:text-slate-900">Hiển thị thương hiệu</span>
            </label>
            <p class="text-xs text-slate-400 mt-2">Bật để hiện thương hiệu này trên cửa hàng.</p>
        </div>

        @* Action buttons *@
        <div class="surface-form-card surface-submit-card bg-white rounded-2xl border border-slate-200 p-5 space-y-3">
            <button type="submit"
                    class="w-full flex items-center justify-center gap-2
                           bg-gradient-to-r from-teal-500 to-teal-600 hover:from-teal-600 hover:to-teal-700
                           text-white text-sm font-semibold px-4 py-2.5 rounded-xl transition-all shadow-sm hover:shadow-md">
                <i data-lucide="save" class="w-4 h-4"></i>
                Lưu thương hiệu
            </button>
            <a asp-action="Index"
               class="surface-cancel-link w-full flex items-center justify-center gap-2 border border-slate-200 hover:bg-slate-50
                      text-slate-700 text-sm font-medium px-4 py-2.5 rounded-xl transition-colors">
                Huỷ bỏ
            </a>
        </div>
    </div>
</div>
