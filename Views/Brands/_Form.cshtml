@model e_commerce_web_admin.ViewModels.Brands.BrandFormViewModel
@* Partial dùng chung cho Create và Edit — thẻ <form> được khai báo ở view cha. *@

<div class="surface-form-grid surface-form-card brand-editor-shell">
    <header class="brand-editor-header">
        <div class="brand-editor-heading">
            <span class="brand-editor-heading-icon" aria-hidden="true">
                <i data-lucide="badge" class="w-5 h-5"></i>
            </span>
            <div>
                <h2>Thông tin thương hiệu</h2>
                <p>Quản lý thông tin hiển thị, logo và trạng thái trong cùng một biểu mẫu.</p>
            </div>
        </div>

        <div data-surface-form-alert
             class="surface-form-alert @(ViewData.ModelState.IsValid ? "hidden" : "")">
            <i data-lucide="alert-triangle" class="w-4 h-4"></i>
            <div>
                <p>Vui lòng kiểm tra lại thông tin.</p>
                <div asp-validation-summary="ModelOnly"></div>
            </div>
        </div>
    </header>

    <div class="brand-editor-body">
        <section class="brand-editor-section brand-editor-fields" aria-labelledby="brandBasicInfoTitle">
            <div class="brand-editor-section-title">
                <span class="brand-editor-step">01</span>
                <div>
                    <h3 id="brandBasicInfoTitle">Thông tin cơ bản</h3>
                    <p>Nội dung khách hàng sẽ nhìn thấy trên cửa hàng.</p>
                </div>
            </div>

            <div class="brand-editor-field-grid">
                <div class="brand-editor-field">
                    <label asp-for="Name">
                        Tên thương hiệu <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="Name" id="brandName"
                           placeholder="Ví dụ: Samsung, Apple, Sony" />
                    <span asp-validation-for="Name" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                <div class="brand-editor-field">
                    <label asp-for="Slug">
                        Slug
                        <span class="brand-field-hint">Tự tạo từ tên nếu để trống</span>
                    </label>
                    <div class="brand-slug-control">
                        <span aria-hidden="true">/brands/</span>
                        <input asp-for="Slug" id="brandSlug" placeholder="samsung" />
                    </div>
                    <span asp-validation-for="Slug" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                <div class="brand-editor-field brand-editor-field-wide">
                    <label asp-for="Description">Mô tả</label>
                    <textarea asp-for="Description" rows="5"
                              placeholder="Mô tả ngắn về thương hiệu..."></textarea>
                    <span asp-validation-for="Description" class="text-xs text-red-500 mt-1 block"></span>
                </div>
            </div>
        </section>

        <aside class="brand-editor-side" aria-label="Logo và trạng thái thương hiệu">
            <section class="brand-editor-section brand-editor-logo" aria-labelledby="brandLogoTitle">
                <div class="brand-editor-section-title">
                    <span class="brand-editor-step">02</span>
                    <div>
                        <h3 id="brandLogoTitle">Logo thương hiệu</h3>
                        <p>Ảnh vuông, nền trong suốt sẽ hiển thị tốt nhất.</p>
                    </div>
                </div>

                <input type="hidden" asp-for="ImagePath" id="imagePathInput" />

                <div class="brand-logo-uploader">
                    <div id="imagePreview"
                         class="brand-logo-preview @(string.IsNullOrEmpty(Model.ImagePath) ? "is-empty" : "")">
                        <div class="brand-logo-placeholder" aria-hidden="true">
                            <i data-lucide="image" class="w-6 h-6"></i>
                            <span>Logo</span>
                        </div>
                        <img id="previewImg" src="@Model.ImagePath" alt="Logo thương hiệu"
                             class="brand-preview-img"
                             decoding="async"
                             onerror="this.parentElement.classList.add('is-empty')" />
                    </div>

                    <div class="brand-logo-upload-copy">
                        <label asp-for="ImageFile">Chọn tệp ảnh</label>
                        <input asp-for="ImageFile" id="imageFileInput" type="file"
                               accept="image/jpeg,image/png,image/webp,image/gif,image/svg+xml" />
                        <span asp-validation-for="ImageFile" class="text-xs text-red-500 mt-1 block"></span>
                        <p>JPG, PNG, WebP, GIF hoặc SVG. Ảnh sẽ được tải lên Cloudinary.</p>
                    </div>
                </div>
            </section>

            <section class="brand-editor-section brand-editor-status" aria-labelledby="brandStatusTitle">
                <div class="brand-status-copy">
                    <span class="brand-status-icon" aria-hidden="true">
                        <i data-lucide="eye" class="w-4 h-4"></i>
                    </span>
                    <div>
                        <h3 id="brandStatusTitle">Hiển thị thương hiệu</h3>
                        <p>Bật để khách hàng có thể thấy thương hiệu này trên cửa hàng.</p>
                    </div>
                </div>

                <label class="brand-status-switch" for="isActiveToggle">
                    <input asp-for="IsActive" type="checkbox" id="isActiveToggle" />
                    <span class="brand-status-track" aria-hidden="true"></span>
                    <span class="sr-only">Thay đổi trạng thái hiển thị thương hiệu</span>
                </label>
            </section>
        </aside>
    </div>

    <footer class="brand-editor-actions">
        <a asp-action="Index" class="surface-cancel-link">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
            Quay lại
        </a>
        <button type="submit" class="brand-submit-button">
            <i data-lucide="save" class="w-4 h-4"></i>
            Lưu thương hiệu
        </button>
    </footer>
</div>
