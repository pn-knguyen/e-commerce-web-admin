@{
    var pageTitle = ViewData["Title"] as string ?? "Admin";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle — E-Commerce Admin</title>
    <meta name="description" content="Trang quản trị E-Commerce - Quản lý đơn hàng, sản phẩm, khách hàng và chiến dịch marketing." />

    @* Tailwind CSS CDN *@
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50:  '#f0fdfa',
                            100: '#ccfbf1',
                            200: '#99f6e4',
                            300: '#5eead4',
                            400: '#2dd4bf',
                            500: '#14b8a6',
                            600: '#0d9488',
                            700: '#0f766e',
                            800: '#115e59',
                            900: '#134e4a',
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'system-ui', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    @* Google Fonts *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    @* Lucide Icons *@
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>

    @* Chart.js *@
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>

    <style>
        * { font-family: 'Inter', system-ui, sans-serif; }

        /* Scrollbar mỏng */
        ::-webkit-scrollbar { width: 4px; height: 4px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 2px; }

        /* Sidebar transition */
        #adminSidebar {
            transition: transform 0.25s cubic-bezier(.4,0,.2,1),
                        width 0.25s cubic-bezier(.4,0,.2,1);
        }

        /* Nav link active */
        .nav-link.is-active {
            background: linear-gradient(90deg, rgba(20,184,166,.15) 0%, rgba(20,184,166,.06) 100%);
            color: #14b8a6;
            border-left: 3px solid #14b8a6;
        }

        /* KPI card hover */
        .kpi-card {
            background: white;
            transition: box-shadow 0.2s ease, transform 0.2s ease;
        }
        .kpi-card:hover {
            box-shadow: 0 10px 40px -10px rgba(0,0,0,.12);
            transform: translateY(-2px);
        }

        /* Chart wrapper */
        .chart-container { position: relative; }

        /* Skeleton loader */
        .skeleton {
            background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%);
            background-size: 200% 100%;
            animation: shimmer 1.5s infinite;
            border-radius: 6px;
        }
        @@keyframes shimmer {
            0%   { background-position: 200% 0; }
            100% { background-position: -200% 0; }
        }

        /* Overlay mobile */
        #sidebarOverlay {
            backdrop-filter: blur(2px);
            -webkit-backdrop-filter: blur(2px);
        }

        /* Status badges */
        .badge-pending    { background: #fef3c7; color: #92400e; }
        .badge-processing { background: #dbeafe; color: #1e40af; }
        .badge-shipping   { background: #ede9fe; color: #5b21b6; }
        .badge-delivered  { background: #d1fae5; color: #065f46; }
        .badge-cancelled  { background: #fee2e2; color: #991b1b; }

        /* Sparkline */
        .sparkline { display: block; }

        /* Topbar glass */
        #adminTopbar {
            background: rgba(255,255,255,0.92);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }

        /* ── Dashboard Entrance Animations ── */
        @@keyframes fadeSlideUp {
            from { opacity: 0; transform: translateY(22px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        @@keyframes fadeSlideDown {
            from { opacity: 0; transform: translateY(-16px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        @@keyframes slideInLeft {
            from { opacity: 0; transform: translateX(-20px); }
            to   { opacity: 1; transform: translateX(0); }
        }

        /*
         * CSS-only animation — chạy TỰ ĐỘNG ngay khi trang load, không cần JS.
         * animation-fill-mode: backwards giữ element ở trạng thái "from" (opacity 0)
         * trong suốt thời gian delay, rồi mới chạy vào.
         */
        .dash-animate {
            animation-duration: 0.6s;
            animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
            animation-fill-mode: backwards;
            animation-delay: var(--delay, 0s);
        }
        .dash-animate.anim-slide-up   { animation-name: fadeSlideUp; }
        .dash-animate.anim-slide-down { animation-name: fadeSlideDown; }
        .dash-animate.anim-left       { animation-name: slideInLeft; }

        /* Sidebar & topbar — chạy tự động, không cần class phụ */
        #adminSidebar {
            animation: slideInLeft 0.4s cubic-bezier(0.22,1,0.36,1) both;
        }
        #adminTopbar {
            animation: fadeSlideDown 0.4s cubic-bezier(0.22,1,0.36,1) 0.1s both;
        }
    </style>
</head>

<body class="bg-slate-50 text-slate-800 antialiased">

    @* Mobile sidebar overlay *@
    <div id="sidebarOverlay"
         class="fixed inset-0 bg-slate-900/40 z-20 hidden lg:hidden"
         onclick="toggleSidebar()"></div>

    <div class="flex min-h-screen">

        @* ═══════════ SIDEBAR ═══════════ *@
        <aside id="adminSidebar"
               class="fixed top-0 left-0 h-screen w-64 bg-slate-900 z-30
                      flex flex-col overflow-hidden
                      -translate-x-full lg:translate-x-0 lg:static lg:h-auto">

            @* Brand *@
            <div class="flex items-center gap-3 px-5 py-5 border-b border-slate-800">
                <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-brand-500 to-brand-700
                            flex items-center justify-center text-white font-bold text-sm shrink-0">
                    EC
                </div>
                <div class="min-w-0">
                    <p class="text-white font-bold text-sm leading-tight">E-Commerce</p>
                    <p class="text-slate-400 text-xs">Quản trị hệ thống</p>
                </div>
            </div>

            @* Nav *@
            <nav class="flex-1 overflow-y-auto py-4 px-3 space-y-1" aria-label="Điều hướng quản trị">

                <div class="mb-3">
                    <p class="text-slate-500 text-[10px] font-semibold uppercase tracking-widest px-3 mb-1">Tổng quan</p>
                    <a href="/Dashboard" class="nav-link flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white text-sm transition-all">
                        <i data-lucide="layout-dashboard" class="w-4 h-4 shrink-0"></i>
                        Bảng điều khiển
                    </a>
                </div>

                <div class="mb-3">
                    <p class="text-slate-500 text-[10px] font-semibold uppercase tracking-widest px-3 mb-1">Người dùng</p>
                    <a href="/Users" class="nav-link flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white text-sm transition-all">
                        <i data-lucide="users" class="w-4 h-4 shrink-0"></i>
                        Quản lý người dùng
                    </a>
                </div>

                <div class="mb-3">
                    <p class="text-slate-500 text-[10px] font-semibold uppercase tracking-widest px-3 mb-1">Danh mục sản phẩm</p>
                    <a href="/Brands" class="nav-link flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white text-sm transition-all">
                        <i data-lucide="tag" class="w-4 h-4 shrink-0"></i>
                        Thương hiệu
                    </a>
                    <a href="/Categories" class="nav-link flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white text-sm transition-all">
                        <i data-lucide="folder-tree" class="w-4 h-4 shrink-0"></i>
                        Danh mục
                    </a>
                    <a href="/Products" class="nav-link flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white text-sm transition-all">
                        <i data-lucide="package" class="w-4 h-4 shrink-0"></i>
                        Sản phẩm
                    </a>
                    <a href="/ProductVariants" class="nav-link flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white text-sm transition-all">
                        <i data-lucide="layers" class="w-4 h-4 shrink-0"></i>
                        Biến thể sản phẩm
                    </a>
                </div>

                <div class="mb-3">
                    <p class="text-slate-500 text-[10px] font-semibold uppercase tracking-widest px-3 mb-1">Cấu hình sản phẩm</p>
                    <a href="/Specifications" class="nav-link flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white text-sm transition-all">
                        <i data-lucide="sliders-horizontal" class="w-4 h-4 shrink-0"></i>
                        Thông số kỹ thuật
                    </a>
                    <a href="/Attributes" class="nav-link flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white text-sm transition-all">
                        <i data-lucide="list-filter" class="w-4 h-4 shrink-0"></i>
                        Thuộc tính biến thể
                    </a>
                </div>

                <div class="mb-3">
                    <p class="text-slate-500 text-[10px] font-semibold uppercase tracking-widest px-3 mb-1">Đơn hàng</p>
                    <a href="/Orders" class="nav-link flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white text-sm transition-all">
                        <i data-lucide="shopping-bag" class="w-4 h-4 shrink-0"></i>
                        Quản lý đơn hàng
                    </a>
                    <a href="/PaymentMethods" class="nav-link flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white text-sm transition-all">
                        <i data-lucide="credit-card" class="w-4 h-4 shrink-0"></i>
                        Phương thức thanh toán
                    </a>
                    <a href="/Ratings" class="nav-link flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white text-sm transition-all">
                        <i data-lucide="star" class="w-4 h-4 shrink-0"></i>
                        Đánh giá
                    </a>
                </div>

                <div class="mb-3">
                    <p class="text-slate-500 text-[10px] font-semibold uppercase tracking-widest px-3 mb-1">Marketing</p>
                    <a href="/Vouchers" class="nav-link flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white text-sm transition-all">
                        <i data-lucide="ticket" class="w-4 h-4 shrink-0"></i>
                        Voucher
                    </a>
                    <a href="/Campaigns" class="nav-link flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white text-sm transition-all">
                        <i data-lucide="megaphone" class="w-4 h-4 shrink-0"></i>
                        Chiến dịch
                    </a>
                    <a href="/Promotions" class="nav-link flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white text-sm transition-all">
                        <i data-lucide="percent" class="w-4 h-4 shrink-0"></i>
                        Khuyến mãi
                    </a>
                </div>

            </nav>

            @* User footer *@
            <div class="px-4 py-4 border-t border-slate-800 flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-gradient-to-br from-brand-400 to-brand-600 flex items-center justify-center text-white text-xs font-bold shrink-0">AD</div>
                <div class="min-w-0 flex-1">
                    <p class="text-white text-xs font-medium truncate">Admin</p>
                    <p class="text-slate-500 text-[10px] truncate">admin@@ecommerce.vn</p>
                </div>
                <button class="text-slate-500 hover:text-slate-300 transition-colors" title="Đăng xuất">
                    <i data-lucide="log-out" class="w-4 h-4"></i>
                </button>
            </div>
        </aside>

        @* ═══════════ MAIN ═══════════ *@
        <div class="flex-1 flex flex-col min-w-0">

            @* Topbar *@
            <header id="adminTopbar"
                    class="sticky top-0 z-10 border-b border-slate-200 flex items-center justify-between px-4 lg:px-6 h-16">
                <div class="flex items-center gap-3">
                    <button id="sidebarToggle"
                            onclick="toggleSidebar()"
                            class="lg:hidden w-9 h-9 rounded-lg border border-slate-200 hover:bg-slate-100 flex items-center justify-center transition-colors">
                        <i data-lucide="menu" class="w-4 h-4 text-slate-600"></i>
                    </button>
                    <div>
                        <p class="text-[10px] text-slate-400 font-medium uppercase tracking-widest">Trang quản trị</p>
                        <p class="font-semibold text-slate-800 text-sm leading-tight">@pageTitle</p>
                    </div>
                </div>

                <div class="flex items-center gap-2">
                    @* Live clock *@
                    <div class="hidden sm:flex items-center gap-1.5 text-xs text-slate-500 bg-slate-100 rounded-lg px-3 py-1.5">
                        <i data-lucide="clock" class="w-3.5 h-3.5"></i>
                        <span id="liveClock">--:--:--</span>
                    </div>

                    @* Notification bell *@
                    <button class="relative w-9 h-9 rounded-lg border border-slate-200 hover:bg-slate-100 flex items-center justify-center transition-colors">
                        <i data-lucide="bell" class="w-4 h-4 text-slate-600"></i>
                        <span class="absolute top-1.5 right-1.5 w-2 h-2 bg-red-500 rounded-full"></span>
                    </button>

                    @* Refresh *@
                    <button id="refreshBtn"
                            onclick="window.dashboardRefresh && window.dashboardRefresh()"
                            class="hidden sm:flex w-9 h-9 rounded-lg border border-slate-200 hover:bg-slate-100 items-center justify-center transition-colors"
                            title="Làm mới dữ liệu">
                        <i data-lucide="refresh-cw" class="w-4 h-4 text-slate-600"></i>
                    </button>
                </div>
            </header>

            @* Page content *@
            <main class="flex-1 p-4 lg:p-6 xl:p-8" role="main">
                @RenderBody()
            </main>
        </div>
    </div>

    @* Scripts *@
    <script>
        // Sidebar toggle
        function toggleSidebar() {
            const sidebar  = document.getElementById('adminSidebar');
            const overlay  = document.getElementById('sidebarOverlay');
            const isOpen   = !sidebar.classList.contains('-translate-x-full');
            sidebar.classList.toggle('-translate-x-full', isOpen);
            overlay.classList.toggle('hidden', isOpen);
        }

        // Active nav link
        (function markActive() {
            const path = window.location.pathname.toLowerCase();
            document.querySelectorAll('.nav-link[href]').forEach(link => {
                const href = (link.getAttribute('href') || '').toLowerCase();
                if (href && href !== '/' && path.startsWith(href)) {
                    link.classList.add('is-active');
                }
            });
        })();

        // Live clock
        (function startClock() {
            const el = document.getElementById('liveClock');
            if (!el) return;
            function tick() {
                el.textContent = new Date().toLocaleTimeString('vi-VN', { hour12: false });
            }
            tick();
            setInterval(tick, 1000);
        })();


    </script>

    @* Init Lucide icons *@
    <script>lucide.createIcons();</script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
