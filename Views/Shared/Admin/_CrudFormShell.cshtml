@{
    var moduleName = ViewData["ModuleName"] as string ?? "Module";
    var crudAction = ViewData["CrudAction"] as string ?? "Create";
    var isEdit = string.Equals(crudAction, "Edit", StringComparison.OrdinalIgnoreCase);
    var title = isEdit ? $"Cập nhật {moduleName}" : $"Thêm mới {moduleName}";
}

<section class="admin-page">
    <header class="admin-page-header">
        <div>
            <span class="admin-kicker">@moduleName</span>
            <h1>@title</h1>
        </div>
        <div class="admin-page-actions">
            <a class="admin-button" asp-action="Index">Quay lại</a>
        </div>
    </header>

    <section class="admin-panel">
        <form class="admin-form" method="post">
            @Html.AntiForgeryToken()
            <div class="admin-form-grid">
                <label class="admin-field">
                    <span>Tên hoặc nhãn chính</span>
                    <input type="text" name="Name" autocomplete="off" />
                </label>
                <label class="admin-field">
                    <span>Mã hoặc slug</span>
                    <input type="text" name="Code" autocomplete="off" />
                </label>
                <label class="admin-field admin-field-wide">
                    <span>Mô tả</span>
                    <textarea name="Description" rows="4"></textarea>
                </label>
                <label class="admin-check">
                    <input type="checkbox" name="IsActive" value="true" checked />
                    <span>Đang hoạt động</span>
                </label>
            </div>
            <div class="admin-form-actions">
                <a class="admin-button" asp-action="Index">Hủy</a>
                <button class="admin-button admin-button-primary" type="submit">Lưu</button>
            </div>
        </form>
    </section>
</section>
