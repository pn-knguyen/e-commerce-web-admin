@{
    var moduleName = ViewData["ModuleName"] as string ?? "Module";
    var entityId = ViewData["EntityId"];
}

<section class="admin-page">
    <header class="admin-page-header">
        <div>
            <span class="admin-kicker">@moduleName</span>
            <h1>Xóa bản ghi</h1>
        </div>
        <div class="admin-page-actions">
            <a class="admin-button" asp-action="Index">Quay lại</a>
        </div>
    </header>

    <section class="admin-panel admin-danger-panel">
        <p>Bạn đang chuẩn bị xóa hoặc ngừng sử dụng bản ghi mã <strong>@entityId</strong>.</p>
        <form method="post">
            @Html.AntiForgeryToken()
            <div class="admin-form-actions">
                <a class="admin-button" asp-action="Index">Hủy</a>
                <button class="admin-button admin-button-danger" type="submit">Xác nhận</button>
            </div>
        </form>
    </section>
</section>
