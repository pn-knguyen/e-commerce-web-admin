@{
    var moduleName = ViewData["ModuleName"] as string ?? "Module";
    var entityId = ViewData["EntityId"];
}

<section class="admin-page">
    <header class="admin-page-header">
        <div>
            <span class="admin-kicker">@moduleName</span>
            <h1>Chi tiết</h1>
        </div>
        <div class="admin-page-actions">
            <a class="admin-button" asp-action="Index">Quay lại</a>
            <a class="admin-button admin-button-primary" asp-action="Edit" asp-route-id="@entityId">Cập nhật</a>
        </div>
    </header>

    <section class="admin-panel">
        <dl class="admin-definition-list">
            <div>
                <dt>Mã bản ghi</dt>
                <dd>@entityId</dd>
            </div>
            <div>
                <dt>Thông tin chính</dt>
                <dd>Chưa có dữ liệu hiển thị.</dd>
            </div>
            <div>
                <dt>Trạng thái</dt>
                <dd>Chưa có dữ liệu hiển thị.</dd>
            </div>
        </dl>
    </section>
</section>
