@model e_commerce_web_admin.ViewModels.CategoryVariantAttributes.CvaIndexViewModel
@{
    ViewData["Title"] = $"Thuộc tính biến thể — {Model.CategoryName}";
    Layout = "_Layout";

    var hasFilters = !string.IsNullOrEmpty(Model.Search);
}

@section Styles {
    <link rel="stylesheet" href="~/css/category-variant-attrs.css" asp-append-version="true" />
}

<main class="surface-page">

@* ── Breadcrumb + Header ── *@
<div class="surface-form-hero cva-anim surface-anim" style="animation-delay:0.04s">
    <nav class="flex items-center gap-2 text-xs text-slate-400 mb-2">
        <a asp-controller="Categories" asp-action="Index" class="hover:text-teal-600 transition-colors">Danh mục</a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <a asp-controller="Attributes" asp-action="Index" class="hover:text-teal-600 transition-colors">Thuộc tính</a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <span class="text-slate-600 font-medium">@Model.CategoryName</span>
    </nav>
    <div class="flex items-center justify-between gap-4">
        <div class="flex items-center gap-3 min-w-0">
            <div class="min-w-0">
                <h1 class="text-2xl font-bold text-slate-800 truncate">
                    Thuộc tính biến thể — <span class="text-teal-600">@Model.CategoryName</span>
                </h1>
                <p class="text-slate-500 text-sm">
                    <span class="font-mono text-slate-400 text-xs">/categories/@Model.CategorySlug</span>
                    &nbsp;·&nbsp;
                    @Model.TotalAssigned thuộc tính đã gán
                </p>
            </div>
        </div>
        <a asp-controller="Categories" asp-action="Index"
           class="inline-flex items-center gap-2 text-sm font-medium flex-shrink-0
                  text-slate-600 bg-white hover:bg-slate-50 hover:text-slate-800
                  border border-slate-200 hover:border-slate-300
                  px-4 py-2 rounded-xl transition-all shadow-sm">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
            Quay lại Danh mục
        </a>
    </div>
</div>

@* ── Phân biệt mục đích ── *@
<div class="surface-flash surface-flash-success p-4 flex items-start gap-3 cva-anim surface-anim" style="animation-delay:0.06s">
    <i data-lucide="info" class="w-5 h-5 text-teal-500 flex-shrink-0 mt-0.5"></i>
    <div>
        <p class="text-sm font-semibold text-teal-800">Thuộc tính biến thể (Variant Attributes)</p>
        <p class="text-xs text-teal-700 mt-0.5">
            Xác định <strong>các trục biến thể</strong> của sản phẩm trong danh mục này (ví dụ: Màu sắc, Kích cỡ, Chất liệu).
            Khác với <span class="font-semibold">Thông số kỹ thuật</span> dùng để mô tả đặc điểm sản phẩm (RAM, Pin, Trọng lượng).
        </p>
    </div>
</div>

@* ── Toasts ── *@
@if (TempData["Success"] != null)
{
    <div class="mb-4 flex items-center gap-3 bg-emerald-50 border border-emerald-200 text-emerald-700 rounded-xl px-4 py-3 text-sm shadow-sm cva-anim"
         style="animation-delay:0.04s">
        <div class="w-7 h-7 rounded-full bg-emerald-100 flex items-center justify-center flex-shrink-0">
            <i data-lucide="check" class="w-4 h-4 text-emerald-600"></i>
        </div>
        <span class="flex-1">@TempData["Success"]</span>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="mb-4 flex items-center gap-3 bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3 text-sm shadow-sm cva-anim"
         style="animation-delay:0.04s">
        <div class="w-7 h-7 rounded-full bg-red-100 flex items-center justify-center flex-shrink-0">
            <i data-lucide="alert-circle" class="w-4 h-4 text-red-500"></i>
        </div>
        <span class="flex-1">@TempData["Error"]</span>
    </div>
}

@* ── 2 column layout ── *@
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    @* ════ LEFT (2/3): Assigned list ════ *@
    <div class="lg:col-span-2 space-y-4">

        @* Table *@
        <div class="surface-console surface-table-card cva-anim surface-anim" style="animation-delay:0.08s">
            <div class="cva-toolbar">
                <form method="get" asp-action="Index" class="cva-filter-grid">
                    <input type="hidden" name="categoryId" value="@Model.CategoryId" />
                    <label class="cva-search-field">
                        <i data-lucide="search" class="w-4 h-4"></i>
                        <input type="text"
                               name="search"
                               value="@Model.Search"
                               placeholder="Tìm theo code hoặc tên thuộc tính..." />
                    </label>
                    <button type="submit" class="cva-filter-submit">
                        <i data-lucide="sliders-horizontal" class="w-4 h-4"></i>
                        <span>Lọc</span>
                    </button>
                    @if (hasFilters)
                    {
                        <a asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="cva-filter-clear">
                            <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
                            <span>Xoá lọc</span>
                        </a>
                    }
                </form>
            </div>

            @if (!Model.AssignedAttributes.Any())
            {
                <div class="surface-empty">
                    <div class="w-16 h-16 rounded-2xl bg-teal-50 flex items-center justify-center mx-auto mb-4">
                        <i data-lucide="list-filter" class="w-8 h-8 text-teal-300"></i>
                    </div>
                    <p class="text-slate-600 font-semibold">@(hasFilters ? "Không tìm thấy thuộc tính phù hợp" : "Chưa có thuộc tính nào được gán")</p>
                    <p class="text-slate-400 text-sm mt-1">
                        @if (hasFilters)
                        {<span>Thử từ khoá khác hoặc <a asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="text-teal-600 hover:underline">xoá bộ lọc</a></span>}
                        else
                        {<span>Dùng form bên phải để gán thuộc tính vào danh mục</span>}
                    </p>
                </div>
            }
            else
            {
                <div class="cva-table-scroll">
                @* Header *@
                <div class="surface-table-head px-5 py-3
                            grid grid-cols-[auto_1fr_auto_auto_auto] gap-4 items-center">
                    <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider w-28">Code</span>
                    <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider">Tên thuộc tính</span>
                    <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider text-center w-20">Giá trị</span>
                    <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider text-center w-20">Dùng bởi</span>
                    <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider text-right w-28">Thao tác</span>
                </div>

                <div class="divide-y divide-slate-50">
                    @{ int idx = 0; }
                    @foreach (var row in Model.AssignedAttributes)
                    {
                        <div class="surface-row cva-row grid grid-cols-[auto_1fr_auto_auto_auto] gap-4 items-center px-5 py-3.5 cva-anim"
                             style="animation-delay:@(0.12 + idx++ * 0.025)s">

                            <div class="w-28">
                                <span class="cva-code-badge">@row.Code</span>
                            </div>

                            <div class="min-w-0">
                                <p class="font-semibold text-slate-800 text-sm truncate">@row.Name</p>
                                <p class="text-[11px] text-slate-400">Gán @row.AssignedAt.ToString("dd/MM/yyyy")</p>
                            </div>

                            <div class="w-20 text-center">
                                <span class="inline-flex items-center justify-center gap-1 text-xs font-semibold rounded-full px-2 py-0.5
                                             @(row.OptionCount > 0 ? "bg-teal-100 text-teal-700" : "bg-slate-100 text-slate-400")">
                                    <i data-lucide="tag" class="w-3 h-3"></i>
                                    @row.OptionCount
                                </span>
                            </div>

                            <div class="w-20 text-center">
                                <span class="inline-flex items-center justify-center gap-1 text-xs font-semibold rounded-full px-2 py-0.5
                                             @(row.VariantUsageCount > 0 ? "bg-blue-100 text-blue-700" : "bg-slate-100 text-slate-400")"
                                      title="@row.VariantUsageCount biến thể sản phẩm đang sử dụng">
                                    <i data-lucide="layers" class="w-3 h-3"></i>
                                    @row.VariantUsageCount
                                </span>
                            </div>

                            <div class="w-28 index-actions">
                                <form asp-action="Remove" method="post"
                                      data-cva-remove
                                      data-attr-name="@row.Name"
                                      data-category-name="@Model.CategoryName"
                                      data-usage="@row.VariantUsageCount">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="categoryId" value="@Model.CategoryId" />
                                    <input type="hidden" name="attributeId" value="@row.AttributeId" />
                                    <button type="submit" class="cva-btn-remove index-action-btn index-action-delete" title="Bỏ gán thuộc tính này">
                                        <i data-lucide="x" class="w-3.5 h-3.5"></i>
                                        Bỏ gán
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
                </div>

                @* Pagination *@
                @if (Model.TotalPages > 1)
                {
                    <div class="surface-pagination px-5 py-3.5 flex items-center justify-between">
                        <p class="text-xs text-slate-400">
                            Trang <span class="font-semibold text-slate-600">@Model.Page</span> / @Model.TotalPages
                            &nbsp;·&nbsp;
                            <span class="font-semibold text-slate-600">@Model.TotalAssigned</span> thuộc tính
                        </p>
                        <div class="flex items-center gap-1">
                            @if (Model.HasPrev)
                            {
                                <a asp-action="Index" asp-route-categoryId="@Model.CategoryId"
                                   asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search"
                                   class="w-8 h-8 rounded-lg border border-slate-200 bg-white hover:bg-slate-50
                                          flex items-center justify-center text-slate-600 transition-colors shadow-sm">
                                    <i data-lucide="chevron-left" class="w-4 h-4"></i>
                                </a>
                            }
                            @for (int p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.TotalPages, Model.Page + 2); p++)
                            {
                                <a asp-action="Index" asp-route-categoryId="@Model.CategoryId"
                                   asp-route-page="@p" asp-route-search="@Model.Search"
                                   class="w-8 h-8 rounded-lg text-xs font-semibold flex items-center justify-center transition-all
                                          @(p == Model.Page
                                              ? "bg-gradient-to-b from-teal-500 to-teal-600 text-white shadow-sm"
                                              : "border border-slate-200 bg-white text-slate-600 hover:bg-slate-50")">
                                    @p
                                </a>
                            }
                            @if (Model.HasNext)
                            {
                                <a asp-action="Index" asp-route-categoryId="@Model.CategoryId"
                                   asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search"
                                   class="w-8 h-8 rounded-lg border border-slate-200 bg-white hover:bg-slate-50
                                          flex items-center justify-center text-slate-600 transition-colors shadow-sm">
                                    <i data-lucide="chevron-right" class="w-4 h-4"></i>
                                </a>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    @* ════ RIGHT (1/3): Assign form ════ *@
    <div class="space-y-4 cva-anim" style="animation-delay:0.1s">

        @* Assign form *@
        <div class="surface-form-card cva-assign-panel rounded-2xl p-5">
            <h3 class="text-sm font-semibold text-teal-800 mb-4 flex items-center gap-2">
                <i data-lucide="plus-circle" class="w-4 h-4 text-teal-600"></i>
                Gán thuộc tính vào danh mục
            </h3>

            <div data-surface-form-alert class="surface-form-alert hidden">
                <i data-lucide="alert-triangle" class="w-4 h-4"></i>
                <div>
                    <p>Vui lòng kiểm tra lại thông tin.</p>
                </div>
            </div>

            @if (!Model.AvailableAttributes.Any())
            {
                <div class="text-center py-6">
                    <i data-lucide="check-circle-2" class="w-8 h-8 text-teal-300 mx-auto mb-2"></i>
                    <p class="text-xs text-teal-700 font-medium">Tất cả thuộc tính đã được gán!</p>
                    <p class="text-xs text-teal-500 mt-1">
                        Tạo thêm thuộc tính mới tại
                        <a asp-controller="Attributes" asp-action="Index" class="underline hover:text-teal-700">trang thuộc tính</a>.
                    </p>
                </div>
            }
            else
            {
                <form asp-action="Assign" method="post" class="space-y-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="CategoryId" value="@Model.CategoryId" />
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1.5">
                            Chọn thuộc tính <span class="text-red-500">*</span>
                        </label>
                        <select name="AttributeId" required
                                class="w-full border border-teal-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-800 bg-white
                                       focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition">
                            <option value="">-- Chọn thuộc tính --</option>
                            @foreach (var opt in Model.AvailableAttributes)
                            {
                                <option value="@opt.Id">
                                    @opt.Name (@opt.Code) — @opt.OptionCount giá trị
                                </option>
                            }
                        </select>
                    </div>
                    <button type="submit"
                            class="w-full flex items-center justify-center gap-2
                                   bg-gradient-to-r from-teal-500 to-teal-600 hover:from-teal-600 hover:to-teal-700
                                   text-white text-sm font-semibold px-4 py-2.5 rounded-xl transition-all shadow-sm hover:shadow-md">
                        <i data-lucide="plus" class="w-4 h-4"></i>
                        Gán thuộc tính
                    </button>
                </form>
            }
        </div>

        @* Quick links *@
        <div class="surface-form-card bg-white rounded-2xl border border-slate-100 p-4 shadow-sm">
            <h4 class="text-xs font-semibold text-slate-600 mb-3">Liên kết nhanh</h4>
            <div class="space-y-2">
                <a asp-controller="CategorySpecifications" asp-action="Index" asp-route-categoryId="@Model.CategoryId"
                   class="flex items-center gap-2.5 p-2.5 rounded-xl hover:bg-teal-50 transition-colors group">
                    <div class="w-7 h-7 rounded-lg bg-teal-100 flex items-center justify-center flex-shrink-0">
                        <i data-lucide="sliders-horizontal" class="w-3.5 h-3.5 text-teal-600"></i>
                    </div>
                    <div class="min-w-0">
                        <p class="text-xs font-semibold text-slate-700 group-hover:text-teal-700">Thông số kỹ thuật</p>
                        <p class="text-[10px] text-slate-400">Gán thông số cho danh mục này</p>
                    </div>
                    <i data-lucide="chevron-right" class="w-3.5 h-3.5 text-slate-300 ml-auto"></i>
                </a>
                <a asp-controller="Attributes" asp-action="Index"
                   class="flex items-center gap-2.5 p-2.5 rounded-xl hover:bg-teal-50 transition-colors group">
                    <div class="w-7 h-7 rounded-lg bg-teal-100 flex items-center justify-center flex-shrink-0">
                        <i data-lucide="list-filter" class="w-3.5 h-3.5 text-teal-600"></i>
                    </div>
                    <div class="min-w-0">
                        <p class="text-xs font-semibold text-slate-700 group-hover:text-teal-700">Quản lý thuộc tính</p>
                        <p class="text-[10px] text-slate-400">Tạo mới hoặc thêm giá trị</p>
                    </div>
                    <i data-lucide="chevron-right" class="w-3.5 h-3.5 text-slate-300 ml-auto"></i>
                </a>
            </div>
        </div>
    </div>
</div>
</main>

@section Scripts {
    <script src="~/js/category-variant-attrs.js" asp-append-version="true"></script>
}
