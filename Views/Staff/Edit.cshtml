@model e_commerce_web_admin.ViewModels.Staff.StaffFormViewModel
@{
    ViewData["Title"] = "Sửa nhân sự";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/products.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/identity-admin.css" asp-append-version="true" />
}

<main class="surface-page identity-page">
    <div class="surface-form-hero product-anim surface-anim" style="animation-delay:0.04s">
        <nav class="flex items-center gap-2 text-xs text-slate-400 mb-2">
            <a asp-action="Index" class="hover:text-teal-600 transition-colors">Nhân sự quản trị</a>
            <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
            <span class="text-slate-600 font-medium">@Model.UserName</span>
        </nav>
        <h1>Sửa nhân sự</h1>
        <p>Cập nhật thông tin đăng nhập, vai trò và trạng thái hoạt động cho tài khoản staff.</p>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="product-anim surface-anim" style="animation-delay:0.1s" novalidate>
        @Html.AntiForgeryToken()
        <partial name="_Form" model="Model" />
    </form>
</main>
