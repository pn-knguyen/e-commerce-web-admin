@model e_commerce_web_admin.ViewModels.Attributes.AttributeIndexViewModel
@{
    ViewData["Title"] = "Thuộc tính biến thể";
    Layout = "_Layout";

    var hasFilters = !string.IsNullOrEmpty(Model.Search);
}

@section Styles {
    <link rel="stylesheet" href="~/css/attributes.css" asp-append-version="true" />
}

@* ── Header ── *@
<main class="surface-page attr-page">
    <div class="surface-hero attr-anim surface-anim" style="animation-delay:0.04s">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <h1 class="text-2xl font-bold text-slate-800">Thuộc tính biến thể</h1>
            </div>
            <p class="text-slate-500 text-sm">Quản lý các thuộc tính và giá trị dùng cho biến thể sản phẩm</p>
        </div>
        <a asp-action="Create"
           class="inline-flex items-center gap-2 bg-gradient-to-r from-teal-500 to-teal-600 hover:from-teal-600 hover:to-teal-700
            text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-all shadow-sm hover:shadow-md hover:-translate-y-0.5">
            <i data-lucide="plus" class="w-4 h-4"></i>
            Thêm thuộc tính
        </a>
    </div>

    @* ── Toasts ── *@
    @if (TempData["Success"] != null)
    {
        <div id="toastSuccess"
             class="mb-4 flex items-center gap-3 bg-emerald-50 border border-emerald-200 text-emerald-700 rounded-xl px-4 py-3 text-sm shadow-sm attr-anim"
             style="animation-delay:0.04s">
            <div class="w-7 h-7 rounded-full bg-emerald-100 flex items-center justify-center flex-shrink-0">
                <i data-lucide="check" class="w-4 h-4 text-emerald-600"></i>
            </div>
            <span class="flex-1" data-toast-text>@TempData["Success"]</span>
            <button type="button" data-dismiss-target="toastSuccess"
                    class="text-emerald-400 hover:text-emerald-600 transition-colors">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div id="toastError"
             class="mb-4 flex items-center gap-3 bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3 text-sm shadow-sm attr-anim"
             style="animation-delay:0.04s">
            <div class="w-7 h-7 rounded-full bg-red-100 flex items-center justify-center flex-shrink-0">
                <i data-lucide="alert-circle" class="w-4 h-4 text-red-500"></i>
            </div>
            <span class="flex-1" data-toast-text>@TempData["Error"]</span>
            <button type="button" data-dismiss-target="toastError"
                    class="text-red-400 hover:text-red-600 transition-colors">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>
    }

    @* ── Stats cards ── *@
    <div class="surface-metrics attr-anim surface-anim" style="animation-delay:0.08s">
        <div class="bg-white rounded-2xl border border-slate-100 p-4 flex items-center gap-3 shadow-sm">
            <div class="w-10 h-10 rounded-xl bg-teal-50 flex items-center justify-center flex-shrink-0">
                <i data-lucide="list-filter" class="w-5 h-5 text-teal-500"></i>
            </div>
            <div>
                <p class="text-xl font-bold text-slate-800">@Model.TotalCount</p>
                <p class="text-xs text-slate-400">Thuộc tính</p>
            </div>
        </div>
        <div class="bg-white rounded-2xl border border-slate-100 p-4 flex items-center gap-3 shadow-sm">
            <div class="w-10 h-10 rounded-xl bg-violet-50 flex items-center justify-center flex-shrink-0">
                <i data-lucide="tag" class="w-5 h-5 text-violet-500"></i>
            </div>
            <div>
                <p class="text-xl font-bold text-violet-600">@Model.TotalOptionCount</p>
                <p class="text-xs text-slate-400">Tổng giá trị</p>
            </div>
        </div>
        <div class="bg-white rounded-2xl border border-slate-100 p-4 flex items-center gap-3 shadow-sm">
            <div class="w-10 h-10 rounded-xl bg-amber-50 flex items-center justify-center flex-shrink-0">
                <i data-lucide="folder-tree" class="w-5 h-5 text-amber-500"></i>
            </div>
            <div>
                <p class="text-xl font-bold text-amber-600">@Model.TotalCategoryUsageCount</p>
                <p class="text-xs text-slate-400">Gán vào danh mục</p>
            </div>
        </div>
        <div class="bg-white rounded-2xl border border-slate-100 p-4 flex items-center gap-3 shadow-sm">
            <div class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center flex-shrink-0">
                <i data-lucide="layers" class="w-5 h-5 text-blue-500"></i>
            </div>
            <div>
                <p class="text-xl font-bold text-blue-600">@Model.TotalVariantUsageCount</p>
                <p class="text-xs text-slate-400">Dùng ở biến thể</p>
            </div>
        </div>
    </div>

    @* ── Table ── *@
    <div class="surface-console surface-table-card attr-anim surface-anim" style="animation-delay:0.12s">
        <div class="attr-toolbar">
            <form method="get" asp-action="Index" class="attr-filter-grid">
                <label class="attr-search-field">
                    <i data-lucide="search" class="w-4 h-4"></i>
                    <input type="text"
                           name="search"
                           value="@Model.Search"
                           placeholder="Tìm theo code hoặc tên..." />
                </label>
                <button type="submit" class="attr-filter-submit">
                    <i data-lucide="sliders-horizontal" class="w-4 h-4"></i>
                    <span>Lọc</span>
                </button>
                @if (hasFilters)
                {
                    <a asp-action="Index" class="attr-filter-clear">
                        <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
                        <span>Xoá lọc</span>
                    </a>
                }
            </form>
        </div>

        @if (!Model.Attributes.Any())
        {
            <div class="admin-empty">
                <span class="admin-empty-icon">
                    <i data-lucide="list-filter" class="w-9 h-9"></i>
                </span>
                <h2>Không tìm thấy thuộc tính</h2>
                @if (hasFilters)
                {
                    <p>Điều chỉnh từ khóa hoặc xóa bộ lọc để xem lại toàn bộ thuộc tính.</p>
                    <a asp-action="Index" class="admin-empty-action">Xóa bộ lọc</a>
                }
                else
                {
                    <p>Tạo thuộc tính đầu tiên để cấu hình dung lượng, kích thước, chất liệu hoặc các lựa chọn biến thể khác.</p>
                    <a asp-action="Create" class="admin-empty-action">Thêm thuộc tính</a>
                }
            </div>
        }
        else
        {
            <div class="attr-table-scroll">
                @* Header *@
                <div class="surface-table-head attr-table-head attr-index-grid px-6 py-3.5
                    grid grid-cols-[auto_1fr_auto_auto_auto_auto] gap-4 items-center">
                    <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider w-32">Code</span>
                    <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Tên thuộc tính</span>
                    <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider text-center w-24">Giá trị</span>
                    <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider text-center w-24">Danh mục</span>
                    <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider text-center w-24">Biến thể</span>
                    <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider text-right w-36">Thao tác</span>
                </div>

                <div class="divide-y divide-slate-50">
                    @{
                        int animIdx = 0;
                    }
                    @foreach (var attr in Model.Attributes)
                    {
                        <div class="surface-row attr-row attr-index-grid grid grid-cols-[auto_1fr_auto_auto_auto_auto] gap-4 items-center px-6 py-3.5 attr-anim"
                             style="animation-delay:@(0.16 + animIdx++ * 0.025)s">

                            @* Code *@
                            <div class="attr-code-cell w-32">
                                <span class="attr-card-label">Code</span>
                                <span class="attr-code-badge">@attr.Code</span>
                            </div>

                            @* Name *@
                            <div class="attr-name-cell min-w-0">
                                <span class="attr-card-label">Tên thuộc tính</span>
                                <p class="font-semibold text-slate-800 text-sm truncate">@attr.Name</p>
                            </div>

                            @* Option count *@
                            <div class="attr-option-count-cell w-24 text-center">
                                <span class="attr-card-label">Giá trị</span>
                                <span
                                    class="inline-flex items-center justify-center gap-1 text-xs font-semibold rounded-full px-2.5 py-1
                                    @(attr.OptionCount > 0 ? "bg-violet-100 text-violet-700" : "bg-slate-100 text-slate-400")">
                                    <i data-lucide="tag" class="w-3 h-3"></i>
                                    @attr.OptionCount
                                </span>
                            </div>

                            @* Category usage *@
                            <div class="attr-category-count-cell w-24 text-center">
                                <span class="attr-card-label">Danh mục</span>
                                <span
                                    class="inline-flex items-center justify-center gap-1 text-xs font-semibold rounded-full px-2.5 py-1
                                    @(attr.CategoryCount > 0 ? "bg-amber-100 text-amber-700" : "bg-slate-100 text-slate-400")">
                                    <i data-lucide="folder" class="w-3 h-3"></i>
                                    @attr.CategoryCount
                                </span>
                            </div>

                            @* Variant usage *@
                            <div class="attr-variant-count-cell w-24 text-center">
                                <span class="attr-card-label">Biến thể</span>
                                <span
                                    class="inline-flex items-center justify-center gap-1 text-xs font-semibold rounded-full px-2.5 py-1
                                    @(attr.VariantUsageCount > 0 ? "bg-blue-100 text-blue-700" : "bg-slate-100 text-slate-400")">
                                    <i data-lucide="layers" class="w-3 h-3"></i>
                                    @attr.VariantUsageCount
                                </span>
                            </div>

                            @* Actions *@
                            <div class="attr-actions-cell w-36 index-actions">
                                <span class="attr-card-label">Thao tác</span>
                                <a asp-action="Edit" asp-route-id="@attr.Id" title="Chỉnh sửa & quản lý options"
                                   class="index-action-btn index-action-edit">
                                    <i data-lucide="pencil" class="w-4 h-4 shrink-0"></i>
                                    Sửa
                                </a>
                                <form asp-action="Delete" asp-route-id="@attr.Id" method="post" data-attr-delete
                                      data-attr-name="@attr.Name" data-option-count="@attr.OptionCount"
                                      data-category-count="@attr.CategoryCount">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" title="Xoá thuộc tính" class="index-action-btn index-action-delete">
                                        <i data-lucide="trash-2" class="w-4 h-4 shrink-0"></i>
                                        Xoá
                                    </button>
                                </form>
                            </div>

                        </div>
                    }
                </div>
                </div>

                @* Pagination *@
                @if (Model.TotalPages > 1)
                {
                    <div class="surface-pagination px-6 py-4 flex items-center justify-between">
                        <p class="text-xs text-slate-400">
                            Trang <span class="font-semibold text-slate-600">@Model.Page</span> / @Model.TotalPages
                            &nbsp;·&nbsp;
                            <span class="font-semibold text-slate-600">@Model.TotalCount</span> thuộc tính
                        </p>
                        <div class="flex items-center gap-1">
                            @if (Model.HasPrev)
                            {
                                <a asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search" class="w-8 h-8 rounded-lg border border-slate-200 bg-white hover:bg-slate-50
                                    flex items-center justify-center text-slate-600 transition-colors shadow-sm">
                                    <i data-lucide="chevron-left" class="w-4 h-4"></i>
                                </a>
                            }
                            @for (int p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.TotalPages, Model.Page + 2); p++)
                            {
                                <a asp-action="Index" asp-route-page="@p" asp-route-search="@Model.Search" class="w-8 h-8 rounded-lg text-xs font-semibold flex items-center justify-center transition-all
                                    @(p == Model.Page
                                      ? "bg-gradient-to-b from-teal-500 to-teal-600 text-white shadow-sm"
                                      : "border border-slate-200 bg-white text-slate-600 hover:bg-slate-50")">
                                    @p
                                </a>
                            }
                            @if (Model.HasNext)
                            {
                                <a asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search" class="w-8 h-8 rounded-lg border border-slate-200 bg-white hover:bg-slate-50
                                    flex items-center justify-center text-slate-600 transition-colors shadow-sm">
                                    <i data-lucide="chevron-right" class="w-4 h-4"></i>
                                </a>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </main>

    @section Scripts {
        <script src="~/js/attributes.js" asp-append-version="true"></script>
    }
