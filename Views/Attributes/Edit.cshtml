@model e_commerce_web_admin.ViewModels.Attributes.AttributeEditViewModel
@{
    ViewData["Title"] = $"Thuộc tính — {Model.Form.Name}";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/attributes.css" asp-append-version="true" />
}

@* Anti-forgery token dùng cho JS AJAX *@
@Html.AntiForgeryToken()

@* ── Breadcrumb + Header ── *@
<div class="mb-6 attr-anim" style="animation-delay:0.04s">
    <nav class="flex items-center gap-2 text-xs text-slate-400 mb-2">
        <a asp-action="Index" class="hover:text-teal-600 transition-colors">Thuộc tính</a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <span class="text-slate-600 font-medium">@Model.Form.Name</span>
    </nav>
    <div class="flex items-center justify-between gap-4">
        <div class="flex items-center gap-3 min-w-0">
            <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-teal-400 to-teal-600 flex items-center justify-center shadow-sm flex-shrink-0">
                <i data-lucide="list-filter" class="w-4 h-4 text-white"></i>
            </div>
            <div class="min-w-0">
                <h1 class="text-2xl font-bold text-slate-800 truncate">@Model.Form.Name</h1>
                <p class="text-slate-400 text-xs font-mono">code: @Model.Form.Code</p>
            </div>
        </div>
        <a asp-action="Index"
           class="inline-flex items-center gap-2 text-sm font-medium flex-shrink-0
                  text-slate-600 bg-white hover:bg-slate-50 hover:text-slate-800
                  border border-slate-200 hover:border-slate-300
                  px-4 py-2 rounded-xl transition-all shadow-sm">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
            Quay lại
        </a>
    </div>
</div>

@* ── Toasts AJAX ── *@
<div id="toastSuccess"
     class="hidden mb-4 flex items-center gap-3 bg-emerald-50 border border-emerald-200 text-emerald-700 rounded-xl px-4 py-3 text-sm shadow-sm">
    <div class="w-7 h-7 rounded-full bg-emerald-100 flex items-center justify-center flex-shrink-0">
        <i data-lucide="check" class="w-4 h-4 text-emerald-600"></i>
    </div>
    <span class="flex-1" data-toast-text></span>
    <button type="button" data-dismiss-target="toastSuccess" class="text-emerald-400 hover:text-emerald-600 transition-colors">
        <i data-lucide="x" class="w-4 h-4"></i>
    </button>
</div>
<div id="toastError"
     class="hidden mb-4 flex items-center gap-3 bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3 text-sm shadow-sm">
    <div class="w-7 h-7 rounded-full bg-red-100 flex items-center justify-center flex-shrink-0">
        <i data-lucide="alert-circle" class="w-4 h-4 text-red-500"></i>
    </div>
    <span class="flex-1" data-toast-text></span>
    <button type="button" data-dismiss-target="toastError" class="text-red-400 hover:text-red-600 transition-colors">
        <i data-lucide="x" class="w-4 h-4"></i>
    </button>
</div>

@* TempData server-side *@
@if (TempData["Success"] != null)
{
    <div class="mb-4 flex items-center gap-3 bg-emerald-50 border border-emerald-200 text-emerald-700 rounded-xl px-4 py-3 text-sm shadow-sm">
        <i data-lucide="check" class="w-4 h-4 text-emerald-600"></i>
        <span>@TempData["Success"]</span>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="mb-4 flex items-center gap-3 bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3 text-sm shadow-sm">
        <i data-lucide="alert-circle" class="w-4 h-4 text-red-500"></i>
        <span>@TempData["Error"]</span>
    </div>
}

@* ── Edit form (dùng _Form partial dùng chung) ── *@
<form asp-action="Edit" asp-route-id="@Model.Form.Id" method="post" class="attr-anim" style="animation-delay:0.08s">
    @Html.AntiForgeryToken()
    <partial name="_Form" model="Model.Form" />
</form>

@* ── Options panel (AJAX) ── *@
<div class="mt-6 attr-anim" style="animation-delay:0.14s">
    <div class="flex items-center gap-2 mb-4">
        <div class="w-7 h-7 rounded-lg bg-violet-100 flex items-center justify-center flex-shrink-0">
            <i data-lucide="tag" class="w-3.5 h-3.5 text-violet-600"></i>
        </div>
        <h2 class="text-lg font-bold text-slate-800">Giá trị (Options)</h2>
        <span class="inline-flex items-center justify-center text-xs font-bold bg-violet-100 text-violet-700 rounded-full px-2 py-0.5"
              id="optionCount">—</span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        @* Options list *@
        <div class="lg:col-span-2">
            <div id="optionsPanel"
                 class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden"
                 data-attribute-id="@Model.Form.Id">

                <div class="px-5 py-3 border-b border-slate-100 flex items-center justify-between bg-gradient-to-r from-violet-50/60 to-transparent">
                    <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Danh sách giá trị</p>
                    <div class="relative">
                        <i data-lucide="search" class="absolute left-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-slate-400 pointer-events-none"></i>
                        <input id="optionFilter" type="text"
                               placeholder="Lọc nhanh..."
                               class="pl-7 pr-3 py-1.5 border border-slate-200 rounded-lg text-xs text-slate-700
                                      focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition w-36" />
                    </div>
                </div>

                <div class="grid grid-cols-[1fr_1fr_auto_auto] gap-2 px-4 py-2 bg-slate-50/80 border-b border-slate-100">
                    <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider">Value (code)</span>
                    <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider">Label (hiển thị)</span>
                    <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider text-center w-12">Dùng</span>
                    <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider text-right w-16">Xoá</span>
                </div>

                <div id="optionsList" class="divide-y divide-slate-50 max-h-96 overflow-y-auto"></div>
            </div>
        </div>

        @* Add option form *@
        <div>
            <div class="assign-panel rounded-2xl p-5">
                <h3 class="text-sm font-semibold text-teal-700 mb-4 flex items-center gap-2">
                    <i data-lucide="plus-circle" class="w-4 h-4"></i>
                    Thêm giá trị mới
                </h3>
                <form id="addOptionForm" class="space-y-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1.5">
                            Value <span class="text-red-500">*</span>
                            <span class="font-normal text-slate-400">(snake_case)</span>
                        </label>
                        <input type="text" name="value"
                               placeholder="ví dụ: red, size_xl"
                               class="w-full border border-slate-200 rounded-xl px-3 py-2 text-sm text-slate-800 font-mono
                                      focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1.5">
                            Label <span class="text-red-500">*</span>
                        </label>
                        <input type="text" name="label"
                               placeholder="ví dụ: Đỏ, Size XL"
                               class="w-full border border-slate-200 rounded-xl px-3 py-2 text-sm text-slate-800
                                      focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition" />
                    </div>
                    <button type="submit"
                            class="w-full flex items-center justify-center gap-2
                                   bg-gradient-to-r from-teal-500 to-teal-600 hover:from-teal-600 hover:to-teal-700
                                   text-white text-sm font-semibold px-4 py-2.5 rounded-xl transition-all shadow-sm hover:shadow-md">
                        <i data-lucide="plus" class="w-4 h-4"></i>
                        Thêm
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/attributes.js" asp-append-version="true"></script>
}
