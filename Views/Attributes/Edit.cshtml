@model e_commerce_web_admin.ViewModels.Attributes.AttributeEditViewModel
@{
    ViewData["Title"] = $"Chỉnh sửa thuộc tính - {Model.Form.Name}";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/attributes.css" asp-append-version="true" />
}

<div class="surface-form-hero attr-anim surface-anim" style="animation-delay:0.04s">
    <nav class="flex items-center gap-2 text-xs text-slate-400 mb-2">
        <a asp-action="Index" class="hover:text-teal-600 transition-colors">Thuộc tính</a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <span class="text-slate-600 font-medium">Chỉnh sửa</span>
    </nav>
    <h1 class="text-2xl font-bold text-slate-800">Chỉnh sửa thuộc tính</h1>
    <p class="text-slate-500 text-sm mt-0.5">Cập nhật thông tin thuộc tính và quản lý các giá trị dùng cho biến thể sản phẩm.</p>
</div>

<div id="toastSuccess"
     class="hidden mb-4 flex items-center gap-3 bg-emerald-50 border border-emerald-200 text-emerald-700 rounded-xl px-4 py-3 text-sm shadow-sm attr-anim"
     style="animation-delay:0.06s">
    <div class="w-7 h-7 rounded-full bg-emerald-100 flex items-center justify-center flex-shrink-0">
        <i data-lucide="check" class="w-4 h-4 text-emerald-600"></i>
    </div>
    <span class="flex-1" data-toast-text></span>
    <button type="button" data-dismiss-target="toastSuccess" class="text-emerald-400 hover:text-emerald-600 transition-colors">
        <i data-lucide="x" class="w-4 h-4"></i>
    </button>
</div>

<div id="toastError"
     class="hidden mb-4 flex items-center gap-3 bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3 text-sm shadow-sm attr-anim"
     style="animation-delay:0.06s">
    <div class="w-7 h-7 rounded-full bg-red-100 flex items-center justify-center flex-shrink-0">
        <i data-lucide="alert-circle" class="w-4 h-4 text-red-500"></i>
    </div>
    <span class="flex-1" data-toast-text></span>
    <button type="button" data-dismiss-target="toastError" class="text-red-400 hover:text-red-600 transition-colors">
        <i data-lucide="x" class="w-4 h-4"></i>
    </button>
</div>

@if (TempData["Success"] != null)
{
    <div class="mb-4 flex items-center gap-3 bg-emerald-50 border border-emerald-200 text-emerald-700 rounded-xl px-4 py-3 text-sm shadow-sm attr-anim"
         style="animation-delay:0.06s">
        <i data-lucide="check" class="w-4 h-4 text-emerald-600"></i>
        <span>@TempData["Success"]</span>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="mb-4 flex items-center gap-3 bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3 text-sm shadow-sm attr-anim"
         style="animation-delay:0.06s">
        <i data-lucide="alert-circle" class="w-4 h-4 text-red-500"></i>
        <span>@TempData["Error"]</span>
    </div>
}

<form asp-action="Edit" asp-route-id="@Model.Form.Id" method="post" class="attr-anim surface-anim" style="animation-delay:0.1s">
    @Html.AntiForgeryToken()
    <partial name="_Form" model="Model.Form" />
</form>

<div id="optionsPanel"
     class="mt-6 surface-console surface-table-card overflow-hidden attr-anim surface-anim"
     style="animation-delay:0.14s"
     data-attribute-id="@Model.Form.Id">
    <div class="attr-option-card-head">
        <div>
            <h2 class="text-sm font-semibold text-slate-700 flex items-center gap-2">
                <i data-lucide="tags" class="w-4 h-4 text-violet-600"></i>
                Giá trị thuộc tính
                <span id="optionCount" class="inline-flex items-center justify-center text-xs font-bold bg-violet-100 text-violet-700 rounded-full px-2 py-0.5">-</span>
            </h2>
            <p class="text-xs text-slate-400 mt-1">Thêm, chỉnh sửa hoặc xoá các giá trị có thể chọn khi tạo biến thể sản phẩm.</p>
        </div>

        <label class="attr-option-filter">
            <i data-lucide="search" class="w-3.5 h-3.5"></i>
            <input id="optionFilter" type="text" placeholder="Lọc nhanh giá trị..." />
        </label>
    </div>

    <div class="surface-table-head attr-option-head-grid px-5 py-3 max-md:hidden">
        <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Mã giá trị</span>
        <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Tên hiển thị</span>
        <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider text-center">Đang dùng</span>
        <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider text-right">Thao tác</span>
    </div>

    <div id="optionsList" class="divide-y divide-slate-100 max-h-[26rem] overflow-y-auto"></div>

    <div class="attr-option-add-panel" data-attr-add-option-panel>
        <div data-surface-form-alert class="surface-form-alert hidden">
            <i data-lucide="alert-triangle" class="w-4 h-4"></i>
            <div>
                <p>Vui lòng kiểm tra lại thông tin.</p>
            </div>
        </div>

        <form id="addOptionForm" class="attr-option-add-form">
            <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1.5">
                    Mã giá trị <span class="text-red-500">*</span>
                    <span class="font-normal text-slate-400">(snake_case)</span>
                </label>
                <input type="text" name="value" maxlength="120" placeholder="ví dụ: red, size_xl" class="w-full border border-slate-200 rounded-xl px-3 py-2 text-sm text-slate-800 font-mono focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition" />
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1.5">
                    Tên hiển thị <span class="text-red-500">*</span>
                </label>
                <input type="text" name="label" maxlength="255" placeholder="ví dụ: Đỏ, Size XL" class="w-full border border-slate-200 rounded-xl px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition" />
            </div>

            <button type="submit" class="attr-option-add-submit">
                <i data-lucide="plus" class="w-4 h-4"></i>
                <span>Thêm option</span>
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/attributes.js" asp-append-version="true"></script>
}
