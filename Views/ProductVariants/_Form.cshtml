@model e_commerce_web_admin.ViewModels.ProductVariants.ProductVariantFormViewModel
@{
    var isEdit = Model.Id > 0;
    var selectedProduct = Model.ProductOptions.FirstOrDefault(product => product.Id == Model.ProductId);
    var attributeItems = Model.Attributes.Select((attribute, index) => new { attribute, index }).ToList();
    var imageItems = Model.Images.Select((image, index) => new { image, index }).ToList();
    var priceValue = Model.Price.HasValue
        ? Model.Price.Value.ToString("0", System.Globalization.CultureInfo.InvariantCulture)
        : string.Empty;

    string PickerColor(string? color)
    {
        var value = string.IsNullOrWhiteSpace(color) ? string.Empty : color.Trim();
        return value.Length == 7 && value[0] == '#' && value.Skip(1).All(Uri.IsHexDigit)
            ? value
            : "#111827";
    }
}

<input type="hidden" asp-for="Id" />

<div class="pv-form-card pv-form-unified">
    <div class="pv-form-card-head">
        <span class="pv-form-head-icon">
            <i data-lucide="layers-3" class="w-5 h-5"></i>
        </span>
        <div>
            <h2>Thông tin biến thể</h2>
            <p>Quản lý SKU, giá bán, thuộc tính, ảnh và trạng thái trong cùng một biểu mẫu.</p>
        </div>
    </div>

    <div class="pv-form-body">
        <div data-pv-form-alert class="pv-form-alert @(ViewData.ModelState.IsValid ? "hidden" : "")">
            <i data-lucide="alert-triangle" class="w-4 h-4"></i>
            <div>
                <p>Vui lòng kiểm tra lại thông tin.</p>
                <div asp-validation-summary="ModelOnly"></div>
            </div>
        </div>

        <section class="pv-form-section">
            <div class="pv-form-section-title">
                <span><i data-lucide="barcode" class="w-4 h-4"></i></span>
                <div>
                    <h3>Tổng quan</h3>
                    <p>Chọn sản phẩm, nhập mã SKU và giá bán cho biến thể.</p>
                </div>
            </div>

            <div class="pv-form-fields">
                <div class="pv-field" data-pv-field>
                    <label asp-for="ProductId" class="pv-label">
                        <span>Sản phẩm</span>
                        <strong>*</strong>
                    </label>

                    @if (Model.IsProductLocked)
                    {
                        <input type="hidden" asp-for="ProductId" />
                        <input type="hidden" value="@selectedProduct?.CategoryId" data-pv-locked-category-id />
                        <div class="pv-locked-product">
                            <strong>@(string.IsNullOrWhiteSpace(Model.ProductName) ? "Sản phẩm hiện tại" : Model.ProductName)</strong>
                            <span>@(string.IsNullOrWhiteSpace(Model.ProductMeta) ? "Không đổi sản phẩm khi sửa biến thể" : Model.ProductMeta)</span>
                        </div>
                    }
                    else
                    {
                        <label class="pv-select-control">
                            <select asp-for="ProductId"
                                    data-pv-product-select
                                    data-pv-required="Vui lòng chọn sản phẩm."
                                    data-pv-error-target="pv-product-error">
                                <option value="">Chọn sản phẩm</option>
                                @foreach (var product in Model.ProductOptions)
                                {
                                    <option value="@product.Id"
                                            data-category-id="@product.CategoryId"
                                            selected="@(Model.ProductId == product.Id ? "selected" : null)">
                                        @product.Label @(product.IsActive ? "" : "(đang tắt)")
                                    </option>
                                }
                            </select>
                        </label>
                    }

                    <span asp-validation-for="ProductId" id="pv-product-error" class="pv-field-error"></span>
                </div>

                <div class="pv-field-row">
                    <div class="pv-field" data-pv-field>
                        <label asp-for="Code" class="pv-label">
                            <span>Mã SKU</span>
                            <strong>*</strong>
                        </label>
                        <input asp-for="Code"
                               class="pv-input"
                               maxlength="80"
                               autocomplete="off"
                               data-pv-code
                               data-pv-required="Mã biến thể là bắt buộc."
                               data-pv-pattern="^[A-Z0-9][A-Z0-9_-]{1,79}$"
                               data-pv-pattern-message="Mã biến thể chỉ gồm chữ in hoa, số, dấu gạch ngang hoặc gạch dưới."
                               data-pv-error-target="pv-code-error"
                               placeholder="Ví dụ: IP15PM-256-BLK" />
                        <span asp-validation-for="Code" id="pv-code-error" class="pv-field-error"></span>
                    </div>

                    <div class="pv-field" data-pv-field>
                        <label asp-for="Price" class="pv-label">
                            <span>Giá bán</span>
                            <strong>*</strong>
                        </label>
                        <div class="pv-money-wrap">
                            <input id="Price"
                                   name="Price"
                                   value="@priceValue"
                                   type="number"
                                   min="0"
                                   step="1000"
                                   class="pv-input"
                                   data-pv-required="Giá bán là bắt buộc."
                                   data-pv-number-min="0"
                                   data-pv-number-message="Giá bán không được âm."
                                   data-pv-error-target="pv-price-error"
                                   placeholder="0" />
                            <span>đ</span>
                        </div>
                        <span asp-validation-for="Price" id="pv-price-error" class="pv-field-error"></span>
                    </div>
                </div>
                <div class="pv-field-row">
                    <div class="pv-field" data-pv-field>
                        <label asp-for="ColorName" class="pv-label">
                            <span>Tên màu</span>
                        </label>
                        <input asp-for="ColorName"
                               class="pv-input"
                               maxlength="120"
                               autocomplete="off"
                               data-pv-error-target="pv-color-name-error"
                               placeholder="Ví dụ: Titan Đen" />
                        <span asp-validation-for="ColorName" id="pv-color-name-error" class="pv-field-error"></span>
                    </div>

                    <div class="pv-field" data-pv-field>
                        <label asp-for="ColorHex" class="pv-label">
                            <span>Mã màu</span>
                        </label>
                        <div class="pv-color-control">
                            <input type="color"
                                   value="@PickerColor(Model.ColorHex)"
                                   class="pv-color-picker"
                                   data-pv-variant-color-picker
                                   aria-label="Chọn mã màu biến thể" />
                            <input asp-for="ColorHex"
                                   class="pv-color-text"
                                   maxlength="7"
                                   autocomplete="off"
                                   data-pv-variant-color-text
                                   data-pv-pattern="^#[0-9a-fA-F]{6}$"
                                   data-pv-pattern-message="Mã màu phải đúng định dạng #RRGGBB."
                                   data-pv-error-target="pv-color-hex-error"
                                   placeholder="#111827" />
                        </div>
                        <span asp-validation-for="ColorHex" id="pv-color-hex-error" class="pv-field-error"></span>
                    </div>
                </div>

                <div class="pv-field-row">
                    <div class="pv-field" data-pv-field>
                        <label class="pv-label">
                            <span>Tồn kho hiện tại</span>
                        </label>
                        <div class="pv-readonly-value">
                            <strong>@Model.Quantity.ToString("N0")</strong>
                            <span>Cập nhật từ phiếu nhập kho, không nhập thủ công tại biến thể.</span>
                        </div>
                    </div>

                    <div class="pv-field pv-help-field">
                        <label class="pv-label">
                            <span>Gợi ý SKU</span>
                        </label>
                        <div class="pv-help-box">
                            Dùng mã ngắn, duy nhất và dễ đọc. Ví dụ: sản phẩm, dung lượng, màu hoặc size.
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="pv-form-section">
            <div class="pv-form-section-title">
                <span><i data-lucide="list-filter" class="w-4 h-4"></i></span>
                <div>
                    <h3>Thuộc tính biến thể</h3>
                    <p>Chọn giá trị thuộc tính theo cấu hình danh mục của sản phẩm.</p>
                </div>
            </div>

            <div class="pv-form-fields" data-pv-attributes>
                <div class="pv-empty-note" data-pv-attribute-empty>
                    Chọn sản phẩm để hiển thị thuộc tính biến thể.
                </div>

                @foreach (var item in attributeItems)
                {
                    var fieldName = $"Attributes[{item.index}].SelectedOptionId";
                    <div class="pv-field pv-attribute-field"
                         data-pv-field
                         data-pv-attribute-field
                         data-category-id="@item.attribute.CategoryId">
                        <input type="hidden" name="Attributes[@item.index].CategoryId" value="@item.attribute.CategoryId" />
                        <input type="hidden" name="Attributes[@item.index].AttributeId" value="@item.attribute.AttributeId" />

                        <label for="Attributes_@(item.index)__SelectedOptionId" class="pv-label">
                            <span>@item.attribute.AttributeName</span>
                            <strong data-pv-attribute-required-marker hidden>*</strong>
                        </label>
                        <label class="pv-select-control">
                            <select id="Attributes_@(item.index)__SelectedOptionId"
                                    name="@fieldName"
                                    data-pv-attribute-select
                                    data-pv-attribute-name="@item.attribute.AttributeName"
                                    data-pv-error-target="pv-attribute-@(item.index)-error">
                                <option value="">Chọn @item.attribute.AttributeName.ToLowerInvariant()</option>
                                @foreach (var option in item.attribute.Options)
                                {
                                    <option value="@option.Id" selected="@(item.attribute.SelectedOptionId == option.Id ? "selected" : null)">
                                        @option.Label
                                    </option>
                                }
                            </select>
                        </label>
                        @Html.ValidationMessage(fieldName, null, new { id = $"pv-attribute-{item.index}-error", @class = "pv-field-error" })
                    </div>
                }
            </div>
        </section>

        <section class="pv-form-section">
            <div class="pv-form-section-title">
                <span><i data-lucide="images" class="w-4 h-4"></i></span>
                <div>
                    <h3>Ảnh biến thể</h3>
                    <p>Chọn một hoặc nhiều ảnh trong cùng khung quản lý. Ảnh được tải lên Cloudinary và lưu URL vào hệ thống.</p>
                </div>
            </div>

            <div class="pv-image-toolbar pv-image-toolbar-single" data-pv-image-toolbar>
                <div class="pv-field" data-pv-field>
                    <label class="pv-label" for="PvBulkImageFile">
                        <span>Ảnh tải lên</span>
                    </label>
                    <label class="pv-file-drop pv-bulk-file-drop">
                        <input id="PvBulkImageFile"
                               name="BulkImageFiles"
                               type="file"
                               accept="image/jpeg,image/png,image/webp,image/gif,image/svg+xml"
                               multiple
                               data-pv-bulk-file-input />
                        <span class="pv-file-icon"><i data-lucide="upload-cloud" class="w-4 h-4"></i></span>
                        <span data-pv-bulk-file-label>Chọn một hoặc nhiều ảnh</span>
                    </label>
                </div>
            </div>
            <div class="pv-image-list" data-pv-images>
                @foreach (var item in imageItems)
                {
                    var rowClass = item.image.Remove ? "is-removed" : string.Empty;
                    <div class="pv-image-row @rowClass" data-pv-image-row data-existing="@(item.image.Id.HasValue ? "true" : "false")">
                        <input type="hidden" name="Images[@item.index].Id" value="@item.image.Id" data-pv-image-field="Id" />
                        <input type="hidden"
                               name="Images[@item.index].Remove"
                               value="@item.image.Remove.ToString().ToLowerInvariant()"
                               data-pv-image-field="Remove"
                               data-pv-image-remove-value />

                        <div class="pv-image-row-grid">
                            <div class="pv-field pv-image-path-field" data-pv-field>
                                <label class="pv-label" for="Images_@(item.index)__ImageFile">
                                    <span>Ảnh tải lên</span>
                                </label>
                                <input type="hidden" name="Images[@item.index].ImagePath" value="@item.image.ImagePath" data-pv-image-field="ImagePath" />
                                <label class="pv-file-drop">
                                    <input id="Images_@(item.index)__ImageFile"
                                           name="Images[@item.index].ImageFile"
                                           type="file"
                                           accept="image/jpeg,image/png,image/webp,image/gif,image/svg+xml"
                                           data-pv-image-field="ImageFile"
                                           data-pv-file-input
                                           data-pv-error-target="pv-image-@(item.index)-file-error" />
                                    <span class="pv-file-icon"><i data-lucide="upload-cloud" class="w-4 h-4"></i></span>
                                    <span data-pv-file-label>Chọn ảnh từ máy</span>
                                </label>
                                @if (!string.IsNullOrWhiteSpace(item.image.ImagePath))
                                {
                                    <a href="@item.image.ImagePath" class="pv-current-image-link" target="_blank" rel="noopener">
                                        Xem ảnh hiện tại
                                    </a>
                                }
                                @Html.ValidationMessage($"Images[{item.index}].ImageFile", null, new { id = $"pv-image-{item.index}-file-error", @class = "pv-field-error" })
                                @Html.ValidationMessage($"Images[{item.index}].ImagePath", null, new { id = $"pv-image-{item.index}-path-error", @class = "pv-field-error" })
                            </div>

                            <div class="pv-field" data-pv-field>
                                <label class="pv-label" for="Images_@(item.index)__Position">
                                    <span>Thứ tự</span>
                                </label>
                                <input id="Images_@(item.index)__Position"
                                       name="Images[@item.index].Position"
                                       value="@item.image.Position"
                                       type="number"
                                       min="0"
                                       step="1"
                                       class="pv-input"
                                       data-pv-image-field="Position"
                                       data-pv-error-target="pv-image-@(item.index)-position-error"
                                       placeholder="Tự động" />
                                @Html.ValidationMessage($"Images[{item.index}].Position", null, new { id = $"pv-image-{item.index}-position-error", @class = "pv-field-error" })
                            </div>
                        </div>

                        <div class="pv-image-preview @(string.IsNullOrWhiteSpace(item.image.ImagePath) ? "is-empty" : "")" data-pv-image-preview>
                            @if (!string.IsNullOrWhiteSpace(item.image.ImagePath))
                            {
                                <img src="@item.image.ImagePath" alt="@(string.IsNullOrWhiteSpace(item.image.AltText) ? "Ảnh biến thể" : item.image.AltText)" />
                            }
                            else
                            {
                                <span class="pv-preview-icon"><i data-lucide="image-plus" class="w-5 h-5"></i></span>
                                <p>Chưa chọn ảnh</p>
                            }
                        </div>

                        <div class="pv-field" data-pv-field>
                            <label class="pv-label" for="Images_@(item.index)__AltText">
                                <span>Alt text</span>
                            </label>
                            <input id="Images_@(item.index)__AltText"
                                   name="Images[@item.index].AltText"
                                   value="@item.image.AltText"
                                   maxlength="255"
                                   class="pv-input"
                                   data-pv-image-field="AltText"
                                   data-pv-error-target="pv-image-@(item.index)-alt-error"
                                   placeholder="Mô tả ngắn cho ảnh" />
                            @Html.ValidationMessage($"Images[{item.index}].AltText", null, new { id = $"pv-image-{item.index}-alt-error", @class = "pv-field-error" })
                        </div>

                        <button type="button" class="pv-remove-image-btn" data-pv-remove-image>
                            <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                            <span>Xóa ảnh</span>
                        </button>
                    </div>
                }
            </div>

            <div class="pv-image-actions">
                <button type="button" class="pv-add-image-btn" data-pv-add-image>
                    <i data-lucide="plus" class="w-4 h-4"></i>
                    <span>Thêm ảnh</span>
                </button>
            </div>

            <template data-pv-image-template>
                <div class="pv-image-row" data-pv-image-row data-existing="false">
                    <input type="hidden" name="Images[__index__].Id" value="" data-pv-image-field="Id" />
                    <input type="hidden" name="Images[__index__].Remove" value="false" data-pv-image-field="Remove" data-pv-image-remove-value />

                    <div class="pv-image-row-grid">
                        <div class="pv-field pv-image-path-field" data-pv-field>
                            <label class="pv-label" for="Images___index____ImageFile">
                                <span>Ảnh tải lên</span>
                            </label>
                            <input type="hidden" name="Images[__index__].ImagePath" value="" data-pv-image-field="ImagePath" />
                            <label class="pv-file-drop">
                                <input id="Images___index____ImageFile"
                                       name="Images[__index__].ImageFile"
                                       type="file"
                                       accept="image/jpeg,image/png,image/webp,image/gif,image/svg+xml"
                                       data-pv-image-field="ImageFile"
                                       data-pv-file-input
                                       data-pv-error-target="pv-image-__index__-file-error" />
                                <span class="pv-file-icon"><i data-lucide="upload-cloud" class="w-4 h-4"></i></span>
                                <span data-pv-file-label>Chọn ảnh từ máy</span>
                            </label>
                            <span id="pv-image-__index__-file-error" class="pv-field-error"></span>
                            <span id="pv-image-__index__-path-error" class="pv-field-error"></span>
                        </div>

                        <div class="pv-field" data-pv-field>
                            <label class="pv-label" for="Images___index____Position">
                                <span>Thứ tự</span>
                            </label>
                            <input id="Images___index____Position"
                                   name="Images[__index__].Position"
                                   type="number"
                                   min="0"
                                   step="1"
                                   class="pv-input"
                                   data-pv-image-field="Position"
                                   data-pv-error-target="pv-image-__index__-position-error"
                                   placeholder="Tự động" />
                            <span id="pv-image-__index__-position-error" class="pv-field-error"></span>
                        </div>
                    </div>

                    <div class="pv-image-preview is-empty" data-pv-image-preview>
                        <span class="pv-preview-icon"><i data-lucide="image-plus" class="w-5 h-5"></i></span>
                        <p>Chưa chọn ảnh</p>
                    </div>

                    <div class="pv-field" data-pv-field>
                        <label class="pv-label" for="Images___index____AltText">
                            <span>Alt text</span>
                        </label>
                        <input id="Images___index____AltText"
                               name="Images[__index__].AltText"
                               maxlength="255"
                               class="pv-input"
                               data-pv-image-field="AltText"
                               data-pv-error-target="pv-image-__index__-alt-error"
                               placeholder="Mô tả ngắn cho ảnh" />
                        <span id="pv-image-__index__-alt-error" class="pv-field-error"></span>
                    </div>

                    <button type="button" class="pv-remove-image-btn" data-pv-remove-image>
                        <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                        <span>Xóa ảnh</span>
                    </button>
                </div>
            </template>
        </section>

        <section class="pv-form-section pv-status-section">
            <div class="pv-form-section-title">
                <span><i data-lucide="badge-check" class="w-4 h-4"></i></span>
                <div>
                    <h3>Trạng thái bán hàng</h3>
                    <p>Bật để biến thể có thể xuất hiện trong quy trình bán.</p>
                </div>
            </div>

            <div class="pv-status-grid">
                <label class="pv-switch-row">
                    <input asp-for="IsActive" type="checkbox" class="pv-switch-input" />
                    <span class="pv-switch-track"><span class="pv-switch-thumb"></span></span>
                    <span>Cho phép bán</span>
                </label>

                <label class="pv-switch-row">
                    <input asp-for="IsDefault" type="checkbox" class="pv-switch-input" />
                    <span class="pv-switch-track"><span class="pv-switch-thumb"></span></span>
                    <span>Biến thể mặc định</span>
                </label>
            </div>
        </section>
    </div>

    <div class="pv-submit-panel">
        <button type="submit" class="pv-submit-btn">
            <i data-lucide="save" class="w-4 h-4"></i>
            <span>@(isEdit ? "Lưu thay đổi" : "Tạo biến thể")</span>
        </button>

        <a asp-action="Index" class="pv-cancel-btn">
            <i data-lucide="x" class="w-4 h-4"></i>
            <span>Hủy bỏ</span>
        </a>
    </div>
</div>
