@model e_commerce_web_admin.ViewModels.ProductVariants.ProductVariantFormViewModel
@{
    ViewData["Title"] = "Thêm biến thể sản phẩm";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/product-variants.css" asp-append-version="true" />
}

<main class="pv-crud-page">
    <section class="pv-form-hero pv-anim" style="animation-delay:0.04s">
        <div>
            <nav class="pv-breadcrumb">
                <a asp-action="Index">Biến thể sản phẩm</a>
                <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
                <span>Thêm mới</span>
            </nav>
            <h1>Thêm biến thể sản phẩm</h1>
            <p>Tạo SKU bán hàng, chọn thuộc tính theo danh mục và khai báo ảnh riêng cho biến thể.</p>
        </div>
    </section>

    <form asp-action="Create" method="post" enctype="multipart/form-data" class="pv-anim" style="animation-delay:0.08s" novalidate data-pv-form>
        @Html.AntiForgeryToken()
        <partial name="_Form" model="Model" />
    </form>
</main>

@section Scripts {
    <script src="~/js/product-variants.js" asp-append-version="true"></script>
}
