@model e_commerce_web_admin.ViewModels.Suppliers.SupplierFormViewModel
@{
    ViewData["Title"] = "Thêm nhà cung cấp";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/suppliers.css" asp-append-version="true" />
}

<div class="mb-6 supplier-anim" style="animation-delay:0.04s">
    <nav class="flex items-center gap-2 text-xs text-slate-400 mb-2">
        <a asp-action="Index" class="hover:text-teal-600 transition-colors">Nhà cung cấp</a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <span class="text-slate-600 font-medium">Thêm mới</span>
    </nav>
    <h1 class="text-2xl font-bold text-slate-800">Thêm nhà cung cấp</h1>
    <p class="text-slate-500 text-sm mt-0.5">Tạo hồ sơ nhà cung cấp cho quy trình nhập hàng.</p>
</div>

<form asp-action="Create" method="post" class="supplier-anim" style="animation-delay:0.1s" novalidate>
    @Html.AntiForgeryToken()
    <partial name="_Form" model="Model" />
</form>

@section Scripts {
    <script src="~/js/suppliers.js" asp-append-version="true"></script>
}
