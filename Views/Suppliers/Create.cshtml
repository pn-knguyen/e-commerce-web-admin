@model e_commerce_web_admin.ViewModels.Suppliers.SupplierFormViewModel
@{
    ViewData["Title"] = "Thêm nhà cung cấp";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/suppliers.css" asp-append-version="true" />
}

<main class="supplier-crud-page">
    <section class="supplier-form-hero supplier-anim" style="animation-delay:0.04s">
        <div>
            <nav class="supplier-breadcrumb" aria-label="Điều hướng">
                <a asp-action="Index">Nhà cung cấp</a>
                <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
                <span>Thêm mới</span>
            </nav>
            <h1>Thêm nhà cung cấp</h1>
            <p>Tạo hồ sơ đối tác cho quy trình nhập hàng.</p>
        </div>
    </section>

    <form asp-action="Create" method="post" class="supplier-anim" style="animation-delay:0.1s" data-supplier-form novalidate>
        @Html.AntiForgeryToken()
        <partial name="_Form" model="Model" />
    </form>
</main>

@section Scripts {
    <script src="~/js/suppliers.js" asp-append-version="true"></script>
}
