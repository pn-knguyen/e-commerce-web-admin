@model e_commerce_web_admin.ViewModels.Suppliers.SupplierIndexViewModel
@{
    ViewData["Title"] = "Nhà cung cấp";
    Layout = "_Layout";

    var hasFilters = !string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Status);
}

@section Styles {
    <link rel="stylesheet" href="~/css/suppliers.css" asp-append-version="true" />
}

<main class="supplier-page">
    <section class="supplier-hero supplier-anim" style="animation-delay:0.04s">
        <div class="supplier-hero-main">
            <div class="supplier-page-mark">
                <span>Đối tác nhập hàng</span>
            </div>

            <div class="supplier-title-row">
                <div>
                    <h1>Nhà cung cấp</h1>
                    <p>Theo dõi hồ sơ đối tác, trạng thái hợp tác và số phiếu nhập đang gắn với từng nhà cung cấp.</p>
                </div>
                <a asp-action="Create" class="supplier-primary-action">
                    <span>Thêm nhà cung cấp</span>
                    <span class="supplier-action-icon">
                        <i data-lucide="plus" class="w-4 h-4"></i>
                    </span>
                </a>
            </div>
        </div>
    </section>

    @if (TempData["Success"] != null)
    {
        <div id="toastSuccess" class="supplier-flash supplier-flash-success supplier-anim" style="animation-delay:0.06s">
            <span class="supplier-flash-icon">
                <i data-lucide="check" class="w-4 h-4"></i>
            </span>
            <span>@TempData["Success"]</span>
            <button type="button" data-dismiss-target="toastSuccess" aria-label="Đóng thông báo">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div id="toastError" class="supplier-flash supplier-flash-error supplier-anim" style="animation-delay:0.06s">
            <span class="supplier-flash-icon">
                <i data-lucide="alert-circle" class="w-4 h-4"></i>
            </span>
            <span>@TempData["Error"]</span>
            <button type="button" data-dismiss-target="toastError" aria-label="Đóng thông báo">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>
    }

    <div data-supplier-toast-root class="supplier-toast-root" aria-live="polite" aria-atomic="true"></div>

    <section class="supplier-metrics supplier-anim" style="animation-delay:0.08s" aria-label="Thống kê nhà cung cấp">
        <article class="supplier-metric">
            <span class="supplier-metric-icon">
                <i data-lucide="truck" class="w-5 h-5"></i>
            </span>
            <div>
                <p>@Model.TotalCount</p>
                <span>Tổng nhà cung cấp</span>
            </div>
        </article>
        <article class="supplier-metric">
            <span class="supplier-metric-icon supplier-metric-icon-active">
                <i data-lucide="handshake" class="w-5 h-5"></i>
            </span>
            <div>
                <p>@Model.ActiveCount</p>
                <span>Đang hợp tác</span>
            </div>
        </article>
        <article class="supplier-metric">
            <span class="supplier-metric-icon supplier-metric-icon-muted">
                <i data-lucide="pause-circle" class="w-5 h-5"></i>
            </span>
            <div>
                <p>@Model.InactiveCount</p>
                <span>Tạm ngưng</span>
            </div>
        </article>
        <article class="supplier-metric">
            <span class="supplier-metric-icon supplier-metric-icon-receipt">
                <i data-lucide="receipt-text" class="w-5 h-5"></i>
            </span>
            <div>
                <p>@Model.TotalGoodsReceiptCount</p>
                <span>Phiếu nhập</span>
            </div>
        </article>
    </section>

    <section class="supplier-console supplier-anim" style="animation-delay:0.12s">
        <div class="supplier-toolbar">
            <form method="get" asp-action="Index" class="supplier-filter-grid">
                <label class="supplier-search-field">
                    <i data-lucide="search" class="w-4 h-4"></i>
                    <input type="text"
                           name="search"
                           value="@Model.Search"
                           placeholder="Tìm theo tên, số điện thoại, email hoặc địa chỉ..." />
                </label>

                <label class="supplier-select-field">
                    <span>Trạng thái</span>
                    <select name="status">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.Status))">Tất cả</option>
                        <option value="active" selected="@(Model.Status == "active")">Đang hợp tác</option>
                        <option value="inactive" selected="@(Model.Status == "inactive")">Tạm ngưng</option>
                    </select>
                </label>

                <button type="submit" class="supplier-filter-submit">
                    <i data-lucide="sliders-horizontal" class="w-4 h-4"></i>
                    <span>Lọc</span>
                </button>

                @if (hasFilters)
                {
                    <a asp-action="Index" class="supplier-filter-clear">
                        <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
                        <span>Xóa lọc</span>
                    </a>
                }
            </form>
        </div>

        @if (!Model.Suppliers.Any())
        {
            <div class="admin-empty">
                <span class="admin-empty-icon">
                    <i data-lucide="package-search" class="w-9 h-9"></i>
                </span>
                <h2>Không tìm thấy nhà cung cấp</h2>
                @if (hasFilters)
                {
                    <p>Điều chỉnh từ khóa hoặc xóa bộ lọc để xem lại toàn bộ danh sách nhà cung cấp.</p>
                    <a asp-action="Index" class="admin-empty-action">Xóa bộ lọc</a>
                }
                else
                {
                    <p>Danh sách đang trống. Tạo hồ sơ nhà cung cấp đầu tiên để bắt đầu quy trình nhập hàng.</p>
                    <a asp-action="Create" class="admin-empty-action">Thêm nhà cung cấp</a>
                }
            </div>
        }
        else
        {
            <div class="supplier-table-scroll">
                <div class="supplier-index-grid supplier-table-head">
                    <span>Nhà cung cấp</span>
                    <span>Liên hệ</span>
                    <span class="text-center">Phiếu nhập</span>
                    <span class="text-center">Trạng thái</span>
                    <span class="text-right">Thao tác</span>
                </div>

                <div class="supplier-table-body">
                    @{
                        var animIndex = 0;
                    }
                    @foreach (var supplier in Model.Suppliers)
                    {
                        var displayName = string.IsNullOrWhiteSpace(supplier.Name) ? "Nhà cung cấp" : supplier.Name.Trim();
                        var supplierInitial = displayName.Substring(0, 1).ToUpperInvariant();

                        <article class="supplier-row supplier-index-grid supplier-anim"
                                 style="animation-delay:@(0.14 + animIndex++ * 0.025)s"
                                 data-id="@supplier.Id">
                            <div class="supplier-identity">
                                <div class="supplier-avatar" aria-hidden="true">
                                    @supplierInitial
                                </div>
                                <div class="supplier-identity-copy">
                                    <h2>@displayName</h2>
                                    <p>@(string.IsNullOrWhiteSpace(supplier.Address) ? "Chưa có địa chỉ" : supplier.Address)</p>
                                </div>
                            </div>

                            <div class="supplier-contact-stack">
                                <p class="supplier-contact-line">
                                    <i data-lucide="phone" class="w-3.5 h-3.5"></i>
                                    <span>@(string.IsNullOrWhiteSpace(supplier.Phone) ? "Chưa có SĐT" : supplier.Phone)</span>
                                </p>
                                <p class="supplier-contact-line">
                                    <i data-lucide="mail" class="w-3.5 h-3.5"></i>
                                    <span>@(string.IsNullOrWhiteSpace(supplier.Email) ? "Chưa có email" : supplier.Email)</span>
                                </p>
                            </div>

                            <div class="supplier-receipt-cell">
                                <span class="supplier-receipt-pill @(supplier.GoodsReceiptCount > 0 ? "has-receipts" : "")">
                                    <i data-lucide="receipt-text" class="w-3.5 h-3.5"></i>
                                    @supplier.GoodsReceiptCount
                                </span>
                            </div>

                            <div class="supplier-status-cell">
                                <button type="button"
                                        data-supplier-toggle
                                        data-supplier-id="@supplier.Id"
                                        class="supplier-status-btn @(supplier.IsActive ? "is-active" : "is-inactive")"
                                        data-active="@supplier.IsActive.ToString().ToLower()">
                                    <span class="dot"></span>
                                    <span class="status-label">@(supplier.IsActive ? "Hợp tác" : "Tạm ngưng")</span>
                                </button>
                            </div>

                            <div class="supplier-actions index-actions">
                                <a asp-action="Edit" asp-route-id="@supplier.Id" title="Chỉnh sửa" class="supplier-action-btn supplier-action-edit index-action-btn index-action-edit">
                                    <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
                                    <span>Sửa</span>
                                </a>
                                <form asp-action="Delete"
                                      asp-route-id="@supplier.Id"
                                      method="post"
                                      data-supplier-delete
                                      data-supplier-id="@supplier.Id"
                                      data-supplier-name="@supplier.Name">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" title="Xóa" class="supplier-action-btn supplier-action-delete index-action-btn index-action-delete">
                                        <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                                        <span>Xóa</span>
                                    </button>
                                </form>
                            </div>
                        </article>
                    }
                </div>
            </div>

            @if (Model.TotalPages > 1)
            {
                <footer class="supplier-pagination">
                    <p>
                        Trang <strong>@Model.Page</strong> / @Model.TotalPages
                        <span>@Model.TotalCount nhà cung cấp</span>
                    </p>
                    <nav aria-label="Phân trang nhà cung cấp">
                        @if (Model.HasPrev)
                        {
                            <a asp-action="Index"
                               asp-route-page="@(Model.Page - 1)"
                               asp-route-search="@Model.Search"
                               asp-route-status="@Model.Status"
                               class="supplier-page-btn"
                               aria-label="Trang trước">
                                <i data-lucide="chevron-left" class="w-4 h-4"></i>
                            </a>
                        }
                        @for (int p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.TotalPages, Model.Page + 2); p++)
                        {
                            <a asp-action="Index"
                               asp-route-page="@p"
                               asp-route-search="@Model.Search"
                               asp-route-status="@Model.Status"
                               class="supplier-page-btn @(p == Model.Page ? "is-current" : "")"
                               aria-current="@(p == Model.Page ? "page" : null)">
                                @p
                            </a>
                        }
                        @if (Model.HasNext)
                        {
                            <a asp-action="Index"
                               asp-route-page="@(Model.Page + 1)"
                               asp-route-search="@Model.Search"
                               asp-route-status="@Model.Status"
                               class="supplier-page-btn"
                               aria-label="Trang sau">
                                <i data-lucide="chevron-right" class="w-4 h-4"></i>
                            </a>
                        }
                    </nav>
                </footer>
            }
        }
    </section>
</main>

@section Scripts {
    <script src="~/js/suppliers.js" asp-append-version="true"></script>
}
