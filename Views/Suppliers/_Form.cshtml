@model e_commerce_web_admin.ViewModels.Suppliers.SupplierFormViewModel
@{
    var isEdit = Model.Id > 0;
}

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-5">
        <div class="bg-white rounded-2xl border border-slate-200 p-5">
            <h3 class="text-sm font-semibold text-slate-700 mb-4">Thông tin nhà cung cấp</h3>

            <div class="space-y-4">
                <div>
                    <label asp-for="Name" class="block text-xs font-semibold text-slate-600 mb-1.5">
                        Tên nhà cung cấp <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="Name" class="w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-800
                    focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition"
                           data-supplier-required="Tên nhà cung cấp là bắt buộc."
                           data-supplier-error-target="supplier-name-error"
                           placeholder="Ví dụ: Công ty TNHH An Phát" />
                    <span asp-validation-for="Name" id="supplier-name-error" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="Phone" class="block text-xs font-semibold text-slate-600 mb-1.5">
                            Số điện thoại <span class="text-red-500">*</span>
                        </label>
                        <input asp-for="Phone" type="tel" class="w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-800
                        focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition"
                               inputmode="numeric" maxlength="10" data-supplier-phone
                               data-supplier-error-target="supplier-phone-error"
                               placeholder="Ví dụ: 0901234567" />
                            <span asp-validation-for="Phone" id="supplier-phone-error" class="text-xs text-red-500 mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="Email" class="block text-xs font-semibold text-slate-600 mb-1.5">Email</label>
                            <input asp-for="Email" type="email" class="w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-800
                            focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition"
                                   placeholder="supplier@example.com" />
                            <span asp-validation-for="Email" class="text-xs text-red-500 mt-1 block"></span>
                        </div>
                    </div>

                    <div>
                        <label asp-for="Address" class="block text-xs font-semibold text-slate-600 mb-1.5">
                            Địa chỉ <span class="text-red-500">*</span>
                        </label>
                        <textarea asp-for="Address" rows="5" class="w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-800
                        focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition resize-y"
                                  data-supplier-required="Địa chỉ là bắt buộc."
                                  data-supplier-error-target="supplier-address-error"
                                  placeholder="Địa chỉ văn phòng, kho hoặc điểm giao nhận..."></textarea>
                        <span asp-validation-for="Address" id="supplier-address-error" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="space-y-5">
            <div class="bg-white rounded-2xl border border-slate-200 p-5">
                <h3 class="text-sm font-semibold text-slate-700 mb-4">Trạng thái</h3>

                <label class="flex items-center gap-3 cursor-pointer group">
                    <div class="relative">
                        <input asp-for="IsActive" type="checkbox" class="sr-only peer" />
                        <div class="w-10 h-6 bg-slate-200 rounded-full peer-checked:bg-teal-500 transition-colors"></div>
                        <div
                            class="absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow transition-transform peer-checked:translate-x-4">
                        </div>
                    </div>
                    <span class="text-sm text-slate-700 group-hover:text-slate-900">Đang hợp tác</span>
                </label>
            </div>

            <div class="bg-white rounded-2xl border border-slate-200 p-5 space-y-3">
                <button type="submit" class="w-full flex items-center justify-center gap-2
                    bg-gradient-to-r from-teal-500 to-teal-600 hover:from-teal-600 hover:to-teal-700
                    text-white text-sm font-semibold px-4 py-2.5 rounded-xl transition-all shadow-sm hover:shadow-md">
                    <i data-lucide="save" class="w-4 h-4"></i>
                    @(isEdit ? "Lưu thay đổi" : "Tạo nhà cung cấp")
                </button>
                <a asp-action="Index" class="w-full flex items-center justify-center gap-2 border border-slate-200 hover:bg-slate-50
                    text-slate-700 text-sm font-medium px-4 py-2.5 rounded-xl transition-colors">
                    Hủy bỏ
                </a>
            </div>

            <div data-supplier-form-alert class="@(ViewData.ModelState.IsValid ? "hidden " : "")bg-red-50 border border-red-200 rounded-2xl p-4">
                <div class="flex items-center gap-2 mb-1">
                    <i data-lucide="alert-triangle" class="w-4 h-4 text-red-500"></i>
                    <p class="text-sm font-semibold text-red-700">Vui lòng kiểm tra lại</p>
                </div>
                <p class="text-xs text-red-600">Hãy nhập đầy đủ và đúng định dạng các trường bắt buộc.</p>
                <div asp-validation-summary="ModelOnly" class="text-xs text-red-600 space-y-1 mt-2"></div>
            </div>
        </div>
    </div>
