@model e_commerce_web_admin.ViewModels.Suppliers.SupplierFormViewModel
@{
    var isEdit = Model.Id > 0;
}

<input type="hidden" asp-for="Id" />

<div class="supplier-form-grid">
    <section class="supplier-form-card supplier-form-main">
        <div class="supplier-form-card-head">
            <span class="supplier-form-head-icon">
                <i data-lucide="building-2" class="w-5 h-5"></i>
            </span>
            <div>
                <h2>Thông tin nhà cung cấp</h2>
                <p>Thông tin dùng cho hồ sơ nhập hàng và liên hệ vận hành.</p>
            </div>
        </div>

        <div data-supplier-form-alert
             class="supplier-form-alert @(ViewData.ModelState.IsValid ? "hidden" : "")">
            <i data-lucide="alert-triangle" class="w-4 h-4"></i>
            <div>
                <p>Vui lòng kiểm tra lại thông tin.</p>
                <div asp-validation-summary="ModelOnly"></div>
            </div>
        </div>

        <div class="supplier-form-fields">
            <div class="supplier-field" data-supplier-field>
                <label asp-for="Name" class="supplier-label">
                    <span>Tên nhà cung cấp</span>
                    <strong>*</strong>
                </label>
                <input asp-for="Name"
                       class="supplier-input"
                       data-supplier-required="Tên nhà cung cấp là bắt buộc."
                       data-supplier-error-target="supplier-name-error"
                       placeholder="Ví dụ: Công ty TNHH An Phát" />
                <span asp-validation-for="Name" id="supplier-name-error" class="supplier-field-error"></span>
            </div>

            <div class="supplier-field-row">
                <div class="supplier-field" data-supplier-field>
                    <label asp-for="Phone" class="supplier-label">
                        <span>Số điện thoại</span>
                        <strong>*</strong>
                    </label>
                    <input asp-for="Phone"
                           type="tel"
                           class="supplier-input"
                           inputmode="numeric"
                           maxlength="10"
                           data-supplier-phone
                           data-supplier-error-target="supplier-phone-error"
                           placeholder="Ví dụ: 0901234567" />
                    <span asp-validation-for="Phone" id="supplier-phone-error" class="supplier-field-error"></span>
                </div>

                <div class="supplier-field" data-supplier-field>
                    <label asp-for="Email" class="supplier-label">
                        <span>Email</span>
                    </label>
                    <input asp-for="Email"
                           type="email"
                           class="supplier-input"
                           placeholder="supplier@example.com" />
                    <span asp-validation-for="Email" class="supplier-field-error"></span>
                </div>
            </div>

            <div class="supplier-field" data-supplier-field>
                <label asp-for="Address" class="supplier-label">
                    <span>Địa chỉ</span>
                    <strong>*</strong>
                </label>
                <textarea asp-for="Address"
                          rows="4"
                          class="supplier-input supplier-textarea"
                          data-supplier-required="Địa chỉ là bắt buộc."
                          data-supplier-error-target="supplier-address-error"
                          placeholder="Địa chỉ văn phòng, kho hoặc điểm giao nhận..."></textarea>
                <span asp-validation-for="Address" id="supplier-address-error" class="supplier-field-error"></span>
            </div>
        </div>
    </section>

    <aside class="supplier-form-side">
        <section class="supplier-form-card supplier-status-panel">
            <div class="supplier-form-card-head compact">
                <span class="supplier-form-head-icon">
                    <i data-lucide="badge-check" class="w-5 h-5"></i>
                </span>
                <div>
                    <h2>Trạng thái hợp tác</h2>
                    <p>Bật để nhà cung cấp xuất hiện trong quy trình nhập hàng.</p>
                </div>
            </div>

            <label class="supplier-switch-row">
                <input asp-for="IsActive" type="checkbox" class="supplier-switch-input" />
                <span class="supplier-switch-track">
                    <span class="supplier-switch-thumb"></span>
                </span>
                <span>Cho phép sử dụng</span>
            </label>
        </section>

        <section class="supplier-form-card supplier-submit-panel">
            <button type="submit" class="supplier-submit-btn">
                <i data-lucide="save" class="w-4 h-4"></i>
                <span>@(isEdit ? "Lưu thay đổi" : "Tạo nhà cung cấp")</span>
            </button>

            <a asp-action="Index" class="supplier-cancel-btn">
                <i data-lucide="x" class="w-4 h-4"></i>
                <span>Hủy bỏ</span>
            </a>
        </section>
    </aside>
</div>
