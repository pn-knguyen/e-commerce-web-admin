@model e_commerce_web_admin.ViewModels.Products.ProductFormViewModel
@{
    ViewData["Title"] = "Thêm sản phẩm";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/products.css" asp-append-version="true" />
}

<div class="surface-form-hero product-anim surface-anim" style="animation-delay:0.04s">
    <nav class="flex items-center gap-2 text-xs text-slate-400 mb-2">
        <a asp-action="Index" class="hover:text-teal-600 transition-colors">Sản phẩm</a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <span class="text-slate-600 font-medium">Thêm mới</span>
    </nav>
    <h1 class="text-2xl font-bold text-slate-800">Thêm sản phẩm mới</h1>
    <p class="text-slate-500 text-sm mt-0.5">Tạo thông tin sản phẩm chính trước khi thêm biến thể, ảnh và thông số.</p>
</div>

<form asp-action="Create" method="post" class="product-anim surface-anim" style="animation-delay:0.1s">
    @Html.AntiForgeryToken()
    <partial name="_Form" model="Model" />
</form>

@section Scripts {
    <script src="~/js/products.js" asp-append-version="true"></script>
}
