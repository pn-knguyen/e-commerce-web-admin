@model e_commerce_web_admin.ViewModels.Products.ProductFormViewModel
@{
    bool isEdit = Model.Id > 0;
}

<div class="surface-form-grid grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="surface-form-main lg:col-span-2 space-y-5">
        <div class="surface-form-card bg-white rounded-2xl border border-slate-200 p-5">
            <h3 class="text-sm font-semibold text-slate-700 mb-4">Thông tin cơ bản</h3>

            <div data-surface-form-alert
                 class="surface-form-alert @(ViewData.ModelState.IsValid ? "hidden" : "")">
                <i data-lucide="alert-triangle" class="w-4 h-4"></i>
                <div>
                    <p>Vui lòng kiểm tra lại thông tin.</p>
                    <div asp-validation-summary="ModelOnly"></div>
                </div>
            </div>

            <div class="space-y-4">
                <div>
                    <label asp-for="Name" class="block text-xs font-semibold text-slate-600 mb-1.5">
                        Tên sản phẩm <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="Name" id="productName" class="w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-800
                    focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition"
                           placeholder="Ví dụ: iPhone 15 Pro Max" />
                    <span asp-validation-for="Name" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="Slug" class="block text-xs font-semibold text-slate-600 mb-1.5">
                        Slug
                        <span class="font-normal text-slate-400 ml-1">(tự động tạo từ tên nếu để trống)</span>
                    </label>
                    <div class="relative">
                        <span
                        class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs select-none">/products/</span>
                        <input asp-for="Slug" id="productSlug" class="w-full border border-slate-200 rounded-xl pl-[5.75rem] pr-3.5 py-2.5 text-sm text-slate-800 font-mono
                        focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition"
                               placeholder="iphone-15-pro-max" />
                    </div>
                    <span asp-validation-for="Slug" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="BrandId" class="block text-xs font-semibold text-slate-600 mb-1.5">
                            Thương hiệu <span class="text-red-500">*</span>
                        </label>
                        <select asp-for="BrandId" id="productBrandId" class="w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-800 bg-white
                            focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition">
                            <option value="" selected="@(!Model.BrandId.HasValue)">-- Chọn thương hiệu --</option>
                            @foreach (var brand in Model.BrandOptions)
                            {
                                <option value="@brand.Id" selected="@(Model.BrandId == brand.Id)">
                                    @brand.Label@(brand.IsActive ? string.Empty : " (đang tắt)")
                                </option>
                            }
                        </select>
                        <span asp-validation-for="BrandId" class="text-xs text-red-500 mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="CategoryId" class="block text-xs font-semibold text-slate-600 mb-1.5">
                            Danh mục <span class="text-red-500">*</span>
                        </label>
                        <select asp-for="CategoryId" id="productCategoryId" class="w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-800 bg-white
                            focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition">
                            <option value="" selected="@(!Model.CategoryId.HasValue)">-- Chọn danh mục --</option>
                            @foreach (var category in Model.CategoryOptions)
                            {
                                <option value="@category.Id" selected="@(Model.CategoryId == category.Id)"
                                        disabled="@category.HasChildren"
                                        data-has-children="@category.HasChildren.ToString().ToLower()">
                                    @category.Label@(category.HasChildren ? " (danh mục cha)" :
                                    string.Empty)@(category.IsActive ? string.Empty : " (đang tắt)")
                                </option>
                            }
                        </select>
                        <p class="mt-1 text-[11px] text-slate-400">
                            Danh mục cha chỉ dùng để nhóm; hãy chọn danh mục con cuối cùng cho sản phẩm.
                        </p>
                        <span asp-validation-for="CategoryId" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                </div>

                <div>
                    <label asp-for="Description" class="block text-xs font-semibold text-slate-600 mb-1.5">Mô tả</label>
                    <textarea asp-for="Description" rows="7" class="w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-800
                    focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition resize-y"
                              placeholder="Mô tả sản phẩm..."></textarea>
                    <span asp-validation-for="Description" class="text-xs text-red-500 mt-1 block"></span>
                </div>
            </div>
        </div>

        <div class="surface-form-card product-spec-card bg-white rounded-2xl border border-slate-200 p-5"
             data-product-spec-section>
            <h3 class="text-sm font-semibold text-slate-700 mb-4">Thông số kỹ thuật</h3>

            <div class="product-spec-empty" data-product-spec-empty>
                Chọn danh mục sản phẩm để nhập thông số kỹ thuật.
            </div>

            @{
                var specItems = Model.Specifications
                    .Select((spec, index) => new { spec, index })
                    .GroupBy(item => new
                    {
                        item.spec.CategoryId,
                        GroupName = string.IsNullOrWhiteSpace(item.spec.GroupName)
                            ? "Thông số khác"
                            : item.spec.GroupName
                    })
                    .OrderBy(group => group.Key.CategoryId)
                    .ThenBy(group => group.Min(item => item.spec.SortOrder));
            }

            <div class="space-y-4">
                @foreach (var group in specItems)
                {
                    <section class="product-spec-group"
                             data-product-spec-group
                             data-category-id="@group.Key.CategoryId">
                        <h4>@group.Key.GroupName</h4>

                        <div class="product-spec-grid">
                            @foreach (var item in group.OrderBy(row => row.spec.SortOrder).ThenBy(row => row.spec.Name))
                            {
                                var fieldName = $"Specifications[{item.index}].Value";
                                var isRequired = item.spec.IsRequired.ToString().ToLowerInvariant();

                                <div class="product-spec-field"
                                     data-product-spec-row
                                     data-category-id="@item.spec.CategoryId">
                                    <input type="hidden" name="Specifications[@item.index].CategoryId" value="@item.spec.CategoryId" />
                                    <input type="hidden" name="Specifications[@item.index].SpecificationId" value="@item.spec.SpecificationId" />

                                    <label for="Specifications_@(item.index)__Value">
                                        @item.spec.Name
                                        @if (item.spec.IsRequired)
                                        {
                                            <span class="text-red-500">*</span>
                                        }
                                    </label>

                                    <div class="product-spec-input-wrap">
                                        <input id="Specifications_@(item.index)__Value"
                                               name="@fieldName"
                                               value="@item.spec.Value"
                                               maxlength="1000"
                                               data-product-spec-value
                                               data-product-spec-required="@isRequired"
                                               data-required-message="Vui lòng nhập @item.spec.Name."
                                               class="w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-800 @(string.IsNullOrWhiteSpace(item.spec.Unit) ? string.Empty : "product-spec-input-has-unit")
                                               focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition"
                                               placeholder="Nhập @item.spec.Name.ToLowerInvariant()" />

                                        @if (!string.IsNullOrWhiteSpace(item.spec.Unit))
                                        {
                                            <span>@item.spec.Unit</span>
                                        }
                                    </div>

                                    @Html.ValidationMessage(
                                        fieldName,
                                        null,
                                        new { @class = "text-xs text-red-500 mt-1 block" })

                                    <label class="product-highlight-check">
                                        <input type="checkbox"
                                               name="Specifications[@item.index].IsHighlight"
                                               value="true"
                                               checked="@item.spec.IsHighlight" />
                                        <span>Hiển thị nổi bật</span>
                                    </label>
                                </div>
                            }
                        </div>
                    </section>
                }
            </div>
        </div>
    </div>

    <div class="space-y-5">
        <div class="surface-form-card bg-white rounded-2xl border border-slate-200 p-5">
            <h3 class="text-sm font-semibold text-slate-700 mb-4">Trạng thái</h3>

            <div class="space-y-4">
                <label class="flex items-center gap-3 cursor-pointer group">
                    <div class="relative">
                        <input asp-for="IsActive" type="checkbox" id="isActiveToggle" class="sr-only peer" />
                        <div class="w-10 h-6 bg-slate-200 rounded-full peer-checked:bg-teal-500 transition-colors">
                        </div>
                        <div
                            class="absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow transition-transform peer-checked:translate-x-4">
                        </div>
                    </div>
                    <span class="text-sm text-slate-700 group-hover:text-slate-900">Hiển thị sản phẩm</span>
                </label>

                <label class="flex items-center gap-3 cursor-pointer group">
                    <div class="relative">
                        <input asp-for="IsFeatured" type="checkbox" id="isFeaturedToggle" class="sr-only peer" />
                        <div class="w-10 h-6 bg-slate-200 rounded-full peer-checked:bg-amber-400 transition-colors">
                        </div>
                        <div
                            class="absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow transition-transform peer-checked:translate-x-4">
                        </div>
                    </div>
                    <span class="text-sm text-slate-700 group-hover:text-slate-900">Sản phẩm nổi bật</span>
                </label>
            </div>
        </div>

        <div class="surface-form-card surface-submit-card bg-white rounded-2xl border border-slate-200 p-5 space-y-3">
            <button type="submit" class="w-full flex items-center justify-center gap-2
                bg-gradient-to-r from-teal-500 to-teal-600 hover:from-teal-600 hover:to-teal-700
                text-white text-sm font-semibold px-4 py-2.5 rounded-xl transition-all shadow-sm hover:shadow-md">
                <i data-lucide="save" class="w-4 h-4"></i>
                @(isEdit ? "Lưu thay đổi" : "Tạo sản phẩm")
            </button>
            <a asp-action="Index" class="surface-cancel-link w-full flex items-center justify-center gap-2 border border-slate-200 hover:bg-slate-50
                text-slate-700 text-sm font-medium px-4 py-2.5 rounded-xl transition-colors">
                Huỷ bỏ
            </a>
        </div>
    </div>
</div>
