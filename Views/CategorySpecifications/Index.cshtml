@model e_commerce_web_admin.ViewModels.CategorySpecifications.CategorySpecIndexViewModel
@{
    ViewData["Title"] = $"Thông số - {Model.CategoryName}";
    Layout = "_Layout";

    var hasFilters = !string.IsNullOrEmpty(Model.Search);
    var assignedGroups = Model.AssignedSpecs
        .GroupBy(row => string.IsNullOrWhiteSpace(row.GroupName) ? "Chưa có nhóm" : row.GroupName!.Trim())
        .OrderBy(group => group.Min(row => row.SortOrder))
        .ThenBy(group => group.Key)
        .ToList();
    var groupNames = Model.AssignedSpecs
        .Where(row => !string.IsNullOrWhiteSpace(row.GroupName))
        .Select(row => row.GroupName!.Trim())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(name => name)
        .ToList();
    var assignItems = Model.AssignForm.Items;
}

@section Styles {
    <link rel="stylesheet" href="~/css/specifications.css" asp-append-version="true" />
}

@Html.AntiForgeryToken()

<main class="surface-page category-spec-page">
    <div class="surface-form-hero category-spec-hero spec-anim surface-anim" style="animation-delay:0.04s">
        <nav class="category-spec-breadcrumb flex items-center gap-2 text-xs text-slate-400 mb-2">
            <a asp-controller="Categories" asp-action="Index" class="hover:text-teal-600 transition-colors">Danh mục</a>
            <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
            <a asp-controller="Specifications" asp-action="Index" class="hover:text-teal-600 transition-colors">Thông số</a>
            <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
            <span class="text-slate-600 font-medium">@Model.CategoryName</span>
        </nav>
        <div class="category-spec-hero-row flex items-center justify-between gap-4">
            <div class="min-w-0">
                <h1 class="text-2xl font-bold text-slate-800 truncate">
                    Thông số kỹ thuật - <span class="text-teal-600">@Model.CategoryName</span>
                </h1>
                <p class="text-slate-500 text-sm">
                    <span class="font-mono text-slate-400 text-xs">/categories/@Model.CategorySlug</span>
                    &nbsp;·&nbsp;
                    @Model.TotalAssigned thông số đã gán
                </p>
            </div>

            <a asp-controller="Categories" asp-action="Index" class="category-spec-back-link inline-flex items-center gap-2 text-sm font-medium flex-shrink-0 text-slate-600 bg-white hover:bg-slate-50 hover:text-slate-800 border border-slate-200 hover:border-slate-300 px-4 py-2 rounded-xl transition-all shadow-sm">
                <i data-lucide="arrow-left" class="w-4 h-4"></i>
                Quay lại Danh mục
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div id="toastSuccess"
             class="mb-4 flex items-center gap-3 bg-emerald-50 border border-emerald-200 text-emerald-700 rounded-xl px-4 py-3 text-sm shadow-sm spec-anim"
             style="animation-delay:0.04s">
            <div class="w-7 h-7 rounded-full bg-emerald-100 flex items-center justify-center flex-shrink-0">
                <i data-lucide="check" class="w-4 h-4 text-emerald-600"></i>
            </div>
            <span class="flex-1">@TempData["Success"]</span>
            <button type="button" data-dismiss-target="toastSuccess" class="text-emerald-400 hover:text-emerald-600 transition-colors">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div id="toastError"
             class="mb-4 flex items-center gap-3 bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3 text-sm shadow-sm spec-anim"
             style="animation-delay:0.04s">
            <div class="w-7 h-7 rounded-full bg-red-100 flex items-center justify-center flex-shrink-0">
                <i data-lucide="alert-circle" class="w-4 h-4 text-red-500"></i>
            </div>
            <span class="flex-1">@TempData["Error"]</span>
            <button type="button" data-dismiss-target="toastError" class="text-red-400 hover:text-red-600 transition-colors">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>
    }

    <section class="surface-console surface-table-card spec-anim surface-anim" style="animation-delay:0.08s">
        <div class="spec-toolbar">
            <form method="get" asp-action="Index" class="spec-filter-grid">
                <input type="hidden" name="categoryId" value="@Model.CategoryId" />
                <label class="spec-search-field">
                    <i data-lucide="search" class="w-4 h-4"></i>
                    <input type="text"
                           name="search"
                           value="@Model.Search"
                           placeholder="Tìm thông số, key hoặc tên nhóm đã gán..." />
                </label>
                <button type="submit" class="spec-filter-submit">
                    <i data-lucide="sliders-horizontal" class="w-4 h-4"></i>
                    <span>Lọc</span>
                </button>
                @if (hasFilters)
                {
                    <a asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="spec-filter-clear">
                        <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
                        <span>Xoá lọc</span>
                    </a>
                }
            </form>
        </div>

        @if (!Model.AssignedSpecs.Any())
        {
            <div class="admin-empty">
                <span class="admin-empty-icon">
                    <i data-lucide="list-x" class="w-9 h-9"></i>
                </span>
                <h2>Không tìm thấy thông số</h2>
                @if (hasFilters)
                {
                    <p>Điều chỉnh từ khóa hoặc xóa bộ lọc để xem lại các thông số đã gán cho danh mục này.</p>
                    <a asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="admin-empty-action">Xóa bộ lọc</a>
                }
                else
                {
                    <p>Danh mục này chưa có thông số nào được gán. Dùng form bên dưới để chọn nhiều thông số và gán cùng lúc.</p>
                }
            </div>
        }
        else
        {
            <div class="category-spec-groups">
                @foreach (var group in assignedGroups)
                {
                    <section class="category-spec-group-card">
                        <div class="category-spec-group-head">
                            <div class="min-w-0">
                                <h2>@group.Key</h2>
                                <p>
                                    Gồm @group.Count() thông số:
                                    @string.Join(", ", group.Select(row => row.Name))
                                </p>
                            </div>
                            <span>@group.Count()</span>
                        </div>

                        <div class="surface-table-scroll spec-table-scroll category-spec-table-scroll">
                            <div class="surface-table-head category-spec-table-head category-spec-grid px-5 py-3">
                                <span>Key</span>
                                <span>Tên thông số</span>
                                <span class="text-center">Thứ tự</span>
                                <span class="text-center">Bắt buộc</span>
                                <span class="text-center">Sản phẩm</span>
                                <span class="text-right">Thao tác</span>
                            </div>

                            <div class="category-spec-list divide-y divide-slate-50">
                                @foreach (var row in group.OrderBy(row => row.SortOrder).ThenBy(row => row.Name))
                                {
                                    <article class="surface-row spec-row category-spec-row category-spec-grid px-5 py-3"
                                         data-spec-row
                                         data-category-id="@Model.CategoryId"
                                         data-spec-id="@row.SpecificationId">
                                        <div class="category-spec-key-cell min-w-0">
                                            <span class="category-spec-card-label">Key</span>
                                            <span class="spec-key-badge">@row.Key</span>
                                        </div>

                                        <div class="category-spec-name-cell">
                                            <span class="category-spec-card-label">Tên thông số</span>
                                            <p>@row.Name</p>
                                            @if (!string.IsNullOrWhiteSpace(row.Unit))
                                            {
                                                <span class="spec-unit-badge">@row.Unit</span>
                                            }
                                            <input data-field="groupName"
                                                   type="hidden"
                                                   value="@(row.GroupName ?? "")" />
                                        </div>

                                        <div class="category-spec-order-cell">
                                            <span class="category-spec-card-label">Thứ tự</span>
                                            <input data-field="sortOrder"
                                                   type="number"
                                                   min="0"
                                                   max="9999"
                                                   value="@row.SortOrder"
                                                   class="inline-edit category-spec-order-input" />
                                        </div>

                                        <div class="category-spec-required-status-cell flex justify-center">
                                            <span class="category-spec-card-label">Bắt buộc</span>
                                            <button type="button"
                                                    data-field="isRequired"
                                                    class="req-toggle @(row.IsRequired ? "active" : "")"
                                                    title="@(row.IsRequired ? "Bắt buộc" : "Không bắt buộc")">
                                            </button>
                                        </div>

                                        <div class="category-spec-usage-cell text-center">
                                            <span class="category-spec-card-label">Sản phẩm</span>
                                            <span class="inline-flex items-center justify-center gap-1 text-xs font-semibold rounded-full px-2 py-0.5 @(row.ProductUsageCount > 0 ? "bg-blue-100 text-blue-700" : "bg-slate-100 text-slate-400")">
                                                <i data-lucide="package" class="w-3 h-3"></i>
                                                @row.ProductUsageCount
                                            </span>
                                        </div>

                                        <div class="category-spec-actions-cell index-actions">
                                            <span class="category-spec-card-label">Thao tác</span>
                                            <form asp-action="Remove" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="categoryId" value="@Model.CategoryId" />
                                                <input type="hidden" name="specId" value="@row.SpecificationId" />
                                                <button type="submit"
                                                        title="Bỏ gán"
                                                        onclick="return confirm('Bỏ gán thông số này khỏi danh mục?')"
                                                        class="index-action-btn index-action-delete">
                                                    <i data-lucide="link-2-off" class="w-3.5 h-3.5"></i>
                                                    <span>Bỏ gán</span>
                                                </button>
                                            </form>
                                        </div>
                                    </article>
                                }
                            </div>
                        </div>
                    </section>
                }
            </div>

            @if (Model.TotalPages > 1)
            {
                <div class="surface-pagination px-5 py-3 flex items-center justify-between">
                    <p class="text-xs text-slate-400">
                        Trang <span class="font-semibold text-slate-600">@Model.Page</span> / @Model.TotalPages
                    </p>
                    <div class="flex items-center gap-1">
                        @if (Model.HasPrev)
                        {
                            <a asp-action="Index" asp-route-categoryId="@Model.CategoryId" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search" class="w-7 h-7 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 flex items-center justify-center text-slate-600 transition-colors">
                                <i data-lucide="chevron-left" class="w-3.5 h-3.5"></i>
                            </a>
                        }
                        @for (int p = Math.Max(1, Model.Page - 1); p <= Math.Min(Model.TotalPages, Model.Page + 1); p++)
                        {
                            <a asp-action="Index" asp-route-categoryId="@Model.CategoryId" asp-route-page="@p" asp-route-search="@Model.Search" class="w-7 h-7 rounded-lg text-xs font-semibold flex items-center justify-center transition-all @(p == Model.Page ? "bg-teal-500 text-white" : "border border-slate-200 bg-white text-slate-600 hover:bg-slate-50")">
                                @p
                            </a>
                        }
                        @if (Model.HasNext)
                        {
                            <a asp-action="Index" asp-route-categoryId="@Model.CategoryId" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search" class="w-7 h-7 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 flex items-center justify-center text-slate-600 transition-colors">
                                <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
                            </a>
                        }
                    </div>
                </div>
            }
        }
    </section>

    <section class="surface-form-card category-spec-assign-card spec-anim surface-anim" style="animation-delay:0.12s">
        <h3 class="text-sm font-semibold text-slate-700 flex items-center gap-2">
            <i data-lucide="plus-circle" class="w-4 h-4 text-teal-600"></i>
            Gán thông số vào danh mục
        </h3>

        <div data-surface-form-alert class="surface-form-alert hidden">
            <i data-lucide="alert-triangle" class="w-4 h-4"></i>
            <div>
                <p data-category-spec-alert-text>Vui lòng kiểm tra lại thông tin.</p>
            </div>
        </div>

        @if (Model.AvailableSpecs.Any())
        {
            <form asp-action="Assign" method="post" class="category-spec-assign-form" data-category-spec-assign-form>
                @Html.AntiForgeryToken()
                <input type="hidden" name="CategoryId" value="@Model.CategoryId" />

                <div class="category-spec-assign-toolbar">
                    <label class="category-spec-assign-search">
                        <i data-lucide="search" class="w-4 h-4"></i>
                        <input id="categorySpecAssignSearch" type="text" placeholder="Tìm nhanh thông số chưa gán..." />
                    </label>
                    <span class="category-spec-selected-pill" data-category-spec-selected-count>0 đã chọn</span>
                </div>

                @if (groupNames.Any())
                {
                    <div class="category-spec-group-hints">
                        <span>Nhóm hiện có:</span>
                        @foreach (var groupName in groupNames)
                        {
                            <button type="button" data-category-spec-group-chip="@groupName">@groupName</button>
                        }
                    </div>
                    <datalist id="categorySpecGroupNames">
                        @foreach (var groupName in groupNames)
                        {
                            <option value="@groupName"></option>
                        }
                    </datalist>
                }

                <div class="category-spec-assign-list">
                    <div class="category-spec-assign-head">
                        <span>Thông số</span>
                        <span>Tên nhóm</span>
                        <span>Thứ tự</span>
                        <span>Bắt buộc</span>
                    </div>

                    @for (var i = 0; i < Model.AvailableSpecs.Count; i++)
                    {
                        var spec = Model.AvailableSpecs[i];
                        var draft = assignItems.FirstOrDefault(item => item.SpecificationId == spec.Id) ?? new e_commerce_web_admin.ViewModels.CategorySpecifications.CategorySpecAssignItemViewModel
                        {
                            SpecificationId = spec.Id,
                            SortOrder = i + 1,
                        };

                        <div class="category-spec-assign-row"
                             data-category-spec-assign-row
                             data-name="@spec.Name"
                             data-key="@spec.Key">
                            <div class="category-spec-pick-cell">
                                <input type="hidden" name="Items[@i].SpecificationId" value="@spec.Id" />
                                <label class="category-spec-check">
                                    <input type="checkbox"
                                           name="Items[@i].Selected"
                                           value="true"
                                           data-category-spec-select />
                                    <input type="hidden" name="Items[@i].Selected" value="false" />
                                    <span></span>
                                </label>
                                <div class="min-w-0">
                                    <p>@spec.Name</p>
                                    <div>
                                        <span class="spec-key-badge">@spec.Key</span>
                                        @if (!string.IsNullOrWhiteSpace(spec.Unit))
                                        {
                                            <span class="spec-unit-badge">@spec.Unit</span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="category-spec-group-cell">
                                <label class="category-spec-mobile-label">Tên nhóm</label>
                                <input type="text"
                                       name="Items[@i].GroupName"
                                       value="@draft.GroupName"
                                       maxlength="120"
                                       list="categorySpecGroupNames"
                                       placeholder="Ví dụ: Màn hình"
                                       class="category-spec-assign-input"
                                       data-category-spec-group />
                            </div>

                            <div class="category-spec-sort-cell">
                                <label class="category-spec-mobile-label">Thứ tự</label>
                                <input type="number"
                                       name="Items[@i].SortOrder"
                                       value="@draft.SortOrder"
                                       min="0"
                                       max="9999"
                                       class="category-spec-assign-input category-spec-assign-order"
                                       data-category-spec-order />
                            </div>

                            <div class="category-spec-required-cell">
                                <label class="category-spec-mobile-label">Bắt buộc</label>
                                <label class="category-spec-switch" aria-label="Bắt buộc">
                                    <input type="checkbox"
                                           name="Items[@i].IsRequired"
                                           value="true"
                                           data-category-spec-required />
                                    <input type="hidden" name="Items[@i].IsRequired" value="false" />
                                    <span class="category-spec-switch-track" aria-hidden="true">
                                        <span class="category-spec-switch-thumb"></span>
                                    </span>
                                </label>
                            </div>
                        </div>
                    }
                </div>

                <div class="category-spec-assign-actions">
                    <button type="submit" class="category-spec-assign-submit">
                        <i data-lucide="link" class="w-4 h-4"></i>
                        <span>Gán thông số đã chọn</span>
                    </button>
                </div>
            </form>
        }
        else
        {
            <div class="category-spec-all-assigned">
                <i data-lucide="check-circle-2" class="w-8 h-8"></i>
                <p>Tất cả thông số đã được gán cho danh mục này.</p>
            </div>
        }
    </section>
</main>

@section Scripts {
    <script src="~/js/category-specifications.js" asp-append-version="true"></script>
}
