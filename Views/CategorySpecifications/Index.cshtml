@model e_commerce_web_admin.ViewModels.CategorySpecifications.CategorySpecIndexViewModel
@{
    ViewData["Title"] = $"Thông số — {Model.CategoryName}";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/specifications.css" asp-append-version="true" />
}

@* Anti-forgery token dùng cho JS AJAX *@
@Html.AntiForgeryToken()

@* ── Breadcrumb + Header ── *@
<div class="mb-6 spec-anim" style="animation-delay:0.04s">
    <nav class="flex items-center gap-2 text-xs text-slate-400 mb-2">
        <a asp-controller="Categories" asp-action="Index" class="hover:text-teal-600 transition-colors">Danh mục</a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <a asp-controller="Specifications" asp-action="Index" class="hover:text-teal-600 transition-colors">Thông số</a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <span class="text-slate-600 font-medium">@Model.CategoryName</span>
    </nav>
    <div class="flex items-center justify-between gap-4">
        <div class="flex items-center gap-3 min-w-0">
            <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-teal-400 to-teal-600 flex items-center justify-center shadow-sm flex-shrink-0">
                <i data-lucide="list-checks" class="w-4 h-4 text-white"></i>
            </div>
            <div class="min-w-0">
                <h1 class="text-2xl font-bold text-slate-800 truncate">
                    Thông số kỹ thuật — <span class="text-teal-600">@Model.CategoryName</span>
                </h1>
                <p class="text-slate-500 text-sm">
                    <span class="font-mono text-slate-400 text-xs">/categories/@Model.CategorySlug</span>
                    &nbsp;·&nbsp;
                    @Model.TotalAssigned thông số đã gán
                </p>
            </div>
        </div>

        <a asp-controller="Categories" asp-action="Index"
           class="inline-flex items-center gap-2 text-sm font-medium flex-shrink-0
                  text-slate-600 bg-white hover:bg-slate-50 hover:text-slate-800
                  border border-slate-200 hover:border-slate-300
                  px-4 py-2 rounded-xl transition-all shadow-sm">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
            Quay lại Danh mục
        </a>
    </div>
</div>


@* ── Toasts ── *@
@if (TempData["Success"] != null)
{
    <div id="toastSuccess"
         class="mb-4 flex items-center gap-3 bg-emerald-50 border border-emerald-200 text-emerald-700 rounded-xl px-4 py-3 text-sm shadow-sm spec-anim"
         style="animation-delay:0.04s">
        <div class="w-7 h-7 rounded-full bg-emerald-100 flex items-center justify-center flex-shrink-0">
            <i data-lucide="check" class="w-4 h-4 text-emerald-600"></i>
        </div>
        <span class="flex-1">@TempData["Success"]</span>
        <button type="button" data-dismiss-target="toastSuccess" class="text-emerald-400 hover:text-emerald-600 transition-colors">
            <i data-lucide="x" class="w-4 h-4"></i>
        </button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div id="toastError"
         class="mb-4 flex items-center gap-3 bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3 text-sm shadow-sm spec-anim"
         style="animation-delay:0.04s">
        <div class="w-7 h-7 rounded-full bg-red-100 flex items-center justify-center flex-shrink-0">
            <i data-lucide="alert-circle" class="w-4 h-4 text-red-500"></i>
        </div>
        <span class="flex-1">@TempData["Error"]</span>
        <button type="button" data-dismiss-target="toastError" class="text-red-400 hover:text-red-600 transition-colors">
            <i data-lucide="x" class="w-4 h-4"></i>
        </button>
    </div>
}

@* ── Main layout: 2 columns on lg ── *@
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    @* ════════════════════════════════════════
       LEFT (2/3): Assigned specs table
       ════════════════════════════════════════ *@
    <div class="lg:col-span-2 space-y-4">

        @* Search bar for assigned list *@
        <div class="bg-white rounded-2xl border border-slate-100 p-4 shadow-sm spec-anim" style="animation-delay:0.08s">
            <form method="get" asp-action="Index" class="flex gap-3">
                <input type="hidden" name="categoryId" value="@Model.CategoryId" />
                <div class="relative flex-1">
                    <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 pointer-events-none"></i>
                    <input type="text" name="search" value="@Model.Search"
                           placeholder="Tìm thông số đã gán..."
                           class="w-full pl-9 pr-4 py-2 border border-slate-200 rounded-xl text-sm text-slate-700
                                  focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition" />
                </div>
                <button type="submit"
                        class="inline-flex items-center gap-2 bg-teal-600 hover:bg-teal-700 text-white text-sm font-semibold px-4 py-2 rounded-xl transition-colors">
                    <i data-lucide="search" class="w-4 h-4"></i>
                    Tìm
                </button>
                @if (!string.IsNullOrEmpty(Model.Search))
                {
                    <a asp-action="Index" asp-route-categoryId="@Model.CategoryId"
                       class="inline-flex items-center gap-1.5 text-slate-500 hover:text-slate-700 text-sm px-2 transition-colors">
                        <i data-lucide="x-circle" class="w-4 h-4"></i>
                        Xoá lọc
                    </a>
                }
            </form>
        </div>

        @* Assigned specs table *@
        <div class="bg-white rounded-2xl border border-slate-100 overflow-hidden shadow-sm spec-anim" style="animation-delay:0.12s">

            @if (!Model.AssignedSpecs.Any())
            {
                <div class="py-16 text-center">
                    <div class="w-16 h-16 rounded-2xl bg-teal-50 flex items-center justify-center mx-auto mb-4">
                        <i data-lucide="list-x" class="w-8 h-8 text-teal-300"></i>
                    </div>
                    <p class="text-slate-600 font-semibold">Chưa có thông số nào được gán</p>
                    <p class="text-slate-400 text-sm mt-1">Dùng bảng bên phải để gán thông số vào danh mục này.</p>
                </div>
            }
            else
            {
                @* Header *@
                <div class="px-5 py-3 bg-slate-50 border-b border-slate-100
                            grid grid-cols-[auto_1fr_auto_auto_auto_auto] gap-3 items-center">
                    <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider w-28">Key</span>
                    <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Tên / Nhóm</span>
                    <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider text-center w-16">Thứ tự</span>
                    <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider text-center w-20">Bắt buộc</span>
                    <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider text-center w-20">Sản phẩm</span>
                    <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider text-right w-16">Xoá</span>
                </div>

                <div class="divide-y divide-slate-50">
                    @{int idx = 0;}
                    @foreach (var row in Model.AssignedSpecs)
                    {
                        <div class="spec-row grid grid-cols-[auto_1fr_auto_auto_auto_auto] gap-3 items-center px-5 py-3 spec-anim"
                             style="animation-delay:@(0.12 + idx++ * 0.025)s"
                             data-spec-row
                             data-category-id="@Model.CategoryId"
                             data-spec-id="@row.SpecificationId">

                            @* Key *@
                            <div class="w-28 flex-shrink-0">
                                <span class="spec-key-badge">@row.Key</span>
                            </div>

                            @* Name + GroupName inline edit *@
                            <div class="min-w-0">
                                <p class="font-medium text-slate-700 text-sm truncate mb-1">@row.Name</p>
                                <input data-field="groupName"
                                       type="text"
                                       value="@(row.GroupName ?? "")"
                                       placeholder="Tên nhóm (tuỳ chọn)"
                                       class="inline-edit text-xs text-slate-500 w-full max-w-[200px]"
                                       maxlength="120" />
                            </div>

                            @* Sort order *@
                            <div class="w-16 text-center">
                                <input data-field="sortOrder"
                                       type="number"
                                       min="0" max="9999"
                                       value="@row.SortOrder"
                                       class="inline-edit text-center text-xs font-semibold w-14" />
                            </div>

                            @* IsRequired toggle *@
                            <div class="w-20 flex justify-center">
                                <button type="button"
                                        data-field="isRequired"
                                        class="req-toggle @(row.IsRequired ? "active" : "")"
                                        title="@(row.IsRequired ? "Bắt buộc" : "Không bắt buộc")">
                                </button>
                            </div>

                            @* Product usage *@
                            <div class="w-20 text-center">
                                <span class="inline-flex items-center justify-center gap-1 text-xs font-semibold rounded-full px-2 py-0.5
                                             @(row.ProductUsageCount > 0 ? "bg-blue-100 text-blue-700" : "bg-slate-100 text-slate-400")">
                                    <i data-lucide="package" class="w-3 h-3"></i>
                                    @row.ProductUsageCount
                                </span>
                            </div>

                            @* Remove *@
                            <div class="w-16 flex justify-end">
                                <form asp-action="Remove" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="categoryId" value="@Model.CategoryId" />
                                    <input type="hidden" name="specId" value="@row.SpecificationId" />
                                    <button type="submit"
                                            title="Bỏ gán"
                                            onclick="return confirm('Bỏ gán thông số \'@row.Name\' khỏi danh mục này?')"
                                            class="w-7 h-7 flex items-center justify-center rounded-lg
                                                   bg-red-50 hover:bg-red-100 text-red-400 hover:text-red-600
                                                   transition-colors">
                                        <i data-lucide="link-2-off" class="w-3.5 h-3.5"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>

                @* Pagination *@
                @if (Model.TotalPages > 1)
                {
                    <div class="px-5 py-3 border-t border-slate-100 flex items-center justify-between bg-slate-50/50">
                        <p class="text-xs text-slate-400">
                            Trang <span class="font-semibold text-slate-600">@Model.Page</span> / @Model.TotalPages
                        </p>
                        <div class="flex items-center gap-1">
                            @if (Model.HasPrev)
                            {
                                <a asp-action="Index" asp-route-categoryId="@Model.CategoryId"
                                   asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search"
                                   class="w-7 h-7 rounded-lg border border-slate-200 bg-white hover:bg-slate-50
                                          flex items-center justify-center text-slate-600 transition-colors">
                                    <i data-lucide="chevron-left" class="w-3.5 h-3.5"></i>
                                </a>
                            }
                            @for (int p = Math.Max(1, Model.Page - 1); p <= Math.Min(Model.TotalPages, Model.Page + 1); p++)
                            {
                                <a asp-action="Index" asp-route-categoryId="@Model.CategoryId"
                                   asp-route-page="@p" asp-route-search="@Model.Search"
                                   class="w-7 h-7 rounded-lg text-xs font-semibold flex items-center justify-center transition-all
                                          @(p == Model.Page
                                              ? "bg-teal-500 text-white"
                                              : "border border-slate-200 bg-white text-slate-600 hover:bg-slate-50")">
                                    @p
                                </a>
                            }
                            @if (Model.HasNext)
                            {
                                <a asp-action="Index" asp-route-categoryId="@Model.CategoryId"
                                   asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search"
                                   class="w-7 h-7 rounded-lg border border-slate-200 bg-white hover:bg-slate-50
                                          flex items-center justify-center text-slate-600 transition-colors">
                                    <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
                                </a>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    @* ════════════════════════════════════════
       RIGHT (1/3): Assign new spec
       ════════════════════════════════════════ *@
    <div class="space-y-4">

        @* Assign form *@
        <div class="assign-panel rounded-2xl p-5 spec-anim" style="animation-delay:0.1s">
            <h3 class="text-sm font-semibold text-teal-700 mb-4 flex items-center gap-2">
                <i data-lucide="plus-circle" class="w-4 h-4"></i>
                Gán thông số vào danh mục
            </h3>

            <form asp-action="Assign" method="post" class="space-y-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="CategoryId" value="@Model.CategoryId" />

                @* Select spec *@
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1.5">
                        Thông số <span class="text-red-500">*</span>
                    </label>
                    <select name="SpecificationId"
                            class="w-full border border-slate-200 rounded-xl px-3 py-2 text-sm text-slate-700 bg-white
                                   focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition">
                        <option value="">-- Chọn thông số --</option>
                        @foreach (var opt in Model.AvailableSpecs)
                        {
                            <option value="@opt.Id">
                                @opt.Name @(!string.IsNullOrEmpty(opt.Unit) ? $"({opt.Unit})" : "") — @opt.Key
                            </option>
                        }
                    </select>
                </div>

                @* GroupName *@
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1.5">
                        Tên nhóm
                        <span class="font-normal text-slate-400">(tuỳ chọn)</span>
                    </label>
                    <input type="text" name="GroupName" placeholder="Ví dụ: Hiệu năng, Màn hình..."
                           class="w-full border border-slate-200 rounded-xl px-3 py-2 text-sm text-slate-800
                                  focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition"
                           maxlength="120" />
                </div>

                @* SortOrder + IsRequired *@
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1.5">Thứ tự</label>
                        <input type="number" name="SortOrder" value="0" min="0" max="9999"
                               class="w-full border border-slate-200 rounded-xl px-3 py-2 text-sm text-slate-800
                                      focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1.5">Bắt buộc</label>
                        <label class="flex items-center gap-2 mt-2 cursor-pointer">
                            <div class="relative">
                                <input type="checkbox" name="IsRequired" value="true" class="sr-only peer" />
                                <div class="w-9 h-5 bg-slate-200 rounded-full peer-checked:bg-teal-500 transition-colors"></div>
                                <div class="absolute top-0.5 left-0.5 w-4 h-4 bg-white rounded-full shadow transition-transform peer-checked:translate-x-4"></div>
                            </div>
                            <span class="text-xs text-slate-600">Bắt buộc</span>
                        </label>
                    </div>
                </div>

                <button type="submit"
                        class="w-full flex items-center justify-center gap-2
                               bg-gradient-to-r from-teal-500 to-teal-600 hover:from-teal-600 hover:to-teal-700
                               text-white text-sm font-semibold px-4 py-2.5 rounded-xl transition-all shadow-sm hover:shadow-md">
                    <i data-lucide="link" class="w-4 h-4"></i>
                    Gán thông số
                </button>
            </form>
        </div>

        @* Available spec search + quick list *@
        @if (Model.AvailableSpecs.Any())
        {
            <div class="bg-white rounded-2xl border border-slate-100 p-4 shadow-sm spec-anim" style="animation-delay:0.14s">
                <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3">
                    Thông số chưa gán (@Model.AvailableSpecs.Count)
                </h3>

                <div class="relative mb-2">
                    <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-slate-400 pointer-events-none"></i>
                    <input id="availableSpecSearch" type="text"
                           placeholder="Lọc nhanh..."
                           class="w-full pl-8 pr-3 py-1.5 border border-slate-200 rounded-lg text-xs text-slate-700
                                  focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition" />
                </div>

                <ul id="availableSpecList" class="space-y-1 max-h-56 overflow-y-auto">
                    @foreach (var opt in Model.AvailableSpecs)
                    {
                        <li data-spec-item
                            data-name="@opt.Name"
                            data-key="@opt.Key"
                            class="available-spec-item flex items-center justify-between px-2 py-1.5 gap-2">
                            <div class="min-w-0">
                                <span class="text-xs font-medium text-slate-700">@opt.Name</span>
                                @if (!string.IsNullOrEmpty(opt.Unit))
                                {
                                    <span class="text-[10px] text-slate-400 ml-1">(@opt.Unit)</span>
                                }
                                <span class="spec-key-badge text-[10px] ml-1">@opt.Key</span>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        }
        else
        {
            <div class="bg-white rounded-2xl border border-slate-100 p-4 shadow-sm text-center spec-anim" style="animation-delay:0.14s">
                <i data-lucide="check-circle-2" class="w-8 h-8 text-teal-300 mx-auto mb-2"></i>
                <p class="text-xs text-slate-500 font-medium">Tất cả thông số đã được gán!</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/category-specifications.js" asp-append-version="true"></script>
}
