@model e_commerce_web_admin.ViewModels.ProfitReports.ProfitReportViewModel
@using System.Globalization
@using System.Text.Json
@{
    ViewData["Title"] = "Báo cáo lãi";
    Layout = "_Layout";

    var vi = CultureInfo.GetCultureInfo("vi-VN");
    string Money(decimal value) => string.Concat(value.ToString("N0", vi), " đ");
    string Percent(decimal value) => string.Concat(value.ToString("N2", vi), "%");
    string DateText(DateTime value) => value.ToLocalTime().ToString("dd/MM/yyyy", vi);
    string DateInput(DateTime value) => value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var isCustomPeriod = string.Equals(Model.Period, "custom", StringComparison.OrdinalIgnoreCase);

    var trendJson = JsonSerializer.Serialize(Model.Trend.Select(item => new
    {
        label = item.Label,
        revenue = item.Revenue,
        cost = item.Cost,
        profit = item.GrossProfit,
    }));
    var categoryJson = JsonSerializer.Serialize(Model.Categories.Select(item => new
    {
        label = item.CategoryName,
        revenue = item.Revenue,
        profit = item.GrossProfit,
    }));
}

@section Styles {
    <style>
        .profit-report-page {
            min-width: 0;
            overflow-x: hidden;
        }

        .profit-report-page * {
            box-sizing: border-box;
            min-width: 0;
        }

        .profit-report-header {
            display: flex;
            flex-direction: column;
            gap: clamp(0.85rem, 2vw, 1rem);
        }

        .profit-hero-copy {
            flex: 0 1 auto;
        }

        .profit-period-tabs {
            display: flex;
            flex-wrap: wrap;
            align-items: end;
            justify-content: flex-end;
            gap: 0.5rem;
            margin-left: auto;
            width: 100%;
        }

        .profit-period-tabs > label {
            display: grid;
            gap: 0.25rem;
            min-width: min(100%, 10.5rem);
        }

        .profit-period-tabs > label:first-child {
            min-width: min(100%, 14rem);
        }

        .profit-period-tabs span {
            font-size: 0.72rem;
            font-weight: 700;
            color: #64748b;
        }

        .profit-period-tabs select,
        .profit-period-tabs input {
            min-height: 2.5rem;
            border: 1px solid #e2e8f0;
            border-radius: 0.5rem;
            background: #fff;
            padding: 0.45rem 0.7rem;
            font-size: 0.875rem;
            font-weight: 600;
            color: #334155;
        }

        .profit-period-tabs input:disabled {
            background: #f8fafc;
            color: #94a3b8;
        }

        .profit-filter-button {
            display: inline-flex;
            min-height: 2.5rem;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
            border-radius: 0.5rem;
            background: #0f766e;
            padding: 0.45rem 0.9rem;
            font-size: 0.875rem;
            font-weight: 700;
            color: #fff;
            white-space: nowrap;
        }

        .profit-filter-button span {
            color: #fff;
        }

        .profit-period-tabs > a {
            flex: 0 1 auto;
            max-width: 100%;
            text-align: center;
            white-space: nowrap;
        }

        .profit-kpi-card,
        .profit-panel {
            border-radius: 0.5rem;
        }

        .profit-kpi-card {
            display: grid;
            align-content: start;
        }

        .profit-kpi-value {
            max-width: 100%;
            font-size: clamp(1.08rem, 4.8vw, 1.5rem);
            font-variant-numeric: tabular-nums;
            letter-spacing: -0.025em;
            line-height: 1.05;
            overflow-wrap: normal;
            white-space: nowrap;
        }

        .profit-chart-shell {
            position: relative;
            height: 18rem;
        }

        .profit-category-chart-shell {
            height: 19rem;
        }

        .profit-products-scroll {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        .profit-products-table {
            width: 100%;
            min-width: 52rem;
        }

        .profit-product-cards {
            display: grid;
            gap: 0.75rem;
            padding: 1rem;
        }

        .profit-product-card {
            border-radius: 0.5rem;
        }

        @@media (max-width: 767px) {
            .profit-report-page {
                margin-inline: -0.25rem;
            }

            .profit-report-header {
                gap: 0.8rem;
            }

            .profit-hero-copy {
                max-width: 100%;
            }

            .profit-hero-copy p {
                max-width: 34rem;
            }

            .profit-period-tabs {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 0.65rem;
                margin-top: 0;
            }

            .profit-filter-button {
                width: 100%;
            }

            .profit-kpi-card,
            .profit-panel {
                padding: 1rem;
            }

            .profit-kpi-card {
                min-height: 6rem;
            }

            .profit-chart-shell {
                height: 17rem;
            }

            .profit-category-chart-shell {
                height: 19rem;
            }
        }

        @@media (min-width: 640px) {
            .profit-kpi-value {
                font-size: 1.375rem;
            }
        }

        @@media (max-width: 374px) {
            .profit-period-tabs {
                grid-template-columns: 1fr;
            }

            .profit-kpi-value {
                font-size: clamp(1rem, 5.2vw, 1.12rem);
            }
        }

        @@media (min-width: 1024px) {
            .profit-report-header {
                flex-direction: row;
                align-items: end;
                justify-content: space-between;
            }

            .profit-hero-copy {
                flex: 1 1 18rem;
            }

            .profit-period-tabs {
                flex: 1 1 42rem;
                justify-content: flex-end;
                width: auto;
            }

            .profit-kpi-value {
                font-size: 1.5rem;
            }
        }

        @@media (min-width: 1280px) {
            .profit-product-cards {
                display: none;
            }
        }

        @@media (max-width: 1279px) {
            .profit-products-scroll {
                display: none;
            }
        }

        @@media (min-width: 1280px) {
            .profit-chart-shell {
                height: 20rem;
            }
        }

        @@media (min-width: 768px) and (max-width: 1535px) {
            .profit-table-layout {
                grid-template-columns: 1fr;
            }

            .profit-aside-grid {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 1rem;
            }

            .profit-aside-grid .profit-help-card {
                grid-column: 1 / -1;
            }
        }
    </style>
}

<main class="profit-report-page space-y-5 md:space-y-6">
    <section class="profit-report-header">
        <div class="profit-hero-copy">
            <h1 class="text-2xl font-bold text-slate-900 sm:text-3xl">Báo cáo lãi</h1>
            <p class="mt-1 max-w-3xl text-sm leading-6 text-slate-500">
                Lãi gộp = doanh thu đơn đã giao và thanh toán - giá vốn đã chốt theo tồn kho nhập.
            </p>
        </div>
        <form method="get" asp-action="Index" class="profit-period-tabs">
            <label for="profitPeriodSelect">
                <span>Thời gian</span>
                <select id="profitPeriodSelect" name="period" data-profit-period-select>
            @foreach (var option in Model.PeriodOptions)
            {
                    <option value="@option.Value" selected="@(option.IsSelected ? "selected" : null)">@option.Text</option>
            }
                </select>
            </label>
            <label for="profitStartDate" data-profit-custom-date-field>
                <span>Từ ngày</span>
                <input id="profitStartDate"
                       type="date"
                       name="startDate"
                       value="@DateInput(Model.StartDate)"
                       disabled="@(!isCustomPeriod)"
                       data-profit-start-date />
            </label>
            <label for="profitEndDate" data-profit-custom-date-field>
                <span>Đến ngày</span>
                <input id="profitEndDate"
                       type="date"
                       name="endDate"
                       value="@DateInput(Model.EndDate)"
                       disabled="@(!isCustomPeriod)"
                       data-profit-end-date />
            </label>
            <button type="submit" class="profit-filter-button">
                <i data-lucide="filter" class="h-4 w-4"></i>
                <span>Lọc</span>
            </button>
        </form>
    </section>

    <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <article class="profit-kpi-card border border-slate-200 bg-white p-5 shadow-sm">
            <div class="flex items-center justify-between gap-3">
                <span class="text-sm font-semibold text-slate-500">Doanh thu đơn hàng</span>
                <i data-lucide="receipt-text" class="h-5 w-5 text-teal-600"></i>
            </div>
            <p class="profit-kpi-value mt-3 font-bold text-slate-900">@Money(Model.Revenue)</p>
            <p class="mt-1 text-xs text-slate-400">@Model.CompletedOrderCount đơn hoàn tất</p>
        </article>

        <article class="profit-kpi-card border border-slate-200 bg-white p-5 shadow-sm">
            <div class="flex items-center justify-between gap-3">
                <span class="text-sm font-semibold text-slate-500">Giá vốn hàng bán</span>
                <i data-lucide="package-check" class="h-5 w-5 text-blue-600"></i>
            </div>
            <p class="profit-kpi-value mt-3 font-bold text-slate-900">@Money(Model.Cost)</p>
            <p class="mt-1 text-xs text-slate-400">@Model.SoldQuantity.ToString("N0", vi) sản phẩm đã bán</p>
        </article>

        <article class="profit-kpi-card border border-slate-200 bg-white p-5 shadow-sm">
            <div class="flex items-center justify-between gap-3">
                <span class="text-sm font-semibold text-slate-500">Lãi gộp</span>
                <i data-lucide="chart-no-axes-combined" class="h-5 w-5 text-emerald-600"></i>
            </div>
            <p class="profit-kpi-value mt-3 font-bold @(Model.GrossProfit >= 0 ? "text-emerald-700" : "text-rose-600")">@Money(Model.GrossProfit)</p>
            <p class="mt-1 text-xs text-slate-400">Biên lãi @Percent(Model.GrossMarginPercent)</p>
        </article>

        <article class="profit-kpi-card border border-slate-200 bg-white p-5 shadow-sm">
            <div class="flex items-center justify-between gap-3">
                <span class="text-sm font-semibold text-slate-500">Lãi trung bình mỗi đơn</span>
                <i data-lucide="calculator" class="h-5 w-5 text-amber-600"></i>
            </div>
            <p class="profit-kpi-value mt-3 font-bold text-slate-900">@Money(Model.AverageProfitPerOrder)</p>
            <p class="mt-1 text-xs text-slate-400">@DateText(Model.StartDate) - @DateText(Model.EndDate)</p>
        </article>
    </section>

    <section class="grid gap-4 2xl:grid-cols-[minmax(0,1.35fr)_minmax(24rem,0.65fr)]">
        <article class="profit-panel border border-slate-200 bg-white p-5 shadow-sm">
            <div class="mb-4 flex items-center justify-between gap-3">
                <div>
                    <h2 class="font-bold text-slate-900">Doanh thu, giá vốn và lãi gộp</h2>
                    <p class="text-xs text-slate-400">Theo khoảng thời gian đã chọn</p>
                </div>
            </div>
            <div class="profit-chart-shell">
                <canvas id="profitTrendChart"></canvas>
            </div>
        </article>

        <article class="profit-panel border border-slate-200 bg-white p-5 shadow-sm">
            <div class="mb-4">
                <h2 class="font-bold text-slate-900">Lãi theo nhóm hàng</h2>
                <p class="text-xs text-slate-400">Nhóm có lãi gộp cao nhất</p>
            </div>
            <div class="profit-chart-shell profit-category-chart-shell">
                <canvas id="profitCategoryChart"></canvas>
            </div>
        </article>
    </section>

    <section class="profit-table-layout grid gap-4 2xl:grid-cols-[minmax(0,1fr)_22rem]">
        <article class="profit-panel overflow-hidden border border-slate-200 bg-white shadow-sm">
            <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4">
                <div>
                    <h2 class="font-bold text-slate-900">Sản phẩm tạo lãi tốt nhất</h2>
                    <p class="text-xs text-slate-400">Xếp theo lãi gộp trong kỳ</p>
                </div>
            </div>

            @if (!Model.TopProducts.Any())
            {
                <div class="px-5 py-10 text-center text-sm text-slate-500">
                    Chưa có đơn hoàn tất trong khoảng thời gian này.
                </div>
            }
            else
            {
                <div class="profit-product-cards">
                    @foreach (var row in Model.TopProducts)
                    {
                        <article class="profit-product-card border border-slate-200 bg-white p-4">
                            <div class="flex items-start justify-between gap-3">
                                <div>
                                    <h3 class="font-semibold leading-5 text-slate-900">@row.ProductName</h3>
                                    <p class="mt-1 text-xs text-slate-400">SKU @row.VariantCode</p>
                                </div>
                                <span class="rounded-md bg-slate-100 px-2 py-1 text-xs font-bold text-slate-600">
                                    @row.Quantity.ToString("N0", vi)
                                </span>
                            </div>
                            <dl class="mt-4 grid grid-cols-2 gap-x-3 gap-y-2 text-sm">
                                <dt class="text-slate-400">Doanh thu</dt>
                                <dd class="text-right font-semibold text-slate-700">@Money(row.Revenue)</dd>
                                <dt class="text-slate-400">Giá vốn</dt>
                                <dd class="text-right font-semibold text-slate-700">@Money(row.Cost)</dd>
                                <dt class="text-slate-400">Lãi gộp</dt>
                                <dd class="text-right font-bold @(row.GrossProfit >= 0 ? "text-emerald-700" : "text-rose-600")">@Money(row.GrossProfit)</dd>
                                <dt class="text-slate-400">Biên lãi</dt>
                                <dd class="text-right font-semibold text-slate-700">@Percent(row.GrossMarginPercent)</dd>
                            </dl>
                        </article>
                    }
                </div>

                <div class="profit-products-scroll">
                    <table class="profit-products-table divide-y divide-slate-100 text-sm">
                        <thead class="bg-slate-50 text-xs font-bold uppercase tracking-wide text-slate-500">
                            <tr>
                                <th class="px-5 py-3 text-left">Sản phẩm</th>
                                <th class="px-5 py-3 text-right">SL</th>
                                <th class="px-5 py-3 text-right">Doanh thu</th>
                                <th class="px-5 py-3 text-right">Giá vốn</th>
                                <th class="px-5 py-3 text-right">Lãi gộp</th>
                                <th class="px-5 py-3 text-right">Biên lãi</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var row in Model.TopProducts)
                            {
                                <tr class="hover:bg-slate-50">
                                    <td class="px-5 py-4">
                                        <p class="font-semibold text-slate-900">@row.ProductName</p>
                                        <p class="mt-1 text-xs text-slate-400">SKU @row.VariantCode</p>
                                    </td>
                                    <td class="px-5 py-4 text-right font-semibold text-slate-700">@row.Quantity.ToString("N0", vi)</td>
                                    <td class="px-5 py-4 text-right text-slate-600">@Money(row.Revenue)</td>
                                    <td class="px-5 py-4 text-right text-slate-600">@Money(row.Cost)</td>
                                    <td class="px-5 py-4 text-right font-bold @(row.GrossProfit >= 0 ? "text-emerald-700" : "text-rose-600")">@Money(row.GrossProfit)</td>
                                    <td class="px-5 py-4 text-right font-semibold text-slate-700">@Percent(row.GrossMarginPercent)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </article>

        <aside class="profit-aside-grid space-y-4 md:space-y-0 2xl:space-y-4">
            <article class="profit-kpi-card border border-slate-200 bg-white p-5 shadow-sm">
                <div class="flex items-center justify-between gap-3">
                    <span class="text-sm font-semibold text-slate-500">Giá vốn tồn kho</span>
                    <i data-lucide="warehouse" class="h-5 w-5 text-blue-600"></i>
                </div>
                <p class="profit-kpi-value mt-3 font-bold text-slate-900">@Money(Model.InventoryCostValue)</p>
            </article>

            <article class="profit-kpi-card border border-slate-200 bg-white p-5 shadow-sm">
                <div class="flex items-center justify-between gap-3">
                    <span class="text-sm font-semibold text-slate-500">Lãi dự kiến từ tồn kho</span>
                    <i data-lucide="trending-up" class="h-5 w-5 text-emerald-600"></i>
                </div>
                <p class="profit-kpi-value mt-3 font-bold text-emerald-700">@Money(Model.InventoryPotentialProfit)</p>
                <p class="mt-1 text-xs text-slate-400">Tính theo giá bán hiện tại</p>
            </article>

            <article class="profit-help-card profit-panel border border-slate-200 bg-white p-5 shadow-sm">
                <h2 class="font-bold text-slate-900">Cách đọc nhanh</h2>
                <dl class="mt-4 space-y-3 text-sm">
                    <div>
                        <dt class="font-semibold text-slate-700">Doanh thu đơn hàng</dt>
                        <dd class="mt-1 text-slate-500">Tổng tiền đơn đã giao xong và đã thanh toán, đã gồm phí vận chuyển và trừ voucher.</dd>
                    </div>
                    <div>
                        <dt class="font-semibold text-slate-700">Giá vốn hàng bán</dt>
                        <dd class="mt-1 text-slate-500">Giá nhập đã chốt vào từng dòng hàng khi đơn hoàn tất.</dd>
                    </div>
                    <div>
                        <dt class="font-semibold text-slate-700">Lãi gộp</dt>
                        <dd class="mt-1 text-slate-500">Chưa trừ chi phí vận chuyển thực trả, phí thanh toán, thuế và chi phí vận hành.</dd>
                    </div>
                </dl>
            </article>
        </aside>
    </section>
</main>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script>
        (() => {
            const trend = @Html.Raw(trendJson);
            const categories = @Html.Raw(categoryJson);
            const money = value => new Intl.NumberFormat('vi-VN', {
                style: 'currency',
                currency: 'VND',
                maximumFractionDigits: 0
            }).format(value || 0);
            const periodSelect = document.querySelector('[data-profit-period-select]');
            const customDateFields = Array.from(document.querySelectorAll('[data-profit-custom-date-field]'));
            const customDateInputs = [
                document.querySelector('[data-profit-start-date]'),
                document.querySelector('[data-profit-end-date]')
            ].filter(Boolean);
            const syncDateInputs = () => {
                const isCustom = periodSelect?.value === 'custom';
                customDateFields.forEach(field => field.classList.toggle('opacity-60', !isCustom));
                customDateInputs.forEach(input => {
                    input.disabled = !isCustom;
                });
            };
            periodSelect?.addEventListener('change', syncDateInputs);
            syncDateInputs();

            if (!window.Chart) {
                return;
            }

            const trendCanvas = document.getElementById('profitTrendChart');
            if (trendCanvas) {
                new Chart(trendCanvas, {
                    type: 'line',
                    data: {
                        labels: trend.map(item => item.label),
                        datasets: [
                            {
                                label: 'Doanh thu đơn hàng',
                                data: trend.map(item => item.revenue),
                                borderColor: '#0f766e',
                                backgroundColor: 'rgba(15, 118, 110, 0.12)',
                                tension: 0.35,
                                fill: true,
                                pointRadius: 3
                            },
                            {
                                label: 'Giá vốn hàng bán',
                                data: trend.map(item => item.cost),
                                borderColor: '#2563eb',
                                backgroundColor: 'rgba(37, 99, 235, 0.08)',
                                tension: 0.35,
                                fill: false,
                                pointRadius: 3
                            },
                            {
                                label: 'Lãi gộp',
                                data: trend.map(item => item.profit),
                                borderColor: '#d97706',
                                backgroundColor: 'rgba(217, 119, 6, 0.1)',
                                tension: 0.35,
                                fill: false,
                                pointRadius: 3
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: { mode: 'index', intersect: false },
                        plugins: {
                            legend: { labels: { boxWidth: 10, usePointStyle: true } },
                            tooltip: {
                                callbacks: {
                                    label: context => `${context.dataset.label}: ${money(context.parsed.y)}`
                                }
                            }
                        },
                        scales: {
                            y: {
                                ticks: { callback: value => money(value) },
                                grid: { color: 'rgba(148, 163, 184, 0.18)' }
                            },
                            x: { grid: { display: false } }
                        }
                    }
                });
            }

            const categoryCanvas = document.getElementById('profitCategoryChart');
            if (categoryCanvas) {
                new Chart(categoryCanvas, {
                    type: 'bar',
                    data: {
                        labels: categories.map(item => item.label),
                        datasets: [
                            {
                                label: 'Lãi gộp',
                                data: categories.map(item => item.profit),
                                backgroundColor: '#0f766e',
                                borderRadius: 6
                            },
                            {
                                label: 'Doanh thu',
                                data: categories.map(item => item.revenue),
                                backgroundColor: '#f59e0b',
                                borderRadius: 6
                            }
                        ]
                    },
                    options: {
                        indexAxis: 'y',
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { labels: { boxWidth: 10, usePointStyle: true } },
                            tooltip: {
                                callbacks: {
                                    label: context => `${context.dataset.label}: ${money(context.parsed.x)}`
                                }
                            }
                        },
                        scales: {
                            x: {
                                ticks: { callback: value => money(value) },
                                grid: { color: 'rgba(148, 163, 184, 0.18)' }
                            },
                            y: { grid: { display: false } }
                        }
                    }
                });
            }
        })();
    </script>
}
