@model e_commerce_web_admin.ViewModels.Categories.CategoryFormViewModel
@{
    ViewData["Title"] = $"Sửa danh mục — {Model.Name}";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/categories.css" asp-append-version="true" />
}

@* ── Breadcrumb + Header ── *@
<main class="surface-page category-form-page">
<div class="surface-form-hero cat-anim surface-anim" style="animation-delay:0.05s">
    <nav class="flex items-center gap-2 text-xs text-slate-400 mb-2">
        <a asp-action="Index" class="hover:text-brand-600 transition-colors">Danh mục</a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <span class="text-slate-600 font-medium">Chỉnh sửa</span>
    </nav>
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-800">@Model.Name</h1>
            <p class="text-slate-500 text-sm mt-0.5 font-mono">/categories/@Model.Slug</p>
        </div>
        <span class="hidden sm:inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-full
            @(Model.IsActive ? "bg-emerald-100 text-emerald-700" : "bg-slate-100 text-slate-500")">
            <span class="w-1.5 h-1.5 rounded-full @(Model.IsActive ? "bg-emerald-500" : "bg-slate-400")"></span>
            @(Model.IsActive ? "Đang hoạt động" : "Đã tắt")
        </span>
    </div>
</div>

@* ── Form ── *@
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="cat-anim surface-anim" style="animation-delay:0.12s">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <partial name="_Form" model="Model" />
</form>
</main>

@section Scripts {
    <script src="~/js/categories.js" asp-append-version="true"></script>
}
