@model e_commerce_web_admin.ViewModels.Categories.CategoryFormViewModel
@* Partial dùng chung cho Create và Edit — thẻ <form> được khai báo ở view cha. *@

<div class="surface-form-grid surface-form-card category-editor-shell">
    <header class="category-editor-header">
        <div class="category-editor-heading">
            <span class="category-editor-heading-icon" aria-hidden="true">
                <i data-lucide="folders" class="w-5 h-5"></i>
            </span>
            <div>
                <h2>Thông tin danh mục</h2>
                <p>Quản lý nội dung, ảnh đại diện, phân cấp và trạng thái trong cùng một biểu mẫu.</p>
            </div>
        </div>

        <div data-surface-form-alert
             class="surface-form-alert @(ViewData.ModelState.IsValid ? "hidden" : "")">
            <i data-lucide="alert-triangle" class="w-4 h-4"></i>
            <div>
                <p>Vui lòng kiểm tra lại thông tin.</p>
                <div asp-validation-summary="ModelOnly"></div>
            </div>
        </div>
    </header>

    <div class="category-editor-body">
        <div class="category-editor-main">
            <section class="category-editor-section category-editor-fields" aria-labelledby="categoryBasicInfoTitle">
                <div class="category-editor-section-title">
                    <span class="category-editor-step">01</span>
                    <div>
                        <h3 id="categoryBasicInfoTitle">Thông tin cơ bản</h3>
                        <p>Nội dung khách hàng sẽ nhìn thấy khi duyệt danh mục sản phẩm.</p>
                    </div>
                </div>

                <div class="category-editor-field-grid">
                    <div class="category-editor-field">
                        <label asp-for="Name">
                            Tên danh mục <span class="text-red-500">*</span>
                        </label>
                        <input asp-for="Name" id="categoryName"
                               placeholder="Ví dụ: Điện thoại thông minh" />
                        <span asp-validation-for="Name" class="text-xs text-red-500 mt-1 block"></span>
                    </div>

                    <div class="category-editor-field">
                        <label asp-for="Slug">
                            Slug
                            <span class="category-field-hint">Tự tạo từ tên nếu để trống</span>
                        </label>
                        <div class="category-slug-control">
                            <span aria-hidden="true">/categories/</span>
                            <input asp-for="Slug" id="categorySlug"
                                   placeholder="dien-thoai-thong-minh" />
                        </div>
                        <span asp-validation-for="Slug" class="text-xs text-red-500 mt-1 block"></span>
                    </div>

                    <div class="category-editor-field category-editor-field-wide">
                        <label asp-for="Description">Mô tả</label>
                        <textarea asp-for="Description" rows="5"
                                  placeholder="Mô tả ngắn về danh mục..."></textarea>
                        <span asp-validation-for="Description" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                </div>
            </section>

            <section class="category-editor-section category-editor-image" aria-labelledby="categoryImageTitle">
                <div class="category-editor-section-title">
                    <span class="category-editor-step">02</span>
                    <div>
                        <h3 id="categoryImageTitle">Ảnh đại diện</h3>
                        <p>Dùng ảnh rõ nét, đồng nhất tỷ lệ với các danh mục khác.</p>
                    </div>
                </div>

                <input type="hidden" asp-for="ImagePath" id="imagePathInput" />

                <div class="category-image-uploader">
                    <div id="imagePreview"
                         class="category-image-preview @(string.IsNullOrEmpty(Model.ImagePath) ? "is-empty" : "")">
                        <div class="category-image-placeholder" aria-hidden="true">
                            <i data-lucide="image" class="w-6 h-6"></i>
                            <span>Ảnh danh mục</span>
                        </div>
                        <img id="previewImg" src="@Model.ImagePath"
                             alt="Ảnh đại diện danh mục"
                             decoding="async"
                             onerror="this.parentElement.classList.add('is-empty')" />
                    </div>

                    <div class="category-image-upload-copy">
                        <label asp-for="ImageFile">Chọn tệp ảnh</label>
                        <input asp-for="ImageFile" id="imageFileInput" type="file"
                               accept="image/jpeg,image/png,image/webp,image/gif,image/svg+xml" />
                        <span asp-validation-for="ImageFile" class="text-xs text-red-500 mt-1 block"></span>
                        <p>JPG, PNG, WebP, GIF hoặc SVG. Ảnh sẽ được tải lên Cloudinary.</p>
                    </div>
                </div>
            </section>
        </div>

        <aside class="category-editor-side" aria-label="Phân cấp và trạng thái danh mục">
            <section class="category-editor-section category-editor-hierarchy" aria-labelledby="categoryHierarchyTitle">
                <div class="category-editor-section-title">
                    <span class="category-editor-step">03</span>
                    <div>
                        <h3 id="categoryHierarchyTitle">Phân cấp</h3>
                        <p>Xác định vị trí của danh mục trong cây điều hướng.</p>
                    </div>
                </div>

                <div class="category-editor-side-fields">
                    <div class="category-editor-field">
                        <label asp-for="ParentId">Danh mục cha</label>
                        <select asp-for="ParentId">
                            <option value="">Không có (danh mục gốc)</option>
                            @foreach (var opt in Model.ParentOptions)
                            {
                                <option value="@opt.Id" selected="@(Model.ParentId == opt.Id)">@opt.Label</option>
                            }
                        </select>
                        <span asp-validation-for="ParentId" class="text-xs text-red-500 mt-1 block"></span>
                    </div>

                    <div class="category-editor-field">
                        <label asp-for="Position">
                            Thứ tự hiển thị
                            <span class="category-field-hint">Từ 0 đến 9999</span>
                        </label>
                        <input asp-for="Position" type="number" min="0" max="9999" inputmode="numeric" />
                        <span asp-validation-for="Position" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                </div>
            </section>

            <section class="category-editor-section category-editor-status" aria-labelledby="categoryStatusTitle">
                <div class="category-status-copy">
                    <span class="category-status-icon" aria-hidden="true">
                        <i data-lucide="eye" class="w-4 h-4"></i>
                    </span>
                    <div>
                        <h3 id="categoryStatusTitle">Hiển thị danh mục</h3>
                        <p>Bật để khách hàng có thể thấy danh mục này trên cửa hàng.</p>
                    </div>
                </div>

                <label class="category-status-switch" for="isActiveToggle">
                    <input asp-for="IsActive" type="checkbox" id="isActiveToggle" />
                    <span class="category-status-track" aria-hidden="true"></span>
                    <span class="sr-only">Thay đổi trạng thái hiển thị danh mục</span>
                </label>
            </section>
        </aside>
    </div>

    <footer class="category-editor-actions">
        <a asp-action="Index" class="surface-cancel-link">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
            Quay lại
        </a>
        <button type="submit" class="category-submit-button">
            <i data-lucide="save" class="w-4 h-4"></i>
            Lưu danh mục
        </button>
    </footer>
</div>
