@model e_commerce_web_admin.Models.ViewModels.CategoryFormViewModel
@* Partial dùng chung cho Create & Edit *@

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    @* ── Cột trái: thông tin chính ── *@
    <div class="lg:col-span-2 space-y-5">

        @* Tên danh mục *@
        <div class="bg-white rounded-2xl border border-slate-200 p-5">
            <h3 class="text-sm font-semibold text-slate-700 mb-4">Thông tin cơ bản</h3>

            <div class="space-y-4">
                <div>
                    <label asp-for="Name" class="block text-xs font-semibold text-slate-600 mb-1.5">
                        Tên danh mục <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="Name" id="categoryName"
                           class="w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-transparent transition"
                           placeholder="Ví dụ: Điện thoại thông minh" />
                    <span asp-validation-for="Name" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="Slug" class="block text-xs font-semibold text-slate-600 mb-1.5">
                        Slug <span class="text-red-500">*</span>
                        <span class="font-normal text-slate-400 ml-1">(tự động tạo từ tên)</span>
                    </label>
                    <div class="relative">
                        <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs select-none">/categories/</span>
                        <input asp-for="Slug" id="categorySlug"
                               class="w-full border border-slate-200 rounded-xl pl-[6.5rem] pr-3.5 py-2.5 text-sm text-slate-800 font-mono focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-transparent transition"
                               placeholder="dien-thoai-thong-minh" />
                    </div>
                    <span asp-validation-for="Slug" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="Description" class="block text-xs font-semibold text-slate-600 mb-1.5">Mô tả</label>
                    <textarea asp-for="Description" rows="3"
                              class="w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-transparent transition resize-none"
                              placeholder="Mô tả ngắn về danh mục..."></textarea>
                    <span asp-validation-for="Description" class="text-xs text-red-500 mt-1 block"></span>
                </div>
            </div>
        </div>

        @* Ảnh đại diện *@
        <div class="bg-white rounded-2xl border border-slate-200 p-5">
            <h3 class="text-sm font-semibold text-slate-700 mb-4">Ảnh đại diện</h3>
            <div>
                <label asp-for="ImagePath" class="block text-xs font-semibold text-slate-600 mb-1.5">URL ảnh</label>
                <input asp-for="ImagePath" id="imagePathInput"
                       class="w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-transparent transition"
                       placeholder="https://example.com/image.jpg" />
                <span asp-validation-for="ImagePath" class="text-xs text-red-500 mt-1 block"></span>
            </div>
            @* Preview *@
            <div id="imagePreview" class="mt-3 @(string.IsNullOrEmpty(Model.ImagePath) ? "hidden" : "")">
                <img id="previewImg" src="@Model.ImagePath"
                     class="h-24 w-24 object-cover rounded-xl border border-slate-200"
                     onerror="this.parentElement.classList.add('hidden')" />
            </div>
        </div>
    </div>

    @* ── Cột phải: cài đặt ── *@
    <div class="space-y-5">

        @* Danh mục cha *@
        <div class="bg-white rounded-2xl border border-slate-200 p-5">
            <h3 class="text-sm font-semibold text-slate-700 mb-4">Phân cấp</h3>

            <div class="space-y-4">
                <div>
                    <label asp-for="ParentId" class="block text-xs font-semibold text-slate-600 mb-1.5">Danh mục cha</label>
                    <select asp-for="ParentId"
                            class="w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-transparent transition bg-white">
                        <option value="">— Không có (danh mục gốc) —</option>
                        @foreach (var opt in Model.ParentOptions)
                        {
                            <option value="@opt.Id" selected="@(Model.ParentId == opt.Id)">@opt.Label</option>
                        }
                    </select>
                    <span asp-validation-for="ParentId" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="Position" class="block text-xs font-semibold text-slate-600 mb-1.5">Thứ tự hiển thị</label>
                    <input asp-for="Position" type="number" min="0"
                           class="w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-transparent transition" />
                    <span asp-validation-for="Position" class="text-xs text-red-500 mt-1 block"></span>
                </div>
            </div>
        </div>

        @* Trạng thái *@
        <div class="bg-white rounded-2xl border border-slate-200 p-5">
            <h3 class="text-sm font-semibold text-slate-700 mb-4">Trạng thái</h3>

            <label class="flex items-center gap-3 cursor-pointer group">
                <div class="relative">
                    <input asp-for="IsActive" type="checkbox" id="isActiveToggle" class="sr-only peer" />
                    <div class="w-10 h-6 bg-slate-200 rounded-full peer-checked:bg-brand-500 transition-colors"></div>
                    <div class="absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow transition-transform peer-checked:translate-x-4"></div>
                </div>
                <span class="text-sm text-slate-700 group-hover:text-slate-900">
                    Hiển thị danh mục
                </span>
            </label>
            <p class="text-xs text-slate-400 mt-2">Bật để hiện danh mục này trên cửa hàng.</p>
        </div>

        @* Nút lưu *@
        <div class="bg-white rounded-2xl border border-slate-200 p-5 space-y-3">
            <button type="submit"
                    class="w-full flex items-center justify-center gap-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold px-4 py-2.5 rounded-xl transition-colors">
                <i data-lucide="save" class="w-4 h-4"></i>
                Lưu danh mục
            </button>
            <a asp-action="Index"
               class="w-full flex items-center justify-center gap-2 border border-slate-200 hover:bg-slate-50 text-slate-700 text-sm font-medium px-4 py-2.5 rounded-xl transition-colors">
                Huỷ bỏ
            </a>
        </div>
    </div>
</div>
