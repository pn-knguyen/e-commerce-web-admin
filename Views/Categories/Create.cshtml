@model e_commerce_web_admin.ViewModels.Categories.CategoryFormViewModel
@{
    ViewData["Title"] = "Thêm danh mục";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/categories.css" asp-append-version="true" />
}

@* ── Breadcrumb + Header ── *@
<div class="mb-6 cat-anim" style="animation-delay:0.05s">
    <nav class="flex items-center gap-2 text-xs text-slate-400 mb-2">
        <a asp-action="Index" class="hover:text-brand-600 transition-colors">Danh mục</a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <span class="text-slate-600 font-medium">Thêm mới</span>
    </nav>
    <h1 class="text-2xl font-bold text-slate-800">Thêm danh mục mới</h1>
    <p class="text-slate-500 text-sm mt-0.5">Điền đầy đủ thông tin để tạo danh mục sản phẩm</p>
</div>

@* ── Form ── *@
<form asp-action="Create" method="post" enctype="multipart/form-data" class="cat-anim" style="animation-delay:0.12s">
    @Html.AntiForgeryToken()
    <partial name="_Form" model="Model" />
</form>

@section Scripts {
    <script src="~/js/categories.js" asp-append-version="true"></script>
}
