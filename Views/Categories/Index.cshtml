@model e_commerce_web_admin.ViewModels.Categories.CategoryIndexViewModel
@{
    ViewData["Title"] = "Danh mục sản phẩm";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/categories.css" asp-append-version="true" />
}

@* ── Header ── *@
<div class="mb-6 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 cat-anim" style="animation-delay:0.04s">
    <div>
        <div class="flex items-center gap-2 mb-1">
            <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-teal-400 to-teal-600 flex items-center justify-center shadow-sm">
                <i data-lucide="folder-tree" class="w-4 h-4 text-white"></i>
            </div>
            <h1 class="text-2xl font-bold text-slate-800">Danh mục sản phẩm</h1>
        </div>
        <p class="text-slate-500 text-sm">Quản lý cây phân cấp danh mục của cửa hàng</p>
    </div>
    <a asp-action="Create"
       class="inline-flex items-center gap-2 bg-gradient-to-r from-teal-500 to-teal-600 hover:from-teal-600 hover:to-teal-700
              text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-all shadow-sm hover:shadow-md hover:-translate-y-0.5">
        <i data-lucide="plus" class="w-4 h-4"></i>
        Thêm danh mục
    </a>
</div>

@* ── Toast messages ── *@
@if (TempData["Success"] != null)
{
    <div id="toastSuccess"
         class="mb-4 flex items-center gap-3 bg-emerald-50 border border-emerald-200 text-emerald-700 rounded-xl px-4 py-3 text-sm shadow-sm cat-anim"
         style="animation-delay:0.04s">
        <div class="w-7 h-7 rounded-full bg-emerald-100 flex items-center justify-center flex-shrink-0">
            <i data-lucide="check" class="w-4 h-4 text-emerald-600"></i>
        </div>
        <span class="flex-1">@TempData["Success"]</span>
        <button type="button"
                data-dismiss-target="toastSuccess"
                class="text-emerald-400 hover:text-emerald-600 transition-colors">
            <i data-lucide="x" class="w-4 h-4"></i>
        </button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div id="toastError"
         class="mb-4 flex items-center gap-3 bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3 text-sm shadow-sm cat-anim"
         style="animation-delay:0.04s">
        <div class="w-7 h-7 rounded-full bg-red-100 flex items-center justify-center flex-shrink-0">
            <i data-lucide="alert-circle" class="w-4 h-4 text-red-500"></i>
        </div>
        <span class="flex-1">@TempData["Error"]</span>
        <button type="button"
                data-dismiss-target="toastError"
                class="text-red-400 hover:text-red-600 transition-colors">
            <i data-lucide="x" class="w-4 h-4"></i>
        </button>
    </div>
}

@* ── Stats cards ── *@
<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-5 cat-anim" style="animation-delay:0.1s">
    <div class="bg-white rounded-2xl border border-slate-100 p-4 flex items-center gap-3 shadow-sm">
        <div class="w-10 h-10 rounded-xl bg-teal-50 flex items-center justify-center flex-shrink-0">
            <i data-lucide="folders" class="w-5 h-5 text-teal-500"></i>
        </div>
        <div>
            <p class="text-xl font-bold text-slate-800">@Model.TotalCount</p>
            <p class="text-xs text-slate-400">Tổng danh mục</p>
        </div>
    </div>
    <div class="bg-white rounded-2xl border border-slate-100 p-4 flex items-center gap-3 shadow-sm">
        <div class="w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center flex-shrink-0">
            <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-500"></i>
        </div>
        <div>
            <p class="text-xl font-bold text-emerald-600">@Model.ActiveCount</p>
            <p class="text-xs text-slate-400">Hoạt động</p>
        </div>
    </div>
    <div class="bg-white rounded-2xl border border-slate-100 p-4 flex items-center gap-3 shadow-sm">
        <div class="w-10 h-10 rounded-xl bg-slate-100 flex items-center justify-center flex-shrink-0">
            <i data-lucide="eye-off" class="w-5 h-5 text-slate-400"></i>
        </div>
        <div>
            <p class="text-xl font-bold text-slate-500">@Model.InactiveCount</p>
            <p class="text-xs text-slate-400">Đã tắt</p>
        </div>
    </div>
    <div class="bg-white rounded-2xl border border-slate-100 p-4 flex items-center gap-3 shadow-sm">
        <div class="w-10 h-10 rounded-xl bg-teal-50 flex items-center justify-center flex-shrink-0">
            <i data-lucide="package" class="w-5 h-5 text-teal-500"></i>
        </div>
        <div>
            <p class="text-xl font-bold text-teal-600">@Model.TotalProductCount</p>
            <p class="text-xs text-slate-400">Sản phẩm</p>
        </div>
    </div>
</div>

@* ── Filter bar ── *@
<div class="bg-white rounded-2xl border border-slate-100 p-4 mb-4 shadow-sm cat-anim" style="animation-delay:0.15s">
    <form method="get" asp-action="Index" class="flex flex-col sm:flex-row gap-3">
        <div class="relative flex-1">
            <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 pointer-events-none"></i>
            <input type="text" name="search" value="@Model.Search"
                   placeholder="Tìm theo tên hoặc slug..."
                   class="w-full pl-9 pr-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-700
                          focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition" />
        </div>
        <select name="status"
                class="border border-slate-200 rounded-xl px-4 py-2.5 text-sm text-slate-700 bg-white
                       focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition">
            <option value="" selected="@(string.IsNullOrEmpty(Model.Status))">Tất cả</option>
            <option value="active"   selected="@(Model.Status == "active")">Đang hoạt động</option>
            <option value="inactive" selected="@(Model.Status == "inactive")">Đã tắt</option>
        </select>
        <button type="submit"
                class="inline-flex items-center justify-center gap-2 bg-teal-600 hover:bg-teal-700
                       text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors">
            <i data-lucide="search" class="w-4 h-4"></i>
            Tìm kiếm
        </button>
        @if (!string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.Status))
        {
            <a asp-action="Index"
               class="inline-flex items-center gap-1.5 text-slate-500 hover:text-slate-700 text-sm px-2 transition-colors">
                <i data-lucide="x-circle" class="w-4 h-4"></i>
                Xoá lọc
            </a>
        }
    </form>
</div>

@* ── Tree Table ── *@
<div class="bg-white rounded-2xl border border-slate-100 overflow-hidden shadow-sm cat-anim" style="animation-delay:0.2s">

    @if (!Model.Categories.Any())
    {
        <div class="py-24 text-center">
            <div class="w-20 h-20 rounded-3xl bg-gradient-to-br from-teal-100 to-teal-50
                        flex items-center justify-center mx-auto mb-5 shadow-sm">
                <i data-lucide="folder-open" class="w-10 h-10 text-teal-300"></i>
            </div>
            <p class="text-slate-600 font-semibold text-lg">Không tìm thấy danh mục</p>
            <p class="text-slate-400 text-sm mt-2">
                @if (!string.IsNullOrEmpty(Model.Search))
                {<span>Thử từ khoá khác hoặc <a asp-action="Index" class="text-teal-600 hover:underline">xoá bộ lọc</a></span>}
                else
                {<span>Nhấn <strong class="text-slate-600">Thêm danh mục</strong> để bắt đầu</span>}
            </p>
        </div>
    }
    else
    {
        @* Table header *@
        <div class="px-6 py-3.5 bg-gradient-to-r from-slate-50 to-slate-50/50 border-b border-slate-100
                    grid grid-cols-[1fr_auto_auto_auto_auto] gap-4 items-center">
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Danh mục</span>
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider text-center w-20">Thứ tự</span>
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider text-center w-24">Sản phẩm</span>
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider text-center w-28">Trạng thái</span>
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider text-right w-32">Thao tác</span>
        </div>

        @* Rows *@
        <div class="divide-y divide-slate-50">
            @foreach (var cat in Model.Categories)
            {
                bool isParent = cat.Depth == 0;
                <div class="cat-row @(isParent ? "cat-row-parent" : "cat-row-child")
                            grid grid-cols-[1fr_auto_auto_auto_auto] gap-4 items-center
                            px-6 @(isParent ? "py-4" : "py-3") @(isParent ? "" : "bg-slate-50/40")"
                     data-id="@cat.Id">

                    @* ─ Tên + slug (với thụt lề theo cấp) ─ *@
                    <div class="flex items-center gap-0 min-w-0">
                        @* Thụt lề cho từng cấp *@
                        @for (int d = 0; d < cat.Depth; d++)
                        {
                            <span class="w-6 flex-shrink-0 self-stretch relative">
                                <span class="absolute left-3 top-0 bottom-0 w-px bg-slate-200"></span>
                            </span>
                        }

                        @if (cat.Depth > 0)
                        {
                            @* Connector L-shape *@
                            <span class="w-5 flex-shrink-0 self-center relative mr-1">
                                <span class="absolute left-0 top-0 bottom-1/2 w-px bg-slate-200"></span>
                                <span class="absolute left-0 top-1/2 w-4 h-px bg-slate-200"></span>
                            </span>
                        }

                        <div data-category-image-wrapper
                             class="category-thumb w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 mr-3
                                    @(isParent ? "bg-teal-50" : "bg-slate-100")">
                            <div class="category-thumb-fallback">
                                @if (isParent)
                                {
                                    <i data-lucide="@(cat.ChildCount > 0 ? "folder" : "folder-open")"
                                       class="w-4 h-4 text-teal-500"></i>
                                }
                                else
                                {
                                    <i data-lucide="tag" class="w-3.5 h-3.5 text-slate-400"></i>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(cat.ImagePath))
                            {
                                <img src="@cat.ImagePath"
                                     alt="@cat.Name"
                                     loading="lazy"
                                     decoding="async"
                                     data-category-image
                                     class="category-thumb-img" />
                            }
                        </div>

                        <div class="min-w-0">
                            @if (isParent)
                            {
                                <p class="font-bold text-slate-800 text-[15px] truncate leading-tight">
                                    @cat.Name
                                </p>
                                <p class="text-[11px] text-teal-600/70 font-mono truncate mt-0.5">/categories/@cat.Slug</p>
                            }
                            else
                            {
                                <p class="font-medium text-slate-600 text-sm truncate">@cat.Name</p>
                                <p class="text-[11px] text-slate-400 font-mono truncate">/categories/@cat.Slug</p>
                            }
                        </div>
                    </div>

                    @* ─ Thứ tự ─ *@
                    <div class="w-20 text-center">
                        <span class="inline-block text-xs font-semibold rounded-lg px-2.5 py-1
                                     @(isParent ? "text-teal-700 bg-teal-50" : "text-slate-500 bg-slate-100")">
                            @cat.Position
                        </span>
                    </div>

                    @* ─ Số sản phẩm ─ *@
                    <div class="w-24 text-center">
                        @if (isParent)
                        {
                            @* Cha: tổng gồm cả con → màu amber nổi bật *@
                            <span class="inline-flex items-center justify-center gap-1 text-xs font-bold rounded-full px-2.5 py-1.5
                                         @(cat.ProductCount > 0 ? "bg-amber-100 text-amber-700 ring-1 ring-amber-200" : "bg-slate-100 text-slate-400")"
                                  title="@(cat.ChildCount > 0 ? $"Tổng {cat.ProductCount} sản phẩm (gồm cả danh mục con)" : $"{cat.ProductCount} sản phẩm")">
                                <i data-lucide="layers" class="w-3 h-3"></i>
                                @cat.ProductCount
                            </span>
                        }
                        else
                        {
                            @* Con: chỉ sản phẩm trực tiếp → màu teal nhỏ hơn *@
                            <span class="inline-flex items-center justify-center gap-1 text-xs font-semibold rounded-full px-2 py-1
                                         @(cat.ProductCount > 0 ? "bg-teal-100 text-teal-700" : "bg-slate-100 text-slate-400")">
                                <i data-lucide="package" class="w-3 h-3"></i>
                                @cat.ProductCount
                            </span>
                        }
                    </div>

                    @* ─ Trạng thái toggle ─ *@
                    <div class="w-28 text-center">
                        <button type="button"
                                data-category-toggle
                                data-category-id="@cat.Id"
                                class="badge-active inline-flex items-center gap-1.5 text-xs font-semibold
                                       px-3 py-1.5 rounded-full cursor-pointer transition-all duration-200
                                       @(cat.IsActive
                                           ? "bg-emerald-100 text-emerald-700 hover:bg-emerald-200"
                                           : "bg-slate-100 text-slate-500 hover:bg-slate-200")"
                                data-active="@cat.IsActive.ToString().ToLower()">
                            <span class="dot w-1.5 h-1.5 rounded-full flex-shrink-0
                                         @(cat.IsActive ? "bg-emerald-500" : "bg-slate-400")"></span>
                            <span class="status-label">@(cat.IsActive ? "Bật" : "Tắt")</span>
                        </button>
                    </div>

                    @* ─ Action buttons (luôn hiển thị) ─ *@
                    <div class="w-32 flex items-center justify-end gap-1.5">
                        <a asp-action="Edit" asp-route-id="@cat.Id"
                           title="Chỉnh sửa"
                           class="inline-flex items-center gap-1.5 text-xs font-medium
                                  bg-teal-50 hover:bg-teal-100 text-teal-600
                                  px-2.5 py-1.5 rounded-lg transition-colors">
                            <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
                            Sửa
                        </a>

                        <form asp-action="Delete"
                              asp-route-id="@cat.Id"
                              method="post"
                              data-category-delete
                              data-category-name="@cat.Name"
                              data-product-count="@cat.ProductCount"
                              data-child-count="@cat.ChildCount">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    title="Xoá"
                                    class="inline-flex items-center gap-1.5 text-xs font-medium
                                           bg-red-50 hover:bg-red-100 text-red-500
                                           px-2.5 py-1.5 rounded-lg transition-colors">
                                <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                                Xoá
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>

        @* ── Pagination ── *@
        @if (Model.TotalPages > 1)
        {
            <div class="px-6 py-4 border-t border-slate-100 flex items-center justify-between bg-slate-50/50">
                <p class="text-xs text-slate-400">
                    Trang <span class="font-semibold text-slate-600">@Model.Page</span> / @Model.TotalPages
                    &nbsp;·&nbsp;
                    <span class="font-semibold text-slate-600">@Model.TotalCount</span> danh mục
                </p>
                <div class="flex items-center gap-1">
                    @if (Model.HasPrev)
                    {
                        <a asp-action="Index" asp-route-page="@(Model.Page - 1)"
                           asp-route-search="@Model.Search" asp-route-status="@Model.Status"
                           class="w-8 h-8 rounded-lg border border-slate-200 bg-white hover:bg-slate-50
                                  flex items-center justify-center text-slate-600 transition-colors shadow-sm">
                            <i data-lucide="chevron-left" class="w-4 h-4"></i>
                        </a>
                    }
                    @for (int p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.TotalPages, Model.Page + 2); p++)
                    {
                        <a asp-action="Index" asp-route-page="@p"
                           asp-route-search="@Model.Search" asp-route-status="@Model.Status"
                           class="w-8 h-8 rounded-lg text-xs font-semibold flex items-center justify-center transition-all
                                  @(p == Model.Page
                                      ? "bg-gradient-to-b from-teal-500 to-teal-600 text-white shadow-sm"
                                      : "border border-slate-200 bg-white text-slate-600 hover:bg-slate-50")">
                            @p
                        </a>
                    }
                    @if (Model.HasNext)
                    {
                        <a asp-action="Index" asp-route-page="@(Model.Page + 1)"
                           asp-route-search="@Model.Search" asp-route-status="@Model.Status"
                           class="w-8 h-8 rounded-lg border border-slate-200 bg-white hover:bg-slate-50
                                  flex items-center justify-center text-slate-600 transition-colors shadow-sm">
                            <i data-lucide="chevron-right" class="w-4 h-4"></i>
                        </a>
                    }
                </div>
            </div>
        }
    }
</div>

@section Scripts {
    <script src="~/js/categories.js" asp-append-version="true"></script>
}
