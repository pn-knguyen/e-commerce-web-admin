@model e_commerce_web_admin.ViewModels.Vouchers.VoucherFormViewModel

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-5">
        <div class="bg-white rounded-2xl border border-slate-200 p-5">
            <h3 class="text-sm font-semibold text-slate-700 mb-4">Thông tin voucher</h3>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label asp-for="Code" class="block text-xs font-semibold text-slate-600 mb-1.5">
                        Mã voucher <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="Code" id="voucherCode"
                           autocomplete="off"
                           class="w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-800 font-mono uppercase
                                  focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition"
                           placeholder="SUMMER2026" />
                    <span asp-validation-for="Code" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="DiscountType" class="block text-xs font-semibold text-slate-600 mb-1.5">
                        Loại giảm giá
                    </label>
                    <select asp-for="DiscountType" id="discountType"
                            class="w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-800 bg-white
                                   focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition">
                        @foreach (var option in Model.DiscountTypeOptions)
                        {
                            <option value="@option.Value" selected="@(Model.DiscountType.ToString() == option.Value)">@option.Label</option>
                        }
                    </select>
                    <span asp-validation-for="DiscountType" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="DiscountValue" class="block text-xs font-semibold text-slate-600 mb-1.5">
                        Giá trị giảm <span class="text-red-500">*</span>
                    </label>
                    <div class="relative">
                        <input asp-for="DiscountValue" id="discountValue" type="number" min="0" step="1000"
                               class="w-full border border-slate-200 rounded-xl px-3.5 pr-12 py-2.5 text-sm text-slate-800
                                      focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition" />
                        <span id="discountUnit" class="absolute right-3.5 top-1/2 -translate-y-1/2 text-xs font-semibold text-slate-400">đ</span>
                    </div>
                    <span asp-validation-for="DiscountValue" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="MaxDiscountValue" class="block text-xs font-semibold text-slate-600 mb-1.5">
                        Mức giảm tối đa
                    </label>
                    <div class="relative">
                        <input asp-for="MaxDiscountValue" type="number" min="0" step="1000"
                               class="w-full border border-slate-200 rounded-xl px-3.5 pr-12 py-2.5 text-sm text-slate-800
                                      focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition" />
                        <span class="absolute right-3.5 top-1/2 -translate-y-1/2 text-xs font-semibold text-slate-400">đ</span>
                    </div>
                    <span asp-validation-for="MaxDiscountValue" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                <div class="md:col-span-2">
                    <label asp-for="Description" class="block text-xs font-semibold text-slate-600 mb-1.5">Mô tả</label>
                    <textarea asp-for="Description" rows="3"
                              class="w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-800
                                     focus:outline-none focus:ring-2 focus:ring-sky-400 focus:border-transparent transition resize-none"
                              placeholder="Mô tả ngắn về voucher..."></textarea>
                    <span asp-validation-for="Description" class="text-xs text-red-500 mt-1 block"></span>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 p-5">
            <h3 class="text-sm font-semibold text-slate-700 mb-4">Điều kiện áp dụng</h3>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label asp-for="MinOrderValue" class="block text-xs font-semibold text-slate-600 mb-1.5">
                        Đơn tối thiểu
                    </label>
                    <div class="relative">
                        <input asp-for="MinOrderValue" type="number" min="0" step="1000"
                               class="w-full border border-slate-200 rounded-xl px-3.5 pr-12 py-2.5 text-sm text-slate-800
                                      focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition" />
                        <span class="absolute right-3.5 top-1/2 -translate-y-1/2 text-xs font-semibold text-slate-400">đ</span>
                    </div>
                    <span asp-validation-for="MinOrderValue" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="MaxUses" class="block text-xs font-semibold text-slate-600 mb-1.5">
                        Tổng lượt dùng
                    </label>
                    <input asp-for="MaxUses" type="number" min="1"
                           class="w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-800
                                  focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition"
                           placeholder="Không giới hạn" />
                    <span asp-validation-for="MaxUses" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="MaxUsesPerUser" class="block text-xs font-semibold text-slate-600 mb-1.5">
                        Lượt dùng mỗi khách
                    </label>
                    <input asp-for="MaxUsesPerUser" type="number" min="1"
                           class="w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-800
                                  focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition"
                           placeholder="Không giới hạn" />
                    <span asp-validation-for="MaxUsesPerUser" class="text-xs text-red-500 mt-1 block"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="space-y-5">
        <div class="bg-white rounded-2xl border border-slate-200 p-5">
            <h3 class="text-sm font-semibold text-slate-700 mb-4">Thời gian</h3>

            <div class="space-y-4">
                <div>
                    <label asp-for="StartDate" class="block text-xs font-semibold text-slate-600 mb-1.5">
                        Bắt đầu <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="StartDate" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}"
                           class="w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-800
                                  focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition" />
                    <span asp-validation-for="StartDate" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="EndDate" class="block text-xs font-semibold text-slate-600 mb-1.5">
                        Kết thúc <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="EndDate" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}"
                           class="w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-800
                                  focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition" />
                    <span asp-validation-for="EndDate" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="Priority" class="block text-xs font-semibold text-slate-600 mb-1.5">Độ ưu tiên</label>
                    <input asp-for="Priority" type="number" min="0" max="9999"
                           class="w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-800
                                  focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent transition" />
                    <span asp-validation-for="Priority" class="text-xs text-red-500 mt-1 block"></span>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 p-5">
            <h3 class="text-sm font-semibold text-slate-700 mb-4">Trạng thái</h3>

            <label class="flex items-center gap-3 cursor-pointer group">
                <div class="relative">
                    <input asp-for="IsActive" type="checkbox" id="isActiveToggle" class="sr-only peer" />
                    <div class="w-10 h-6 bg-slate-200 rounded-full peer-checked:bg-teal-500 transition-colors"></div>
                    <div class="absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow transition-transform peer-checked:translate-x-4"></div>
                </div>
                <span class="text-sm text-slate-700 group-hover:text-slate-900">Bật voucher</span>
            </label>
            <p class="text-xs text-slate-400 mt-2">Voucher chỉ có hiệu lực khi được bật và nằm trong thời gian áp dụng.</p>
        </div>

        @if (Model.Id > 0)
        {
            <div class="bg-white rounded-2xl border border-slate-200 p-5">
                <h3 class="text-sm font-semibold text-slate-700 mb-4">Sử dụng</h3>
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-sky-50 flex items-center justify-center">
                        <i data-lucide="receipt-text" class="w-5 h-5 text-sky-500"></i>
                    </div>
                    <div>
                        <p class="text-xl font-bold text-slate-800">@Model.UsedCount</p>
                        <p class="text-xs text-slate-400">Lượt đã dùng</p>
                    </div>
                </div>
            </div>
        }

        <div class="bg-white rounded-2xl border border-slate-200 p-5 space-y-3">
            <button type="submit"
                    class="w-full flex items-center justify-center gap-2
                           bg-gradient-to-r from-teal-500 to-teal-600 hover:from-teal-600 hover:to-teal-700
                           text-white text-sm font-semibold px-4 py-2.5 rounded-xl transition-all shadow-sm hover:shadow-md">
                <i data-lucide="save" class="w-4 h-4"></i>
                Lưu voucher
            </button>
            <a asp-action="Index"
               class="w-full flex items-center justify-center gap-2 border border-slate-200 hover:bg-slate-50
                      text-slate-700 text-sm font-medium px-4 py-2.5 rounded-xl transition-colors">
                Huỷ bỏ
            </a>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="bg-red-50 border border-red-200 rounded-2xl p-4">
                <div class="flex items-center gap-2 mb-2">
                    <i data-lucide="alert-triangle" class="w-4 h-4 text-red-500"></i>
                    <p class="text-sm font-semibold text-red-700">Vui lòng kiểm tra lại</p>
                </div>
                <div asp-validation-summary="ModelOnly" class="text-xs text-red-600 space-y-1"></div>
            </div>
        }
    </div>
</div>
