@model e_commerce_web_admin.ViewModels.Vouchers.VoucherFormViewModel

<div class="surface-form-grid surface-form-card voucher-editor-shell">
    <header class="voucher-editor-header">
        <div class="voucher-editor-heading">
            <span class="voucher-editor-heading-icon" aria-hidden="true">
                <i data-lucide="ticket-percent" class="w-5 h-5"></i>
            </span>
            <div>
                <h2>Thiết lập voucher</h2>
                <p>Quản lý mức giảm, giới hạn sử dụng và thời gian áp dụng trong cùng một biểu mẫu.</p>
            </div>
        </div>

        <div data-surface-form-alert
             class="surface-form-alert @(ViewData.ModelState.IsValid ? "hidden" : "")">
            <i data-lucide="alert-triangle" class="w-4 h-4"></i>
            <div>
                <p>Vui lòng kiểm tra lại thông tin.</p>
                <div asp-validation-summary="ModelOnly"></div>
            </div>
        </div>
    </header>

    <div class="voucher-editor-body">
        <div class="voucher-editor-main">
            <section class="voucher-editor-section" aria-labelledby="voucherInfoTitle">
                <div class="voucher-editor-section-title">
                    <span class="voucher-editor-step">01</span>
                    <div>
                        <h3 id="voucherInfoTitle">Thông tin voucher</h3>
                        <p>Thiết lập mã và giá trị ưu đãi khách hàng sẽ nhận được.</p>
                    </div>
                </div>

                <div class="voucher-editor-field-grid">
                    <div class="voucher-editor-field">
                        <label asp-for="Code">
                            Mã voucher <span class="text-red-500">*</span>
                        </label>
                        <input asp-for="Code"
                               id="voucherCode"
                               autocomplete="off"
                               maxlength="@Model.CodeInputMaxLength"
                               class="voucher-code-input"
                               placeholder="SUMMER2026" />
                        <span asp-validation-for="Code" class="text-xs text-red-500 mt-1 block"></span>
                    </div>

                    <div class="voucher-editor-field">
                        <label asp-for="DiscountType">Loại giảm giá</label>
                        <select asp-for="DiscountType" id="discountType">
                            @foreach (var option in Model.DiscountTypeOptions)
                            {
                                <option value="@option.Value" selected="@(Model.DiscountType.ToString() == option.Value)">
                                    @option.Label
                                </option>
                            }
                        </select>
                        <span asp-validation-for="DiscountType" class="text-xs text-red-500 mt-1 block"></span>
                    </div>

                    <div class="voucher-editor-field">
                        <label asp-for="DiscountValue">
                            Giá trị giảm <span class="text-red-500">*</span>
                        </label>
                        <div class="voucher-money-control">
                            <input asp-for="DiscountValue"
                                   id="discountValue"
                                   type="number"
                                   min="0.01"
                                   step="1000"
                                   inputmode="decimal" />
                            <span id="discountUnit">đ</span>
                        </div>
                        <span asp-validation-for="DiscountValue" class="text-xs text-red-500 mt-1 block"></span>
                    </div>

                    <div class="voucher-editor-field">
                        <label asp-for="MaxDiscountValue">
                            Mức giảm tối đa
                            <span class="voucher-field-hint">Có thể để trống</span>
                        </label>
                        <div class="voucher-money-control">
                            <input asp-for="MaxDiscountValue"
                                   type="number"
                                   min="0.01"
                                   step="1000"
                                   inputmode="decimal" />
                            <span>đ</span>
                        </div>
                        <span asp-validation-for="MaxDiscountValue" class="text-xs text-red-500 mt-1 block"></span>
                    </div>

                    <div class="voucher-editor-field voucher-editor-field-wide">
                        <label asp-for="Description">
                            Mô tả
                            <span class="voucher-field-hint">Tối đa 1000 ký tự</span>
                        </label>
                        <textarea asp-for="Description" rows="4"
                                  placeholder="Mô tả ngắn về voucher..."></textarea>
                        <span asp-validation-for="Description" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                </div>
            </section>

            <section class="voucher-editor-section" aria-labelledby="voucherConditionTitle">
                <div class="voucher-editor-section-title">
                    <span class="voucher-editor-step">02</span>
                    <div>
                        <h3 id="voucherConditionTitle">Điều kiện áp dụng</h3>
                        <p>Giới hạn giá trị đơn hàng và số lần mỗi voucher được sử dụng.</p>
                    </div>
                </div>

                <div class="voucher-condition-grid">
                    <div class="voucher-editor-field">
                        <label asp-for="MinOrderValue">Đơn tối thiểu</label>
                        <div class="voucher-money-control">
                            <input asp-for="MinOrderValue"
                                   type="number"
                                   min="0"
                                   step="1000"
                                   inputmode="decimal" />
                            <span>đ</span>
                        </div>
                        <span asp-validation-for="MinOrderValue" class="text-xs text-red-500 mt-1 block"></span>
                    </div>

                    <div class="voucher-editor-field">
                        <label asp-for="MaxUses">
                            Tổng lượt dùng
                            <span class="voucher-field-hint">Không giới hạn nếu trống</span>
                        </label>
                        <input asp-for="MaxUses" type="number" min="1" inputmode="numeric"
                               placeholder="Không giới hạn" />
                        <span asp-validation-for="MaxUses" class="text-xs text-red-500 mt-1 block"></span>
                    </div>

                    <div class="voucher-editor-field">
                        <label asp-for="MaxUsesPerUser">
                            Lượt dùng mỗi khách
                            <span class="voucher-field-hint">Không giới hạn nếu trống</span>
                        </label>
                        <input asp-for="MaxUsesPerUser" type="number" min="1" inputmode="numeric"
                               placeholder="Không giới hạn" />
                        <span asp-validation-for="MaxUsesPerUser" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                </div>
            </section>
        </div>

        <aside class="voucher-editor-side" aria-label="Thời gian và trạng thái voucher">
            <section class="voucher-editor-section" aria-labelledby="voucherTimeTitle">
                <div class="voucher-editor-section-title">
                    <span class="voucher-editor-step">03</span>
                    <div>
                        <h3 id="voucherTimeTitle">Thời gian áp dụng</h3>
                        <p>Xác định thời điểm voucher bắt đầu và kết thúc hiệu lực.</p>
                    </div>
                </div>

                <div class="voucher-time-grid">
                    <div class="voucher-editor-field">
                        <label asp-for="StartDate">
                            Bắt đầu <span class="text-red-500">*</span>
                        </label>
                        <input asp-for="StartDate"
                               type="datetime-local"
                               asp-format="{0:yyyy-MM-ddTHH:mm}" />
                        <span asp-validation-for="StartDate" class="text-xs text-red-500 mt-1 block"></span>
                    </div>

                    <div class="voucher-editor-field">
                        <label asp-for="EndDate">
                            Kết thúc <span class="text-red-500">*</span>
                        </label>
                        <input asp-for="EndDate"
                               type="datetime-local"
                               asp-format="{0:yyyy-MM-ddTHH:mm}" />
                        <span asp-validation-for="EndDate" class="text-xs text-red-500 mt-1 block"></span>
                    </div>

                    <div class="voucher-editor-field">
                        <label asp-for="Priority">
                            Độ ưu tiên
                            <span class="voucher-field-hint">Từ 0 đến 9999</span>
                        </label>
                        <input asp-for="Priority"
                               type="number"
                               min="0"
                               max="9999"
                               inputmode="numeric" />
                        <span asp-validation-for="Priority" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                </div>
            </section>

            <section class="voucher-editor-section voucher-editor-status" aria-labelledby="voucherStatusTitle">
                <div class="voucher-status-copy">
                    <span class="voucher-status-icon" aria-hidden="true">
                        <i data-lucide="badge-check" class="w-4 h-4"></i>
                    </span>
                    <div>
                        <h3 id="voucherStatusTitle">Bật voucher</h3>
                        <p>Voucher chỉ có hiệu lực khi được bật và nằm trong thời gian áp dụng.</p>
                    </div>
                </div>

                <label class="voucher-status-switch" for="isActiveToggle">
                    <input asp-for="IsActive" type="checkbox" id="isActiveToggle" />
                    <span class="voucher-status-track" aria-hidden="true"></span>
                    <span class="sr-only">Thay đổi trạng thái voucher</span>
                </label>
            </section>

            @if (Model.Id > 0)
            {
                <section class="voucher-editor-section voucher-usage" aria-labelledby="voucherUsageTitle">
                    <span class="voucher-usage-icon" aria-hidden="true">
                        <i data-lucide="receipt-text" class="w-5 h-5"></i>
                    </span>
                    <div>
                        <h3 id="voucherUsageTitle">Lượt đã sử dụng</h3>
                        <strong>@Model.UsedCount</strong>
                        <p>Dữ liệu sử dụng thực tế của voucher.</p>
                    </div>
                </section>
            }
        </aside>
    </div>

    <footer class="voucher-editor-actions">
        <a asp-action="Index" class="surface-cancel-link">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
            Quay lại
        </a>
        <button type="submit" class="voucher-submit-button">
            <i data-lucide="save" class="w-4 h-4"></i>
            Lưu voucher
        </button>
    </footer>
</div>
