@model e_commerce_web_admin.ViewModels.Orders.OrderDetailsViewModel
@using System.Globalization
@using e_commerce_web_admin.Models.Enums
@using e_commerce_web_admin.ViewModels.Orders
@using e_commerce_web_admin.ViewModels.Shipments
@{
    ViewData["Title"] = $"Đơn hàng {Model.OrderCode}";
    Layout = "_Layout";

    var vi = CultureInfo.GetCultureInfo("vi-VN");
    string Money(decimal value) => string.Concat(value.ToString("N0", vi), " đ");
    string DateText(DateTime value) => value.ToLocalTime().ToString("dd/MM/yyyy HH:mm", vi);
    string DateTextNullable(DateTime? value) => value.HasValue ? DateText(value.Value) : "Chưa cập nhật";
    var selectedOrderStatus = Model.StatusForm.OrderStatus.ToString();
    var selectedPaymentStatus = Model.StatusForm.PaymentStatus.ToString();
    var shipmentPanel = Model.ShipmentPanel;
    var currentShipment = shipmentPanel.CurrentShipment;
    var canShipOrderStatus = Model.StatusForm.OrderStatus is OrderStatus.Confirmed or OrderStatus.Processing;
    var canStartShipping = canShipOrderStatus && (currentShipment is null || currentShipment.Status is ShipmentStatus.Cancelled or ShipmentStatus.Failed);
    var canCreateQuote = shipmentPanel.IsProviderConfigured
        && shipmentPanel.HasFulfillmentLocations
        && canStartShipping;
    var showShipmentHistory = shipmentPanel.ShipmentHistory.Count > 0 &&
        (shipmentPanel.ShipmentHistory.Count > 1 ||
            shipmentPanel.ShipmentHistory.Any(item => item.Status == ShipmentStatus.Cancelled || item.CancelledAt.HasValue));
    var splitShippingHistory = currentShipment is not null && showShipmentHistory;
}

@section Styles {
    <link rel="stylesheet" href="~/css/orders.css" asp-append-version="true" />
}

<main class="order-page order-detail-page">
    <section class="order-hero order-anim" style="animation-delay:0.04s">
        <div>
            <nav class="order-breadcrumb" aria-label="Điều hướng">
                <a asp-action="Index">Quản lý đơn hàng</a>
                <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
                <span>@Model.OrderCode</span>
            </nav>
            <div class="order-title-row">
                <div>
                    <h1>@Model.OrderCode</h1>
                    <p>Tạo lúc @DateText(Model.CreatedAt) · Cập nhật @DateTextNullable(Model.UpdatedAt)</p>
                </div>
                <a asp-action="Index" class="order-secondary-action">
                    <i data-lucide="arrow-left" class="w-4 h-4"></i>
                    <span>Danh sách</span>
                </a>
            </div>
        </div>
    </section>

    @if (TempData["Success"] != null)
    {
        <div id="toastSuccess" class="order-flash order-flash-success order-anim" style="animation-delay:0.06s">
            <span class="order-flash-icon">
                <i data-lucide="check" class="w-4 h-4"></i>
            </span>
            <span>@TempData["Success"]</span>
            <button type="button" data-dismiss-target="toastSuccess" aria-label="Đóng thông báo">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div id="toastError" class="order-flash order-flash-error order-anim" style="animation-delay:0.06s">
            <span class="order-flash-icon">
                <i data-lucide="alert-circle" class="w-4 h-4"></i>
            </span>
            <span>@TempData["Error"]</span>
            <button type="button" data-dismiss-target="toastError" aria-label="Dong thong bao">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>
    }

    <section class="order-detail-grid order-form-unified">
        <div class="order-detail-main">
            <section class="order-panel order-section-items order-anim" style="animation-delay:0.08s">
                <header class="order-panel-header">
                    <span class="order-panel-icon">
                        <i data-lucide="shopping-cart" class="w-5 h-5"></i>
                    </span>
                    <div>
                        <h2>Sản phẩm trong đơn</h2>
                        <p>@Model.TotalQuantity sản phẩm từ @Model.Items.Count dòng hàng</p>
                    </div>
                </header>

                <div class="order-items-table">
                    <div class="order-items-head">
                        <span>Sản phẩm</span>
                        <span class="text-center">SL</span>
                        <span class="text-right">Đơn giá</span>
                        <span class="text-right">Giá vốn</span>
                        <span class="text-right">Thành tiền</span>
                        <span class="text-right">Lãi gộp</span>
                    </div>
                    @foreach (var item in Model.Items)
                    {
                        <article class="order-item-row">
                            <div>
                                <h3>@item.ProductName</h3>
                                <p>SKU @item.VariantCode</p>
                            </div>
                            <span class="order-quantity-pill">@item.Quantity</span>
                            <span class="text-right order-unit-price">@Money(item.UnitPrice)</span>
                            <span class="text-right order-unit-cost">@Money(item.UnitCost)</span>
                            <strong class="text-right order-line-total">@Money(item.LineTotal)</strong>
                            <strong class="text-right order-line-profit">@Money(item.GrossProfit)</strong>
                        </article>
                    }
                </div>
            </section>

            <section class="order-panel order-section-shipping-info order-anim" style="animation-delay:0.12s">
                <header class="order-panel-header">
                    <span class="order-panel-icon">
                        <i data-lucide="map-pin" class="w-5 h-5"></i>
                    </span>
                    <div>
                        <h2>Thông tin giao hàng</h2>
                        <p>@Model.ShippingContactName · @Model.ShippingPhone</p>
                    </div>
                </header>

                <dl class="order-info-list">
                    <div>
                        <dt>Người nhận</dt>
                        <dd>@Model.ShippingContactName</dd>
                    </div>
                    <div>
                        <dt>Số điện thoại</dt>
                        <dd>@Model.ShippingPhone</dd>
                    </div>
                    <div>
                        <dt>Địa chỉ</dt>
                        <dd>@Model.ShippingAddress</dd>
                    </div>
                </dl>
            </section>

            <section class="order-panel order-section-shipping order-anim" style="animation-delay:0.16s">
                <header class="order-panel-header">
                    <span class="order-panel-icon">
                        <i data-lucide="truck" class="w-5 h-5"></i>
                    </span>
                    <div>
                        <h2>Tạo vận chuyển</h2>
                        <p>Chọn đơn vị vận chuyển, lấy báo giá trước rồi tạo vận đơn khi đã đồng ý phí</p>
                    </div>
                </header>

                <div class="order-shipping-body @(splitShippingHistory ? "has-history-split" : string.Empty)">
                    @if (canStartShipping)
                    {
                        <div class="order-carrier-picker" data-shipping-provider-shell>
                            <label class="order-field">
                                <span>Đơn vị vận chuyển</span>
                                <select data-shipping-provider-select>
                                    <option value="">Chọn đơn vị vận chuyển</option>
                                    <option value="GiaoHangNhanh">Giao Hàng Nhanh</option>
                                </select>
                            </label>
                            <p data-shipping-provider-empty>Chọn Giao Hàng Nhanh để nhập thông tin kiện hàng, lấy báo giá và tạo vận đơn.</p>
                        </div>
                    }

                    @if (canStartShipping)
                    {
                        <div class="order-carrier-panel is-hidden" data-shipping-provider-panel="GiaoHangNhanh">
                            <div class="order-carrier-panel-head">
                                <span class="order-panel-icon">
                                    <i data-lucide="truck" class="w-5 h-5"></i>
                                </span>
                                <div>
                                    <h3>Giao Hàng Nhanh</h3>
                                    <p>Nhập thông tin GHN cần để báo giá. Sau khi có phí, bạn có thể tạo vận đơn ở bước xác nhận.</p>
                                </div>
                            </div>

                            @if (!shipmentPanel.IsProviderConfigured)
                            {
                                <div class="order-inline-alert">
                                    <i data-lucide="key-round" class="w-4 h-4"></i>
                                    <span>Chưa cấu hình GHN API. Bật Enabled và thêm Token, ShopId trước khi lấy phí vận chuyển.</span>
                                </div>
                            }
                            @if (!shipmentPanel.HasFulfillmentLocations)
                            {
                                <div class="order-inline-alert">
                                    <i data-lucide="map-pin-off" class="w-4 h-4"></i>
                                    <span>Chưa có điểm lấy hàng đang hoạt động trong bảng fulfillment_locations.</span>
                                </div>
                            }
                        </div>
                    }

                    @if (currentShipment is not null)
                    {
                        <div class="order-shipment-summary">
                            <div class="order-shipment-head">
                                <div>
                                    <span class="order-badge @currentShipment.StatusClass">@currentShipment.StatusLabel</span>
                                    @if (!string.IsNullOrWhiteSpace(currentShipment.ProviderDeliveryId))
                                    {
                                        <strong>@currentShipment.ProviderDeliveryId</strong>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(currentShipment.TrackingUrl))
                                {
                                    <a href="@currentShipment.TrackingUrl" target="_blank" rel="noopener" class="order-action-btn">
                                        <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
                                        <span>Theo dõi</span>
                                    </a>
                                }
                            </div>

                            <dl class="order-info-list compact no-padding">
                                <div>
                                    <dt>Lấy hàng</dt>
                                    <dd>@currentShipment.PickupAddress</dd>
                                </div>
                                <div>
                                    <dt>Giao đến</dt>
                                    <dd>@currentShipment.DropoffAddress</dd>
                                </div>
                                <div>
                                    <dt>Phí GHN</dt>
                                    <dd>@(currentShipment.ActualFee.HasValue ? Money(currentShipment.ActualFee.Value) : currentShipment.QuotedFee.HasValue ? Money(currentShipment.QuotedFee.Value) : "Chưa có")</dd>
                                </div>
                            </dl>

                            @if (currentShipment.Packages.Any())
                            {
                                <div class="order-package-list">
                                    @foreach (var package in currentShipment.Packages)
                                    {
                                        <div class="order-package-item">
                                            <strong>@package.Description</strong>
                                            <span>@package.Quantity kiện</span>
                                            @if (package.WeightGrams.HasValue)
                                            {
                                                <span>@package.WeightGrams.Value g</span>
                                            }
                                        </div>
                                    }
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(currentShipment.FailureReason))
                            {
                                <div class="order-inline-alert is-error">
                                    <i data-lucide="alert-triangle" class="w-4 h-4"></i>
                                    <span>@currentShipment.FailureReason</span>
                                </div>
                            }

                            @if (currentShipment.RecentEvents.Any())
                            {
                                <div class="order-event-list">
                                    @foreach (var item in currentShipment.RecentEvents)
                                    {
                                        <div>
                                            <strong>@item.StatusLabel</strong>
                                            <span>@DateText(item.OccurredAt)</span>
                                            @if (!string.IsNullOrWhiteSpace(item.Message))
                                            {
                                                <p>@item.Message</p>
                                            }
                                        </div>
                                    }
                                </div>
                            }

                            <div class="order-shipment-actions">
                                @if (currentShipment.CanBook)
                                {
                                    <form asp-controller="Shipments"
                                          asp-action="BookShipment"
                                          asp-route-orderId="@Model.Id"
                                          asp-route-shipmentId="@currentShipment.Id"
                                          method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="order-submit-btn">
                                            <i data-lucide="send" class="w-4 h-4"></i>
                                            <span>Đồng ý tạo vận đơn GHN</span>
                                        </button>
                                    </form>
                                }
                                @if (currentShipment.CanCancel)
                                {
                                    <form asp-controller="Shipments"
                                          asp-action="CancelShipment"
                                          asp-route-orderId="@Model.Id"
                                          asp-route-shipmentId="@currentShipment.Id"
                                          method="post"
                                          data-confirm="Hủy vận đơn GHN này?">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="order-secondary-danger">
                                            <i data-lucide="ban" class="w-4 h-4"></i>
                                            <span>Hủy vận đơn</span>
                                        </button>
                                    </form>
                                }
                                @if (currentShipment.CanSync)
                                {
                                    <form asp-controller="Shipments"
                                          asp-action="SyncShipmentStatus"
                                          asp-route-orderId="@Model.Id"
                                          asp-route-shipmentId="@currentShipment.Id"
                                          method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="order-action-btn">
                                            <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i>
                                            <span>Đồng bộ GHN</span>
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    }

                    @if (showShipmentHistory)
                    {
                        <div class="order-shipment-history">
                            <div class="order-shipment-history-title">
                                <span class="order-panel-icon">
                                    <i data-lucide="history" class="w-5 h-5"></i>
                                </span>
                                <div>
                                    <h3>Lịch sử vận chuyển</h3>
                                    <p>Lưu lại các lần báo giá, tạo vận đơn và hủy vận đơn của đơn hàng này.</p>
                                </div>
                            </div>

                            @foreach (var row in shipmentPanel.ShipmentHistory.Select((history, index) => new { history, index }))
                            {
                                var history = row.history;
                                var isExtraHistory = row.index >= 3;
                                var historyCode = string.IsNullOrWhiteSpace(history.ProviderDeliveryId)
                                    ? $"Vận chuyển #{history.Id}"
                                    : history.ProviderDeliveryId;

                                <article class="order-shipment-history-item"
                                         hidden="@isExtraHistory"
                                         data-shipment-history-extra="@isExtraHistory.ToString().ToLowerInvariant()">
                                    <div class="order-shipment-history-head">
                                        <div>
                                            <span class="order-badge @history.StatusClass">@history.StatusLabel</span>
                                            <strong>@historyCode</strong>
                                            @if (currentShipment?.Id == history.Id)
                                            {
                                                <span class="order-mini-tag">Hiện tại</span>
                                            }
                                        </div>
                                        @if (history.TrackingUrl is not null && !string.IsNullOrWhiteSpace(history.ProviderDeliveryId))
                                        {
                                            <a href="@history.TrackingUrl" target="_blank" rel="noopener" class="order-action-btn">
                                                <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
                                                <span>Theo dõi</span>
                                            </a>
                                        }
                                    </div>

                                    <dl class="order-shipment-history-meta">
                                        <div>
                                            <dt>Báo giá</dt>
                                            <dd>@DateText(history.CreatedAt)</dd>
                                        </div>
                                        @if (history.QuotedFee.HasValue)
                                        {
                                            <div>
                                                <dt>Phí</dt>
                                                <dd>@Money(history.ActualFee ?? history.QuotedFee.Value)</dd>
                                            </div>
                                        }
                                        @if (history.BookedAt.HasValue)
                                        {
                                            <div>
                                                <dt>Tạo vận đơn</dt>
                                                <dd>@DateTextNullable(history.BookedAt)</dd>
                                            </div>
                                        }
                                        @if (history.CancelledAt.HasValue)
                                        {
                                            <div>
                                                <dt>Hủy vận đơn</dt>
                                                <dd>@DateTextNullable(history.CancelledAt)</dd>
                                            </div>
                                        }
                                    </dl>

                                    @if (history.RecentEvents.Any())
                                    {
                                        <details class="order-shipment-process">
                                            <summary>
                                                <i data-lucide="list-tree" class="w-3.5 h-3.5"></i>
                                                <span>Chi tiết quá trình</span>
                                                <i data-lucide="chevron-down" class="w-3.5 h-3.5"></i>
                                            </summary>

                                            <div class="order-event-list order-event-list-compact">
                                                @foreach (var item in history.RecentEvents)
                                                {
                                                    <div>
                                                        <strong>@item.StatusLabel</strong>
                                                        <span>@DateText(item.OccurredAt)</span>
                                                        @if (!string.IsNullOrWhiteSpace(item.Message))
                                                        {
                                                            <p>@item.Message</p>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </details>
                                    }
                                </article>
                            }

                            @if (shipmentPanel.ShipmentHistory.Count > 3)
                            {
                                <button type="button"
                                        class="order-history-more"
                                        data-shipment-history-more>
                                    <i data-lucide="chevrons-down" class="w-3.5 h-3.5"></i>
                                    <span>Hiển thị thêm @(shipmentPanel.ShipmentHistory.Count - 3) vận đơn</span>
                                </button>
                            }
                        </div>
                    }

                    @if (canCreateQuote)
                    {
                        <form asp-controller="Shipments"
                              asp-action="CreateQuote"
                              asp-route-orderId="@Model.Id"
                              method="post"
                              class="order-shipping-form order-shipping-floating-form order-carrier-panel is-hidden"
                              data-shipping-provider-panel="GiaoHangNhanh"
                              data-shipping-modal-form
                              data-shipment-quote-form>
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="OrderId" value="@Model.Id" />

                            <div class="order-modal-form-head span-2">
                                <div>
                                    <h3>Giao Hàng Nhanh</h3>
                                    <p>Nhập thông tin giao hàng, lấy phí GHN rồi tạo vận đơn sau khi đồng ý phí.</p>
                                </div>
                                <button type="button" class="order-modal-close" data-close-shipping-modal aria-label="Đóng form giao hàng">
                                    <i data-lucide="x" class="w-4 h-4"></i>
                                </button>
                            </div>

                            <label class="order-field">
                                <span>Điểm lấy hàng</span>
                                <select name="FulfillmentLocationId">
                                    @foreach (var location in shipmentPanel.FulfillmentLocations)
                                    {
                                        <option value="@location.Id" selected="@(location.Id == shipmentPanel.QuoteForm.FulfillmentLocationId ? "selected" : null)">
                                            @location.Name - @location.Address
                                        </option>
                                    }
                                </select>
                            </label>

                            <input type="hidden" name="ProviderDropoffProvinceCode" value="@shipmentPanel.QuoteForm.ProviderDropoffProvinceCode" data-order-provider-province-code />
                            <input type="hidden" name="ProviderDropoffProvinceName" value="@shipmentPanel.QuoteForm.ProviderDropoffProvinceName" data-order-provider-province-name />
                            <input type="hidden" name="ProviderDropoffDistrictCode" value="@shipmentPanel.QuoteForm.ProviderDropoffDistrictCode" data-order-provider-district-code />
                            <input type="hidden" name="ProviderDropoffDistrictName" value="@shipmentPanel.QuoteForm.ProviderDropoffDistrictName" data-order-provider-district-name />
                            <input type="hidden" name="ProviderDropoffWardCode" value="@shipmentPanel.QuoteForm.ProviderDropoffWardCode" data-order-provider-ward-code />
                            <input type="hidden" name="ProviderDropoffWardName" value="@shipmentPanel.QuoteForm.ProviderDropoffWardName" data-order-provider-ward-name />

                            <div class="order-provider-address span-2"
                                 data-order-provider-address
                                 data-province-code="@shipmentPanel.QuoteForm.ProviderDropoffProvinceCode"
                                 data-province-name="@shipmentPanel.QuoteForm.ProviderDropoffProvinceName"
                                 data-district-code="@shipmentPanel.QuoteForm.ProviderDropoffDistrictCode"
                                 data-district-name="@shipmentPanel.QuoteForm.ProviderDropoffDistrictName"
                                 data-ward-code="@shipmentPanel.QuoteForm.ProviderDropoffWardCode"
                                 data-ward-name="@shipmentPanel.QuoteForm.ProviderDropoffWardName">
                                <label class="order-field">
                                    <span>Tỉnh/thành giao đến</span>
                                    <select data-order-provider-province-select>
                                        <option value="">Đang tải tỉnh/thành...</option>
                                    </select>
                                    @Html.ValidationMessage("ProviderDropoffProvinceCode", null, new { @class = "order-field-error" })
                                </label>

                                <label class="order-field">
                                    <span>Quận/huyện giao đến</span>
                                    <select data-order-provider-district-select disabled>
                                        <option value="">Chọn tỉnh/thành trước</option>
                                    </select>
                                    @Html.ValidationMessage("ProviderDropoffDistrictCode", null, new { @class = "order-field-error" })
                                </label>

                                <label class="order-field">
                                    <span>Phường/xã giao đến</span>
                                    <select data-order-provider-ward-select disabled>
                                        <option value="">Chọn quận/huyện trước</option>
                                    </select>
                                    @Html.ValidationMessage("ProviderDropoffWardCode", null, new { @class = "order-field-error" })
                                </label>
                            </div>

                            <label class="order-field span-2">
                                <span>Mô tả kiện hàng</span>
                                <input type="text" name="PackageDescription" value="@shipmentPanel.QuoteForm.PackageDescription" maxlength="500" required />
                                @Html.ValidationMessage("PackageDescription", null, new { @class = "order-field-error" })
                            </label>

                            <label class="order-field">
                                <span>Số kiện</span>
                                <input type="number" name="Quantity" min="1" max="@ShipmentQuoteCreateViewModel.MaxQuantity" step="1" value="@shipmentPanel.QuoteForm.Quantity" required />
                                @Html.ValidationMessage("Quantity", null, new { @class = "order-field-error" })
                            </label>

                            <label class="order-field">
                                <span>Cân nặng gram</span>
                                <input type="number" name="WeightGrams" min="1" max="@ShipmentQuoteCreateViewModel.MaxWeightGrams" step="1" value="@shipmentPanel.QuoteForm.WeightGrams" required />
                                @Html.ValidationMessage("WeightGrams", null, new { @class = "order-field-error" })
                            </label>

                            <label class="order-field">
                                <span>Dài cm</span>
                                <input type="number" step="1" min="@ShipmentQuoteCreateViewModel.MinDimensionCm" max="@ShipmentQuoteCreateViewModel.MaxDimensionCm" name="LengthCm" value="@shipmentPanel.QuoteForm.LengthCm" required />
                                @Html.ValidationMessage("LengthCm", null, new { @class = "order-field-error" })
                            </label>

                            <label class="order-field">
                                <span>Rộng cm</span>
                                <input type="number" step="1" min="@ShipmentQuoteCreateViewModel.MinDimensionCm" max="@ShipmentQuoteCreateViewModel.MaxDimensionCm" name="WidthCm" value="@shipmentPanel.QuoteForm.WidthCm" required />
                                @Html.ValidationMessage("WidthCm", null, new { @class = "order-field-error" })
                            </label>

                            <label class="order-field">
                                <span>Cao cm</span>
                                <input type="number" step="1" min="@ShipmentQuoteCreateViewModel.MinDimensionCm" max="@ShipmentQuoteCreateViewModel.MaxDimensionCm" name="HeightCm" value="@shipmentPanel.QuoteForm.HeightCm" required />
                                @Html.ValidationMessage("HeightCm", null, new { @class = "order-field-error" })
                            </label>

                            <label class="order-field">
                                <span>Giá trị khai báo</span>
                                <input type="number" step="1000" min="0" name="DeclaredValue" value="@shipmentPanel.QuoteForm.DeclaredValue" />
                                @Html.ValidationMessage("DeclaredValue", null, new { @class = "order-field-error" })
                            </label>

                            <label class="order-check-field">
                                <input type="checkbox" name="IsFragile" value="true" checked="@shipmentPanel.QuoteForm.IsFragile" />
                                <input type="hidden" name="IsFragile" value="false" />
                                <span>Hàng dễ vỡ</span>
                            </label>

                            <label class="order-field span-2">
                                <span>Ghi chú</span>
                                <textarea name="Notes" maxlength="1000">@shipmentPanel.QuoteForm.Notes</textarea>
                            </label>

                            <button type="submit" class="order-submit-btn span-2">
                                <i data-lucide="calculator" class="w-4 h-4"></i>
                                <span>Lấy phí GHN</span>
                            </button>
                        </form>
                    }
                </div>
            </section>
        </div>

        <aside class="order-detail-side">
            <section class="order-panel order-section-customer order-anim" style="animation-delay:0.1s">
                <header class="order-panel-header">
                    <span class="order-panel-icon">
                        <i data-lucide="user-round" class="w-5 h-5"></i>
                    </span>
                    <div>
                        <h2>Khách hàng</h2>
                        <p>@Model.CustomerName</p>
                    </div>
                </header>

                <dl class="order-info-list compact">
                    <div>
                        <dt>Email</dt>
                        <dd>@(string.IsNullOrWhiteSpace(Model.CustomerEmail) ? "Chưa có email" : Model.CustomerEmail)</dd>
                    </div>
                    <div>
                        <dt>Số điện thoại</dt>
                        <dd>@(string.IsNullOrWhiteSpace(Model.CustomerPhone) ? Model.ShippingPhone : Model.CustomerPhone)</dd>
                    </div>
                </dl>
            </section>

            <section class="order-panel order-section-payment order-anim" style="animation-delay:0.14s">
                <header class="order-panel-header">
                    <span class="order-panel-icon">
                        <i data-lucide="receipt-text" class="w-5 h-5"></i>
                    </span>
                    <div>
                        <h2>Thanh toán</h2>
                        <p>@Model.PaymentMethodName</p>
                    </div>
                </header>

                <dl class="order-money-list">
                    <div>
                        <dt>Tạm tính</dt>
                        <dd>@Money(Model.SubtotalAmount)</dd>
                    </div>
                    <div>
                        <dt>Phí giao hàng</dt>
                        <dd>@Money(Model.ShippingFee)</dd>
                    </div>
                    <div>
                        <dt>Giảm giá</dt>
                        <dd>-@Money(Model.VoucherDiscount)</dd>
                    </div>
                    <div>
                        <dt>Giá vốn hàng</dt>
                        <dd>@Money(Model.TotalCost)</dd>
                    </div>
                    <div>
                        <dt>Lãi gộp hàng</dt>
                        <dd>@Money(Model.GrossProfit)</dd>
                    </div>
                    <div class="is-total">
                        <dt>Tổng cộng</dt>
                        <dd>@Money(Model.TotalAmount)</dd>
                    </div>
                </dl>

                @if (!string.IsNullOrWhiteSpace(Model.VoucherCode))
                {
                    <p class="order-voucher-line">
                        <i data-lucide="ticket" class="w-3.5 h-3.5"></i>
                        <span>@Model.VoucherCode</span>
                    </p>
                }
            </section>

            <section class="order-panel order-section-status order-anim" style="animation-delay:0.18s">
                <header class="order-panel-header">
                    <span class="order-panel-icon">
                        <i data-lucide="workflow" class="w-5 h-5"></i>
                    </span>
                    <div>
                        <h2>Trạng thái</h2>
                        <p>
                            <span class="order-badge @OrderDisplay.GetOrderStatusClass(Model.OrderStatus)">
                                @OrderDisplay.GetOrderStatusLabel(Model.OrderStatus)
                            </span>
                        </p>
                    </div>
                </header>

                <form asp-action="UpdateStatus"
                      asp-route-id="@Model.Id"
                      method="post"
                      class="order-status-form"
                      data-order-status-form
                      data-current-order-status="@Model.OrderStatus"
                      data-current-payment-status="@Model.PaymentStatus"
                      data-is-cod-payment="@Model.IsCashOnDelivery.ToString().ToLowerInvariant()"
                      data-current-shipment-status="@currentShipment?.Status">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" value="@Model.Id" />

                    <div data-order-form-alert class="order-form-alert @(ViewData.ModelState.IsValid ? "hidden" : "")">
                        <i data-lucide="alert-triangle" class="w-4 h-4"></i>
                        <div>
                            <p>Vui lòng kiểm tra lại trạng thái.</p>
                            <div asp-validation-summary="ModelOnly"></div>
                        </div>
                    </div>

                    <label class="order-field">
                        <span>Trạng thái đơn</span>
                        <select name="OrderStatus" data-order-status-select>
                            @foreach (var option in Model.OrderStatusOptions)
                            {
                                <option value="@option.Value" selected="@(option.Value == selectedOrderStatus ? "selected" : null)">
                                    @option.Text
                                </option>
                            }
                        </select>
                        @Html.ValidationMessage("OrderStatus", null, new { @class = "order-field-error" })
                    </label>

                    <label class="order-field">
                        <span>Trạng thái thanh toán</span>
                        <select name="PaymentStatus" data-payment-status-select>
                            @foreach (var option in Model.PaymentStatusOptions)
                            {
                                <option value="@option.Value" selected="@(option.Value == selectedPaymentStatus ? "selected" : null)">
                                    @option.Text
                                </option>
                            }
                        </select>
                        @Html.ValidationMessage("PaymentStatus", null, new { @class = "order-field-error" })
                    </label>

                    <button type="submit" class="order-submit-btn">
                        <i data-lucide="save" class="w-4 h-4"></i>
                        <span>Cập nhật trạng thái</span>
                    </button>
                </form>
            </section>
        </aside>
    </section>
</main>

@section Scripts {
    <script src="~/js/orders.js" asp-append-version="true"></script>
}
