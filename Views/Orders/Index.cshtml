@model e_commerce_web_admin.ViewModels.Orders.OrderIndexViewModel
@using System.Globalization
@using e_commerce_web_admin.ViewModels.Orders
@{
    ViewData["Title"] = "Quản lý đơn hàng";
    Layout = "_Layout";

    var vi = CultureInfo.GetCultureInfo("vi-VN");
    string Money(decimal value) => string.Concat(value.ToString("N0", vi), " đ");
    string DateText(DateTime value) => value.ToLocalTime().ToString("dd/MM/yyyy HH:mm", vi);
    var activeFilterCount = new[]
    {
        !string.IsNullOrWhiteSpace(Model.Search),
        !string.IsNullOrWhiteSpace(Model.DateRange),
        !string.IsNullOrWhiteSpace(Model.OrderStatus),
        !string.IsNullOrWhiteSpace(Model.PaymentStatus),
        Model.PaymentMethodId.HasValue,
    }.Count(isActive => isActive);
}

@section Styles {
    <link rel="stylesheet" href="~/css/orders.css" asp-append-version="true" />
}

<main class="order-page">
    <section class="order-hero order-anim" style="animation-delay:0.04s">
        <div>
            <p class="order-page-mark">Vận hành đơn hàng</p>
            <div class="order-title-row">
                <div>
                    <h1>Quản lý đơn hàng</h1>
                    <p>Theo dõi đơn, khách mua, thanh toán và trạng thái xử lý trong một màn hình.</p>
                </div>
            </div>
        </div>
    </section>

    @if (TempData["Success"] != null)
    {
        <div id="toastSuccess" class="order-flash order-flash-success order-anim" style="animation-delay:0.06s">
            <span class="order-flash-icon">
                <i data-lucide="check" class="w-4 h-4"></i>
            </span>
            <span>@TempData["Success"]</span>
            <button type="button" data-dismiss-target="toastSuccess" aria-label="Đóng thông báo">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div id="toastError" class="order-flash order-flash-error order-anim" style="animation-delay:0.06s">
            <span class="order-flash-icon">
                <i data-lucide="alert-circle" class="w-4 h-4"></i>
            </span>
            <span>@TempData["Error"]</span>
            <button type="button" data-dismiss-target="toastError" aria-label="Đóng thông báo">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>
    }

    <section class="order-metrics order-anim" style="animation-delay:0.08s" aria-label="Thống kê đơn hàng">
        <article class="order-metric">
            <span class="order-metric-icon">
                <i data-lucide="shopping-bag" class="w-5 h-5"></i>
            </span>
            <div>
                <p>@Model.TotalCount</p>
                <span>Đơn trong bộ lọc</span>
            </div>
        </article>
        <article class="order-metric">
            <span class="order-metric-icon is-pending">
                <i data-lucide="clock-3" class="w-5 h-5"></i>
            </span>
            <div>
                <p>@Model.PendingCount</p>
                <span>Chờ xác nhận</span>
            </div>
        </article>
        <article class="order-metric">
            <span class="order-metric-icon is-shipping">
                <i data-lucide="truck" class="w-5 h-5"></i>
            </span>
            <div>
                <p>@Model.ShippingCount</p>
                <span>Đang giao</span>
            </div>
        </article>
        <article class="order-metric">
            <span class="order-metric-icon is-revenue">
                <i data-lucide="wallet-cards" class="w-5 h-5"></i>
            </span>
            <div>
                <p>@Money(Model.CompletedRevenue)</p>
                <span>Doanh thu hoàn tất</span>
            </div>
        </article>
    </section>

    <section class="order-console order-anim" style="animation-delay:0.12s">
        <form method="get" asp-action="Index" class="order-filter-grid">
            <label class="order-search-field">
                <i data-lucide="search" class="w-4 h-4"></i>
                <input type="text"
                       name="search"
                       value="@Model.Search"
                       placeholder="Tìm mã đơn, khách hàng hoặc số điện thoại..." />
            </label>

            <label class="order-select-field">
                <span>Thời gian</span>
                <select name="dateRange">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.DateRange) ? "selected" : null)">Tất cả</option>
                    @foreach (var option in Model.DateRangeOptions)
                    {
                        <option value="@option.Value" selected="@(option.Selected ? "selected" : null)">@option.Text</option>
                    }
                </select>
            </label>

            <label class="order-select-field">
                <span>Đơn hàng</span>
                <select name="orderStatus">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.OrderStatus) ? "selected" : null)">Tất cả</option>
                    @foreach (var option in Model.OrderStatusOptions)
                    {
                        <option value="@option.Value" selected="@(option.Selected ? "selected" : null)">@option.Text</option>
                    }
                </select>
            </label>

            <label class="order-select-field">
                <span>Thanh toán</span>
                <select name="paymentStatus">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.PaymentStatus) ? "selected" : null)">Tất cả</option>
                    @foreach (var option in Model.PaymentStatusOptions)
                    {
                        <option value="@option.Value" selected="@(option.Selected ? "selected" : null)">@option.Text</option>
                    }
                </select>
            </label>

            <label class="order-select-field">
                <span>Phương thức</span>
                <select name="paymentMethodId">
                    <option value="" selected="@(Model.PaymentMethodId.HasValue ? null : "selected")">Tất cả</option>
                    @foreach (var option in Model.PaymentMethodOptions)
                    {
                        <option value="@option.Value" selected="@(option.Selected ? "selected" : null)">@option.Text</option>
                    }
                </select>
            </label>

            <button type="submit" class="order-filter-submit">
                <i data-lucide="sliders-horizontal" class="w-4 h-4"></i>
                <span>Lọc</span>
                @if (activeFilterCount > 0)
                {
                    <span class="order-filter-count" aria-label="@activeFilterCount bộ lọc đang áp dụng">
                        @activeFilterCount
                    </span>
                }
            </button>

            @if (Model.HasFilters)
            {
                <a asp-action="Index" class="order-filter-clear">
                    <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
                    <span>Xóa lọc</span>
                </a>
            }
        </form>

        @if (!Model.Orders.Any())
        {
            <div class="order-empty">
                <span class="order-empty-icon">
                    <i data-lucide="package-search" class="w-9 h-9"></i>
                </span>
                <h2>Không tìm thấy đơn hàng</h2>
                @if (Model.HasFilters)
                {
                    <p>Điều chỉnh bộ lọc hoặc xóa bộ lọc để xem lại toàn bộ đơn hàng.</p>
                    <a asp-action="Index" class="order-empty-action">Xóa bộ lọc</a>
                }
                else
                {
                    <p>Chưa có đơn hàng nào trong hệ thống.</p>
                }
            </div>
        }
        else
        {
            <div class="order-table-scroll">
                <div class="order-index-grid order-table-head">
                    <span>Đơn hàng</span>
                    <span>Khách hàng</span>
                    <span class="text-center">Trạng thái</span>
                    <span class="text-center">Thanh toán</span>
                    <span class="text-right">Tổng tiền</span>
                    <span class="text-right">Thao tác</span>
                </div>

                <div class="order-table-body">
                    @{
                        var animIndex = 0;
                    }
                    @foreach (var order in Model.Orders)
                    {
                        <article class="order-row order-index-grid order-anim"
                                 style="animation-delay:@(0.14 + animIndex++ * 0.025)s">
                            <div class="order-code-stack">
                                <h2>@order.OrderCode</h2>
                                <p>
                                    <i data-lucide="calendar-clock" class="w-3.5 h-3.5"></i>
                                    <span>@DateText(order.CreatedAt)</span>
                                </p>
                                <p>
                                    <i data-lucide="boxes" class="w-3.5 h-3.5"></i>
                                    <span>@order.ItemCount sản phẩm</span>
                                </p>
                            </div>

                            <div class="order-customer-stack">
                                <h3>@order.CustomerName</h3>
                                <p>@(string.IsNullOrWhiteSpace(order.CustomerEmail) ? "Chưa có email" : order.CustomerEmail)</p>
                                <p>@order.ShippingPhone</p>
                            </div>

                            <div class="order-status-cell">
                                <span class="order-badge @OrderDisplay.GetOrderStatusClass(order.OrderStatus)">
                                    @OrderDisplay.GetOrderStatusLabel(order.OrderStatus)
                                </span>
                            </div>

                            <div class="order-status-cell">
                                <span class="order-badge @OrderDisplay.GetPaymentStatusClass(order.PaymentStatus)">
                                    @OrderDisplay.GetPaymentStatusLabel(order.PaymentStatus)
                                </span>
                                <small>@order.PaymentMethodName</small>
                            </div>

                            <div class="order-total-cell">
                                <strong>@Money(order.TotalAmount)</strong>
                            </div>

                            <div class="order-actions">
                                <a asp-action="Details"
                                   asp-route-id="@order.Id"
                                   class="order-action-btn">
                                    <i data-lucide="eye" class="w-3.5 h-3.5"></i>
                                    <span>Chi tiết</span>
                                </a>
                            </div>
                        </article>
                    }
                </div>
            </div>

            @if (Model.TotalPages > 1)
            {
                <footer class="order-pagination">
                    <p>
                        Trang <strong>@Model.Page</strong> / @Model.TotalPages
                        <span>@Model.TotalCount đơn hàng</span>
                    </p>
                    <nav aria-label="Phân trang đơn hàng">
                        @if (Model.HasPrev)
                        {
                            <a asp-action="Index"
                               asp-route-page="@(Model.Page - 1)"
                               asp-route-search="@Model.Search"
                               asp-route-dateRange="@Model.DateRange"
                               asp-route-orderStatus="@Model.OrderStatus"
                               asp-route-paymentStatus="@Model.PaymentStatus"
                               asp-route-paymentMethodId="@Model.PaymentMethodId"
                               class="order-page-btn"
                               aria-label="Trang trước">
                                <i data-lucide="chevron-left" class="w-4 h-4"></i>
                            </a>
                        }
                        @for (int p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.TotalPages, Model.Page + 2); p++)
                        {
                            <a asp-action="Index"
                               asp-route-page="@p"
                               asp-route-search="@Model.Search"
                               asp-route-dateRange="@Model.DateRange"
                               asp-route-orderStatus="@Model.OrderStatus"
                               asp-route-paymentStatus="@Model.PaymentStatus"
                               asp-route-paymentMethodId="@Model.PaymentMethodId"
                               class="order-page-btn @(p == Model.Page ? "is-active" : "")">
                                @p
                            </a>
                        }
                        @if (Model.HasNext)
                        {
                            <a asp-action="Index"
                               asp-route-page="@(Model.Page + 1)"
                               asp-route-search="@Model.Search"
                               asp-route-dateRange="@Model.DateRange"
                               asp-route-orderStatus="@Model.OrderStatus"
                               asp-route-paymentStatus="@Model.PaymentStatus"
                               asp-route-paymentMethodId="@Model.PaymentMethodId"
                               class="order-page-btn"
                               aria-label="Trang sau">
                                <i data-lucide="chevron-right" class="w-4 h-4"></i>
                            </a>
                        }
                    </nav>
                </footer>
            }
        }
    </section>
</main>

@section Scripts {
    <script src="~/js/orders.js" asp-append-version="true"></script>
}
