@model e_commerce_web_admin.ViewModels.FulfillmentLocations.FulfillmentLocationFormViewModel
@{
    var formAction = Model.IsEdit ? "Edit" : "Create";
    long? routeId = Model.IsEdit ? Model.Id : null;
    var breadcrumbLabel = Model.IsEdit && !string.IsNullOrWhiteSpace(Model.Name) ? Model.Name : "Thêm mới";
}

<section class="fulfillment-hero fulfillment-anim" style="animation-delay:0.04s">
    <nav class="fulfillment-breadcrumb" aria-label="Điều hướng">
        <a asp-action="Index">Điểm lấy hàng</a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <span>@breadcrumbLabel</span>
    </nav>
    <div class="fulfillment-title-row">
        <div>
            <h1>@(Model.IsEdit ? "Chỉnh sửa điểm lấy hàng" : "Thêm điểm lấy hàng")</h1>
            <p>@(Model.IsEdit ? "Cập nhật thông tin kho hoặc cửa hàng dùng khi báo giá và tạo vận đơn GHN." : "Tạo địa chỉ kho hoặc cửa hàng dùng làm điểm GHN tới lấy hàng.")</p>
        </div>
    </div>
</section>

<form asp-action="@formAction" asp-route-id="@routeId" method="post" class="fulfillment-anim" style="animation-delay:0.08s">
    @Html.AntiForgeryToken()
    <partial name="_Form" model="Model" />
</form>
